{"sections":[],"identifier":{"url":"doc:\/\/com.stripe.stripe-apple-pay\/documentation\/StripeApplePay\/StripeCore\/STPAPIClient\/pkPaymentError(forStripeError:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Converts Stripe errors into the appropriate Apple Pay error, for use in "},{"type":"codeVoice","code":"PKPaymentAuthorizationResult"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If the error can be fixed by the customer within the Apple Pay sheet, we return an NSError that can be displayed in the Apple Pay sheet.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise, the original error is returned, resulting in the Apple Pay sheet being dismissed. You should display the error message to the customer afterwards.","type":"text"},{"text":" ","type":"text"},{"text":"Currently, we convert billing address related errors into a PKPaymentError that helpfully points to the billing address field in the Apple Pay sheet.","type":"text"},{"text":" ","type":"text"},{"text":"Note that Apple Pay should prevent most card errors (e.g. invalid CVC, expired cards) when you add a card to the wallet.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.stripe.stripe-apple-pay\/documentation\/StripeApplePay","doc:\/\/com.stripe.stripe-apple-pay\/documentation\/StripeApplePay\/StripeCore","doc:\/\/com.stripe.stripe-apple-pay\/documentation\/StripeApplePay\/StripeCore\/STPAPIClient"]]},"metadata":{"externalID":"c:@CM@StripeApplePay@StripeCore@objc(cs)STPAPIClient(cm)pkPaymentErrorForStripeError:","title":"pkPaymentError(forStripeError:)","extendedModule":"StripeCore","symbolKind":"method","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"pkPaymentError"},{"kind":"text","text":"("},{"text":"forStripeError","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s5E