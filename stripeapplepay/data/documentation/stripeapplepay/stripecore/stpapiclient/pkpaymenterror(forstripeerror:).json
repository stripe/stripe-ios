"kind":"text","text":"?"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"stripeError","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An error from the Stripe SDK."}]}]}],"kind":"parameters"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/stripeapplepay\/stripecore\/stpapiclient\/pkpaymenterror(forstripeerror:)"]}],"abstract":[{"type":"text","text":"Converts Stripe errors into the appropriate Apple Pay error, for use in "},{"type":"codeVoice","code":"PKPaymentAuthorizationResult"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If the error can be fixed by the customer within the Apple Pay sheet, we return an NSError that can be displayed in the Apple Pay sheet."},{"type":"text","text":" "},{"type":"text","text":"Otherwise, the original error is returned, resulting in the Apple Pay sheet being dismissed. You should display the error message to the customer afterwards."},{"type":"text","text":" "},{"type":"text","text":"Currently, we convert billing address related errors into a PKPaymentError that helpfully points to the billing address field in the Apple Pay sheet."},{"type":"text","text":" "},{"type":"text","text":"Note that Apple Pay should prevent most card errors (e.g. invalid CVC, expired cards) when you add a card to the wallet."}],"sections":[],"references":{"doc://com.stripe.stripe-apple-pay/documentation/StripeApplePay":{"abstract":[{"text":"StripeApplePay is a lightweight Apple Pay SDK intended for building App Clips or other size-constrained apps.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/com.stripe.stripe-apple-pay\/documentation\/StripeApplePay","title":"StripeApplePay","type":"topic","url":"\/documentation\/stripeapplepay","role":"collection"},"doc://com.stripe.stripe-apple-pay/documentation/StripeApplePay/StripeCore/STPAPIClient":{"role":"symbol","navigatorTitle":[{"kind":"identifier"