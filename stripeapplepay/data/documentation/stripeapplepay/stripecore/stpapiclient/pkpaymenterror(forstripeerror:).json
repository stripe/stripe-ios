{"hierarchy":{"paths":[["doc:\/\/com.stripe.stripe-apple-pay\/documentation\/StripeApplePay","doc:\/\/com.stripe.stripe-apple-pay\/documentation\/StripeApplePay\/StripeCore","doc:\/\/com.stripe.stripe-apple-pay\/documentation\/StripeApplePay\/StripeCore\/STPAPIClient"]]},"variants":[{"paths":["\/documentation\/stripeapplepay\/stripecore\/stpapiclient\/pkpaymenterror(forstripeerror:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"roleHeading":"Type Method","modules":[{"relatedModules":["StripeCore"],"name":"StripeApplePay"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"pkPaymentError"},{"kind":"text","text":"("},{"kind":"externalParam","text":"forStripeError"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"},{"kind":"text","text":"?) -> "},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"title":"pkPaymentError(forStripeError:)","role":"symbol","extendedModule":"StripeCore","symbolKind":"method","externalID":"c:@CM@StripeApplePay@StripeCore@objc(cs)STPAPIClient(cm)pkPaymentErrorForStripeError:"},"identifier":{"url":"doc:\/\/com.stripe.stripe-apple-pay\/documentation\/StripeApplePay\/StripeCore\/STPAPIClient\/pkPaymentError(forStripeError:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Converts Stripe errors into the appropriate Apple Pay error, for use in "},{"type":"codeVoice","code":"PKPaymentAuthorizationResult"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If the error can be fixed by the customer within the Apple Pay sheet, we return an NSError that can be displayed in the Apple Pay sheet."},{"type":"text","text":" "},{"text":"Otherwise, the original error is returned, resulting in the Apple Pay sheet being dismissed. You should display the error message to the customer afterwards.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Currently, we convert billing address related errors into a PKPaymentError that helpfully points to the billing address field in the Apple Pay sheet."},{"type":"text","text":" "},{"type":"text","text":"Note that Apple Pay should prevent most card errors (e.g. invalid CVC, expired cards) when you add a card to the wallet."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":"(pkPaymentErrorForStripeError:) ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pkPaymentError","kind":"identifier"},{"text":"(","kind":"text"},{"text":"forStripeError","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"stripeError","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"},{"kind":"text","text":"?"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"An error from the Stripe SDK."}],"type":"paragraph"}],"name":"stripeError"}]}],"references":{"doc://com.stripe.stripe-apple-pay/documentation/StripeApplePay/StripeCore/STPAPIClient":{"navigatorTitle":[{"text":"STPAPIClient","kind":"identifier"}],"title":"STPAPIClient","kind":"symbol","role":"symbol","abstract":[{"text":"STPAPIClient extensions to create Stripe Tokens, Sources, or PaymentMethods from Apple Pay PKPayment objects.","type":"text"}],"identifier":"doc:\/\/com.stripe.stripe-apple-pay\/documentation\/StripeApplePay\/StripeCore\/STPAPIClient","url":"\/documentation\/stripeapplepay\/stripecore\/stpapiclient","type":"topic","fragments":