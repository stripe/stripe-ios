ported card brands is determined by combining "},{"type":"codeVoice","code":"StripeAPI.supportedPKPaymentNetworks()"},{"type":"text","text":" with "},{"type":"codeVoice","code":"StripeAPI.additionalEnabledApplePayNetworks"},{"type":"text","text":" and then applying the "},{"type":"codeVoice","code":"cardBrandAcceptance"},{"type":"text","text":" filter. This filtered list is then assigned to "},{"type":"codeVoice","code":"PKPaymentRequest.supportedNetworks"},{"type":"text","text":", ensuring that only the allowed card brands are available for Apple Pay transactions. Any "},{"type":"codeVoice","code":"PKPaymentNetwork"},{"type":"text","text":" that does not correspond to a "},{"type":"codeVoice","code":"BrandCategory"},{"type":"text","text":" will be blocked if you have specified an allow list, or will not be blocked if you have specified a disallow list."},{"type":"text","text":" "},{"type":"text","text":"Note: This is only a client-side solution."},{"type":"text","text":" "},{"type":"text","text":"Note: Card brand filtering is not currently supported by Link."}],"title":"cardBrandAcceptance","role":"symbol"},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet/EmbeddedPaymentElement/Configuration-swift.struct/appearance":{"identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/EmbeddedPaymentElement\/Configuration-swift.struct\/appearance","type":"topic","url":"\/documentation\/stripepaymentsheet\/embeddedpaymentelement\/configuration-swift.struct\/appearance","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"appearance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:18StripePaymentSheet0bC0C","text":"PaymentSheet"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:18StripePaymentSheet0bC0C10AppearanceV","text":"Appearance"}],"kind":"symbol","abstract":[{"type":"text","text":"Describes the appearance of Paymen