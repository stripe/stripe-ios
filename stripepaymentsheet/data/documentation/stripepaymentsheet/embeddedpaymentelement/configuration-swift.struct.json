,"url":"\/documentation\/stripepaymentsheet\/embeddedpaymentelement\/configuration-swift.struct\/style","type":"topic","role":"symbol","kind":"symbol"},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet/EmbeddedPaymentElement/Configuration-swift.struct/allowsDelayedPaymentMethods":{"title":"allowsDelayedPaymentMethods","url":"\/documentation\/stripepaymentsheet\/embeddedpaymentelement\/configuration-swift.struct\/allowsdelayedpaymentmethods","abstract":[{"type":"text","text":"If true, allows payment methods that do not move money at the end of the checkout. Defaults to false."}],"identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/EmbeddedPaymentElement\/Configuration-swift.struct\/allowsDelayedPaymentMethods","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"allowsDelayedPaymentMethods"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet/EmbeddedPaymentElement/Configuration-swift.struct/termsDisplay":{"identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/EmbeddedPaymentElement\/Configuration-swift.struct\/termsDisplay","title":"termsDisplay","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"termsDisplay"},{"kind":"text","text":": ["},{"preciseIdentifier":"c:@M@StripePayments@E@STPPaymentMethodType","kind":"typeIdentifier","text":"STPPaymentMethodType"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:18StripePaymentSheet0bC0C","kind":"typeIdentifier","text":"PaymentSheet"},{"kind":"text","text":"."},{"preciseIdentifier":"s:18StripePaymentSheet0bC0C12TermsDisplayO","kind":"typeIdentifier","text":"TermsDisplay"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"A map for specifying when legal agreements are displayed for each payment method type."},{"type":"text","text":" "},{"type":"text","text":"If the payment method is not specified in the list, the TermsDisplay value will default to "},{"type":"codeVoice","code":".automatic"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Valid payment method types include:"},{"type":"text","text":" "},{"type":"text","text":".card"}],"url":"\/documentation\/stripepaymentsheet\/embeddedpaymentelement\/configuration-swift.struct\/termsdisplay","type":"topic","role":"symbol","kind":"symbol"},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet/EmbeddedPaymentElement/Configuration-swift.struct/applePay":{"identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/EmbeddedPaymentElement\/Configuration-swift.struct\/applePay","title":"applePay","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"applePay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:18StripePaymentSheet08EmbeddedB7ElementC21ApplePayConfigurationa","text":"ApplePayConfiguration"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"Configuration related to Apple Pay"},{"type":"text","text":" "},{"type":"text","text":"If set, PaymentSheet displays Apple Pay as a payment option"}],"url":"\/documentation\/stripepaymentsheet\/embeddedpaymentelement\/configuration-swift.struct\/applepay","type":"topic","role":"symbol","kind":"symbol"},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet/EmbeddedPaymentElement/Configuration-swift.struct/cardBrandAcceptance":{"kind":"symbol","url":"\/documentation\/stripepaymentsheet\/embeddedpaymentelement\/configuration-swift.struct\/cardbrandacceptance","identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/EmbeddedPaymentElement\/Configuration-swift.struct\/cardBrandAcceptance","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cardBrandAcceptance","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CardBrandAcceptance","kind":"typeIdentifier","preciseIdentifier":"s:18StripePaymentSheet08EmbeddedB7ElementC19CardBrandAcceptancea"}],"title":"cardBrandAcceptance","abstract":[{"type":"text","text":"By default, the embedded payment element will accept all supported cards by Stripe."},{"type":"text","text":" "},{"type":"text","text":"You can specify card brands the embedded payment element should block disallow or allow payment for by providing an array of those card brands."},{"type":"text","text":" "},{"type":"text","text":"Note: For Apple Pay, the list of supported card brands is determined by combining "},{"type":"codeVoice","code":"StripeAPI.supportedPKPaymentNetworks()"},{"type":"text","text":" with "},{"type":"codeVoice","code":"StripeAPI.additionalEnabledApplePayNetworks"},{"type":"text","text":" and then applying the "},{"type":"codeVoice","code":"cardBrandAcceptance"},{"type":"text","text":" filter. This filtered list is then assigned to "},{"type":"codeVoice","code":"PKPaymentRequest.supportedNetworks"},{"type":"text","text":", ensuring that only the allowed card brands are available for Apple Pay transactions. Any "},{"type":"codeVoice","code":"PKPaymentNetwork"},{"type":"text","text":" that does not correspond to a "},{"type":"codeVoice","code":"BrandCategory"},{"type":"text","text":" will be blocked if you have specified an allow list, or will not be blocked if you have specified a disallow list."},{"type":"text","text":" "},{"type":"text","text":"Note: This is only a client-side solution."},{"type":"text","text":" "},{"type":"text","text":"Note: Card brand filtering is not currently supported by Link."}],"type":"topic","role":"symbol"},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet/EmbeddedPaymentElement":{"role":"symbol","url":"\/documentation\/stripepaymentsheet\/embeddedpaymentelement","navigatorTit