onfiguration for PaymentSheet","type":"text"}],"identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/PaymentSheet\/Configuration-swift.struct","type":"topic"},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet/PaymentSheet/Configuration-swift.struct/cardBrandAcceptance":{"identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/PaymentSheet\/Configuration-swift.struct\/cardBrandAcceptance","url":"\/documentation\/stripepaymentsheet\/paymentsheet\/configuration-swift.struct\/cardbrandacceptance","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cardBrandAcceptance","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:18StripePaymentSheet0bC0C","text":"PaymentSheet","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:18StripePaymentSheet0bC0C19CardBrandAcceptanceO","text":"CardBrandAcceptance","kind":"typeIdentifier"}],"type":"topic","abstract":[{"text":"By default, PaymentSheet will accept all supported cards by Stripe.","type":"text"},{"text":" ","type":"text"},{"text":"You can specify card brands PaymentSheet should block disallow or allow payment for by providing an array of those card brands.","type":"text"},{"text":" ","type":"text"},{"text":"Note: For Apple Pay, the list of supported card brands is determined by combining ","type":"text"},{"code":"StripeAPI.supportedPKPaymentNetworks()","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"StripeAPI.additionalEnabledApplePayNetworks","type":"codeVoice"},{"text":" and then applying the ","type":"text"},{"code":"cardBrandAcceptance","type":"codeVoice"},{"text":" filter. This filtered list is then assigned to ","type":"text"},{"code":"PKPaymentRequest.supportedNetworks","type":"codeVoice"},{"text":", ensuring that only the allowed card brands are available for Apple Pay transactions. Any ","type":"text"},{"code":"PKPaymentNetwork","type":"codeVoice"},{"text":" that does not correspond to a ","type":"text"},{"code":"BrandCategory","type":"codeVoice"},{"text":" will be blocked if you have specified an allow list, or will not be blocked if you have specified a disallow list.","type":"text"},{"text":" ","type":"text"},{"text":"Note: This is only a client-side solution.","type":"text"},{"text":" ","type":"text"},{"text":"Note: Card brand filtering is not currently supported by Link.","type":"text"}],"kind":"symbol","title":"cardBrandAcceptance","role":"symbol"},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet/PaymentSheet/Configuration-swift.struct/returnURL":{"identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/PaymentSheet\/Configuration-swift.struct\/returnURL","url":"\/documentation\/stripepaymentsheet\/paymentsheet\/configuration-swift.struct\/returnurl","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"returnURL","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","abstract":[{"text":"A URL that redirects back to your app that PaymentSheet can use to auto-dismiss","type":"text"},{"text":" ","type":"text"},{"text":"web views used for additional authentication, e.g. 3DS2","type":"text"}],"kind":"symbol","title":"returnURL","role":"symbol"}}}