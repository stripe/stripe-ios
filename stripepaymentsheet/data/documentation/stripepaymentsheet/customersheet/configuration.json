sheet\/customersheet\/configuration\/applepayenabled","identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/CustomerSheet\/Configuration\/applePayEnabled","title":"applePayEnabled","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"applePayEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"type":"text","text":"Whether to show Apple Pay as an option"}],"type":"topic"},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet":{"identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet","title":"StripePaymentSheet","abstract":[{"type":"text","text":"PaymentSheet is a prebuilt UI that combines all the steps required to pay - collecting payment details, billing details, and confirming the payment - into a single sheet that displays on top of your app."}],"url":"\/documentation\/stripepaymentsheet","type":"topic","role":"collection","kind":"symbol"},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet/CustomerSheet/Configuration/apiClient":{"kind":"symbol","url":"\/documentation\/stripepaymentsheet\/customersheet\/configuration\/apiclient","identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/CustomerSheet\/Configuration\/apiClient","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"apiClient"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@M@StripeCore@objc(cs)STPAPIClient","kind":"typeIdentifier","text":"STPAPIClient"}],"title":"apiClient","abstract":[{"type":"text","text":"The APIClient instance used to make requests to Stripe"}],"type":"topic","role":"symbol"},"doc://com.stripe.stripe-payment-sheet/documentation/StripePaymentSheet/CustomerSheet/Configuration/cardBrandAcceptance":{"role":"symbol","url":"\/documentation\/stripepaymentsheet\/customersheet\/configuration\/cardbrandacceptance","identifier":"doc:\/\/com.stripe.stripe-payment-sheet\/documentation\/StripePaymentSheet\/CustomerSheet\/Configuration\/cardBrandAcceptance","title":"cardBrandAcceptance","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"cardBrandAcceptance"},{"kind":"text","text":": "},{"preciseIdentifier":"s:18StripePaymentSheet0bC0C","kind":"typeIdentifier","text":"PaymentSheet"},{"kind":"text","text":"."},{"preciseIdentifier":"s:18StripePaymentSheet0bC0C19CardBrandAcceptanceO","kind":"typeIdentifier","text":"CardBrandAcceptance"}],"abstract":[{"type":"text","text":"By default, CustomerSheet will accept all supported cards by Stripe."},{"type":"text","text":" "},{"type":"text","text":"You can specify card brands CustomerSheet should block disallow or allow payment for by providing an array of those card brands."},{"type":"text","text":" "},{"type":"text","text":"Note: For Apple Pay, the list of supported card brands is determined by combining "},{"code":"StripeAPI.supportedPKPaymentNetworks()","type":"codeVoice"},{"type":"text","text":" with "},{"code":"StripeAPI.additionalEnabledApplePayNetworks","type":"codeVoice"},{"type":"text","text":" and then applying the "},{"code":"cardBrandAcceptance","type":"codeVoice"},{"type":"text","text":" filter. This filtered list is then assigned to "},{"code":"PKPaymentRequest.supportedNetworks","type":"codeVoice"},{"type":"text","text":", ensuring that only the allowed card brands are available for Apple Pay transactions. Any "},{"code":"PKPaymentNetwork","type":"codeVoice"},{"type":"text","text":" that does not correspond to a "},{"code":"BrandCategory","type":"codeVoice"},{"type":"text","text":" will be blocked if you have specified an allow list, or will not be blocked if you have specified a disallow list."},{"type":"text","text":" "},{"type":"text","text":"Note: This is only a client-side solution."},{"type":"text","text":" "},{"t