"This is an international purchase and excludes a 3.5% IOF fee. By proceeding, you acknowledge and accept <terms>Ebanx’s terms and conditions</terms>." = "Il s’agit d’un achat international n’incluant pas la taxe IOF de 3,5 %. En continuant, vous reconnaissez et acceptez les <terms>Conditions générales d’Ebanx</terms>.";
/* Text of a label indicating that a payment method is the default. */
"This is your default" = "Votre moyen de paiement par défaut";
/* Content for alert popup prompting if they want to remove a payment method when using payment_method_remove == .partial. %@ is replaced by the merchant name */
"This payment method will be removed but will remain available for %@ subscriptions." = "Ce moyen de paiement sera supprimé mais restera disponible pour les Abonnements %@.";
/* Error when the phone number entered before Link email verification does not match the account. */
"This phone number doesn't match your Link account. Please try again." = "Ce numéro de téléphone ne correspond pas à celui associé à votre compte Link. Veuillez réessayer.";
/* Error when the user hasn't allowed the current app to access the camera when scanning a payment card. 'Settings' is the localized name of the iOS Settings app. */
"To scan your card, allow camera access in Settings." = "Pour numériser votre carte bancaire, autorisez l’accès à la caméra dans les Paramètres.";
/* Error message shown when the user enters an incorrect verification code too many times. */
"Too many attempts. Please try again in a few minutes." = "Vous avez effectué un nombre trop élevé de tentatives. Veuillez réessayer dans quelques minutes.";
/* Accessibility label for a button that turns off the flashlight while scanning a card. */
"Turn off flashlight" = "Éteindre la lampe torche";
/* Accessibility label for a button that turns on the flashlight while scanning a card. */
"Turn on flashlight" = "Allumer la lampe torche";
/* Label shown when a payment method cannot be used for the current transaction. */
"Unavailable for this purchase" = "Indisponible pour cet achat";
/* Title for a button that when tapped, updates a card brand. */
"Update" = "Modifier";
/* Title for a button that when tapped, presents a screen for updating a card. Also the heading the screen itself. */
"Update card" = "Mettre à jour la carte";
/* Title for a screen for updating a card brand. */
"Update card brand" = "Modifier la marque de la carte";
/* Accessibility label for a button that leads to a screen for updating a payment method. */
"Update payment method" = "Mettre à jour le moyen de paiement";
/* Label for checkbox in address form allowing user to use billing address */
"Use billing address for shipping" = "Utiliser l'adresse de facturation pour l'expédition";
/* Two factor authentication screen heading */
"Use your saved info to check out faster" = "Utilisez vos informations enregistrées pour payer plus rapidement";
/* Heading for the Link phone-match screen. */
"Verify your phone number" = "Vérifiez votre numéro de téléphone";
/* Link authentication in progress. */
"Verifying your account…" = "Vérification de votre compte en cours…";
/* Text shown on a button that when tapped opens a user's screen with their payment methods. */
"View more" = "Afficher plus";
/* Link authentication cannot continue with the available verification methods. */
"We couldn't verify your account. Please close this window and try again." = "Nous n’avons pas pu vérifier votre compte. Veuillez fermer cette fenêtre et réessayer.";
/* Text for a tappable link that will update the email field with a suggested email address. */
"Yes, update" = "Oui, mettre à jour";
/* Title of a screen shown when none of the payment methods in the user's Link account can be used with this business. The placeholder is a Stripe brand name and should not be translated. */
"You can't pay with %@ here" = "Vous ne pouvez pas payer avec %@ ici";
/* An error message displayed when the IBAN does not start with a two-letter country code. */
"Your IBAN should start with a two-letter country code." = "Votre IBAN doit commencer par un code pays à deux lettres.";
/* Message of a confirmation alert warning the customer that closing the address form will discard their unsaved changes. */
"Your address changes won't be saved." = "Les modifications apportées à votre adresse ne seront pas enregistrées.";
/* Error message for card details form when expiration date has passed */
"Your card has expired." = "Votre carte bancaire a expiré.";
/* iDEAL bank section title for iDEAL form entry. */
"iDEAL Bank" = "Banque iDEAL";