/* Label for the shipping cost row in an order summary. */
"Shipping" = "Dodanie";
/* Title for shipping address entry section */
"Shipping Address" = "Dodacia adresa";
/* Text for an error that is shown when a user selects a shipping address that
is not supported by the merchant. Example: Shipping to Canada is not supported. */
"Shipping to %@ is not supported." = "Dodanie na/do %@ sa nepodporuje.";
/* Button label to expand and show additional exchange rate details */
"Show details" = "Zobraziť podrobnosti";
/* Accessibility label for an action or a button that shows a menu. */
"Show menu" = "Zobraziť ponuku";
/* Title for a button that indicates a user can sign in or sign up. */
"Sign in or sign up" = "Prihlásiť sa alebo zaregistrovať";
/* Two factor authentication screen heading */
"Sign in to your Link account" = "Prihláste sa do svojho účtu Link";
/* Title of the sign-out action. The placeholder is a Stripe brand name and should not be translated. */
"Sign out of %@" = "Odhlásiť sa zo služby %@";
/* Title of the sign-out action. */
"Sign out of Link" = "Odhlásiť sa zo služby Link";
/* Subtitle shown on a button allowing a user to select to pay with Link. */
"Simple, secure one-click payments" = "Jednoduché, bezpečné platby jedným kliknutím";
/* Error message when an error case happens when linking your account */
"Something went wrong when linking your account.\nPlease try again later." = "Pri prepájaní vášho účtu sa vyskytla chyba.\nSkúste to znova neskôr.";
/* Prompt for microdeposit verification before completing saving payment method with merchant. %@ will be replaced by merchant business name */
"Stripe will deposit $0.01 to your account in 1-2 business days. Then you'll get an email with instructions to finish saving your bank account with %@." = "V priebehu 1 až 2 pracovných dní vloží Stripe na váš účet vklad vo výške 0,01 USD. Potom dostanete e-mail s pokynmi na dokončenie uloženia svojho účtu prostredníctvom %@.";
/* Prompt for microdeposit verification before completing purchase with merchant. %@ will be replaced by merchant business name */
"Stripe will deposit $0.01 to your account in 1-2 business days. Then you’ll get an email with instructions to complete payment to %@." = "V priebehu 1 až 2 pracovných dní vloží Stripe na váš účet vklad vo výške 0,01 USD. Potom dostanete e-mail s pokynmi na dokončenie platby spoločnosti %@.";
/* Label for the subtotal row in an order summary, before tax/shipping/discounts. */
"Subtotal" = "Medzisúčet";
/* Accessibility label for the card brand icons displayed next to the card number field. %@ is a comma-separated list of card brand names (e.g. 'Visa, Mastercard, American Express, Discover') */
"Supported cards: %@" = "Podporované karty: %@";
/* Accessibility hint to tell the user that they can tap to hide additional content. */
"Tap to close" = "Ťuknutím zatvorte";
/* Accessibility hint to tell the user that they can tap to reveal additional content. */
"Tap to expand" = "Ťuknutím rozbaľte";
/* Label for the tax row in an order summary. */
"Tax" = "Daň";
/* Title label for a screen showing terms and conditions */
"Terms and Conditions" = "Zmluvné podmienky";
/* Title label for a screen showing terms of service */
"Terms of Service" = "Podmienky služby";
/* test */
"Test123" = "Test123";
/* An error message displayed when the customer's IBAN is incomplete. */
"The IBAN you entered is incomplete." = "Zadaný IBAN je neúplný.";
/* An error message. */
"The IBAN you entered is invalid, \"%@\" is not a supported country code." = "Zadaný IBAN je neplatný, „%@“ nie je podporovaný kód krajiny.";
/* Error message shown when the user enters an expired verification code. */
"The provided verification code has expired." = "Platnosť zadaného overovacieho kódu skončila.";
/* Error message shown when the user enters an incorrect verification code. */
"The provided verification code is incorrect." = "Zadaný overovací kód je nesprávny.";
/* String to inform a user that specific card brands are not accepted. */
"The selected brand is not allowed" = "Vybraná značka nie je povolená";
/* Disclaimer for when a bank account is not eligible for a promotion. */
"This bank account is ineligible for promotions. <terms>View terms</terms>" = "Tento bankový účet nie je oprávnený na propagačné akcie. <terms>Zobraziť podmienky</terms>";
/* A text notice shown when the user selects an expired card. */
"This card has expired. Update your card info or choose a different payment method." = "Platnosť tejto karty vypršala. Aktualizujte údaje karty alebo zvoľte iný spôsob platby.";
/* Disclosure for an international Pix payment. The terms tags enclose a link to Ebanx's terms. */
"This is an international purchase and excludes a 3.5% IOF fee. By proceeding, you acknowledge and accept <terms>Ebanx’s terms and conditions</terms>." = "Ide o medzinárodný nákup, ktorý nezahŕňa 3,5 % poplatok IOF. Pokračovaním beriete na vedomie a akceptujete <terms>podmienky spoločnosti Ebanx</terms>.";
/* Text of a label indicating that a payment method is the default. */
"This is your default" = "Toto je váš predvolený spôsob platby";
/* Content for alert popup prompting if they want to remove a payment method when using payment_method_remove == .partial. %@ is replaced by the merchant name */
"This payment method will be removed but will remain available for %@ subscriptions." = "Tento spôsob platby sa odstráni, ale ostane k dispozícii pre predplatné %@.";
/* Error when the phone number entered before Link email verification does not match the account. */
"This phone number doesn't match your Link account. Please try again." = "Toto telefónne číslo sa nezhoduje s vaším účtom Link. Skúste to znova.";
/* Error when the user hasn't allowed the current app to access the camera when scanning a payment card. 'Settings' is the localized name of the iOS Settings app. */
"To scan your card, allow camera access in Settings." = "Ak chcete naskenovať kartu, povoľte prístup k fotoaparátu v časti Nastavenia.";
/* Error message shown when the user enters an incorrect verification code too many times. */
"Too many attempts. Please try again in a few minutes." = "Príliš veľa pokusov. Skúste to znova o niekoľko minút.";
/* Accessibility label for a button that turns off the flashlight while scanning a card. */
"Turn off flashlight" = "Vypnite baterku";
/* Accessibility label for a button that turns on the flashlight while scanning a card. */
"Turn on flashlight" = "Zapnite baterku";
/* Label shown when a payment method cannot be used for the current transaction. */
"Unavailable for this purchase" = "Nie je k dispozícii pre tento nákup";
/* Title for a button that when tapped, updates a card brand. */
"Update" = "Aktualizovať";
/* Title for a button that when tapped, presents a screen for updating a card. Also the heading the screen itself. */
"Update card" = "Aktualizovať kartu";
/* Title for a screen for updating a card brand. */
"Update card brand" = "Aktualizovať značku karty";
/* Accessibility label for a button that leads to a screen for updating a payment method. */
"Update payment method" = "Aktualizovať spôsob platby";
/* Label for checkbox in address form allowing user to use billing address */
"Use billing address for shipping" = "Použiť fakturačnú adresu na doručenie";
