/* Text for an error that is shown when a user selects a shipping address that
is not supported by the merchant. Example: Shipping to Canada is not supported. */
"Shipping to %@ is not supported." = "Wysyłka do lokalizacji: %@ nie jest obsługiwana";
/* Button label to expand and show additional exchange rate details */
"Show details" = "Pokaż szczegóły";
/* Accessibility label for an action or a button that shows a menu. */
"Show menu" = "Pokaż menu";
/* Title for a button that indicates a user can sign in or sign up. */
"Sign in or sign up" = "Zaloguj się lub zarejestruj się";
/* Two factor authentication screen heading */
"Sign in to your Link account" = "Zaloguj się na konto Link";
/* Title of the sign-out action. The placeholder is a Stripe brand name and should not be translated. */
"Sign out of %@" = "Wyloguj się z %@";
/* Title of the sign-out action. */
"Sign out of Link" = "Wyloguj się z Link";
/* Subtitle shown on a button allowing a user to select to pay with Link. */
"Simple, secure one-click payments" = "Łatwe, bezpieczne płatności jednym kliknięciem";
/* Error message when an error case happens when linking your account */
"Something went wrong when linking your account.\nPlease try again later." = "Coś poszło nie tak podczas łączenia konta.\nSpróbuj później.";
/* Prompt for microdeposit verification before completing saving payment method with merchant. %@ will be replaced by merchant business name */
"Stripe will deposit $0.01 to your account in 1-2 business days. Then you'll get an email with instructions to finish saving your bank account with %@." = "Stripe wpłaci 0,01 USD na Twoje konto w ciągu 1–2 dni roboczych. Następnie otrzymasz wiadomość e-mail z instrukcjami dotyczącymi zakończenia zapisywania konta za pomocą %@.";
/* Prompt for microdeposit verification before completing purchase with merchant. %@ will be replaced by merchant business name */
"Stripe will deposit $0.01 to your account in 1-2 business days. Then you’ll get an email with instructions to complete payment to %@." = "Stripe wpłaci 0,01 USD na Twoje konto w ciągu 1-2 dni roboczych. Następnie otrzymasz wiadomość e-mail z instrukcjami dotyczącymi zakończenia płatności na rzecz %@.";
/* Label for the subtotal row in an order summary, before tax/shipping/discounts. */
"Subtotal" = "Suma częściowa";
/* Accessibility label for the card brand icons displayed next to the card number field. %@ is a comma-separated list of card brand names (e.g. 'Visa, Mastercard, American Express, Discover') */
"Supported cards: %@" = "Obsługiwane karty: %@";
/* Accessibility hint to tell the user that they can tap to hide additional content. */
"Tap to close" = "Dotknij, aby zamknąć";
/* Accessibility hint to tell the user that they can tap to reveal additional content. */
"Tap to expand" = "Dotknij, aby rozwinąć";
/* Label for the tax row in an order summary. */
"Tax" = "Podatek";
/* Title label for a screen showing terms and conditions */
"Terms and Conditions" = "Warunki";
/* Title label for a screen showing terms of service */
"Terms of Service" = "Warunki świadczenia usługi";
/* test */
"Test123" = "Test123";
/* An error message displayed when the customer's IBAN is incomplete. */
"The IBAN you entered is incomplete." = "Podany IBAN jest niepełny.";
/* An error message. */
"The IBAN you entered is invalid, \"%@\" is not a supported country code." = "Podany numer IBAN jest nieprawidłowy, a „%@” nie jest obsługiwanym kodem kraju.";
/* Error message shown when the user enters an expired verification code. */
"The provided verification code has expired." = "Podany kod weryfikacyjny jest nieaktualny.";
/* Error message shown when the user enters an incorrect verification code. */
"The provided verification code is incorrect." = "Podany kod weryfikacyjny jest nieprawidłowy.";
/* String to inform a user that specific card brands are not accepted. */
"The selected brand is not allowed" = "Wybrana marka nie jest dozwolona";
/* Disclaimer for when a bank account is not eligible for a promotion. */
"This bank account is ineligible for promotions. <terms>View terms</terms>" = "To konto bankowe nie kwalifikuje się do promocji. <terms>Zobacz Warunki</terms>";
/* A text notice shown when the user selects an expired card. */
"This card has expired. Update your card info or choose a different payment method." = "Termin ważności tej karty minął. Zaktualizuj informacje o karcie lub wybierz inną metodę płatności.";
/* Disclosure for an international Pix payment. The terms tags enclose a link to Ebanx's terms. */
"This is an international purchase and excludes a 3.5% IOF fee. By proceeding, you acknowledge and accept <terms>Ebanx’s terms and conditions</terms>." = "Jest to zakup międzynarodowy i nie obejmuje opłat w wysokości 3,5% IOF. Kontynuując, uznajesz i akceptujesz <terms>warunki Ebanx</terms>.";
/* Text of a label indicating that a payment method is the default. */
"This is your default" = "To Twoje ustawienie domyślne";
/* Content for alert popup prompting if they want to remove a payment method when using payment_method_remove == .partial. %@ is replaced by the merchant name */
"This payment method will be removed but will remain available for %@ subscriptions." = "Ta metoda płatności zostanie usunięta, ale pozostanie dostępna dla %@ subskrypcji.";
/* Error when the phone number entered before Link email verification does not match the account. */
"This phone number doesn't match your Link account. Please try again." = "Ten numer telefonu nie pasuje do Twojego konta Link. Spróbuj ponownie.";
/* Error when the user hasn't allowed the current app to access the camera when scanning a payment card. 'Settings' is the localized name of the iOS Settings app. */
"To scan your card, allow camera access in Settings." = "Aby zeskanować kartę, zezwól na dostęp do aparatu w Ustawieniach.";
/* Error message shown when the user enters an incorrect verification code too many times. */
"Too many attempts. Please try again in a few minutes." = "Zbyt wiele prób. Spróbuj ponownie za kilka minut.";
/* Accessibility label for a button that turns off the flashlight while scanning a card. */
"Turn off flashlight" = "Wyłącz latarkę";
/* Accessibility label for a button that turns on the flashlight while scanning a card. */
"Turn on flashlight" = "Włącz latarkę";
/* Label shown when a payment method cannot be used for the current transaction. */
"Unavailable for this purchase" = "Niedostępne dla tego zakupu";
/* Title for a button that when tapped, updates a card brand. */
"Update" = "Aktualizuj";
/* Title for a button that when tapped, presents a screen for updating a card. Also the heading the screen itself. */
"Update card" = "Zaktualizuj kartę";
/* Title for a screen for updating a card brand. */
"Update card brand" = "Zaktualizuj markę karty";
/* Accessibility label for a button that leads to a screen for updating a payment method. */
"Update payment method" = "Aktualizuj metodę płatności";
/* Label for checkbox in address form allowing user to use billing address */
"Use billing address for shipping" = "Użyj adresu rozliczeniowego do dostawy";
/* Two factor authentication screen heading */
"Use your saved info to check out faster" = "Użyj zapisanych danych, aby szybciej zakończyć operację.";
/* Heading for the Link phone-match screen. */
"Verify your phone number" = "Zweryfikuj numer telefonu";
/* Link authentication in progress. */
"Verifying your account…" = "Weryfikowanie Twojego konta…";
/* Text shown on a button that when tapped opens a user's screen with their payment methods. */
"View more" = "Wyświetl więcej";
/* Link authentication cannot continue with the available verification methods. */
"We couldn't verify your account. Please close this window and try again." = "Nie udało nam się zweryfikować Twojego konta. Zamknij to okno i spróbuj ponownie.";
/* Text for a tappable link that will update the email field with a suggested email address. */
"Yes, update" = "Tak, aktualizuj";
/* Title of a screen shown when none of the payment methods in the user's Link account can be used with this business. The placeholder is a Stripe brand name and should not be translated. */
"You can't pay with %@ here" = "Nie możesz tutaj zapłacić za pomocą %@";
/* An error message displayed when the IBAN does not start with a two-letter country code. */
"Your IBAN should start with a two-letter country code." = "IBAN powinien się zaczynać od dwuliterowego kodu kraju.";
/* Message of a confirmation alert warning the customer that closing the address form will discard their unsaved changes. */
"Your address changes won't be saved." = "Twoje zmiany adresu nie zostaną zapisane.";
/* Error message for card details form when expiration date has passed */
"Your card has expired." = "Twoja karta wygasła.";
/* iDEAL bank section title for iDEAL form entry. */
"iDEAL Bank" = "iDEAL Bank";