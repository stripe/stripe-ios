/* Label a default funding source, which we treat as a generic card. E.g. 'Visa Card' */
"%1$@ Card" = "%1$@-betaalkaart";
/* Label a credit funding source. E.g. in english 'Visa Credit', or in german 'Visa-Kreditkarte' */
"%1$@ Credit" = "%1$@-creditcard";
/* Label a debit funding source. E.g. 'Visa Debit' */
"%1$@ Debit" = "%1$@-debitcard";
/* Label a prepaid funding source. E.g. 'Visa Prepaid' */
"%1$@ Prepaid" = "%1$@-prepaidkaart";
/* Details of a saved bank account. '{bank name} account ending in {last 4}' e.g. 'Chase account ending in 4242' */
"%1$@ account ending in %2$@" = "%1$@-rekening die eindigt op %2$@";
/* Details of a saved card. '{card brand} ending in {last 4}' e.g. 'VISA ending in 4242' */
"%1$@ ending in %2$@" = "%1$@ eindigend op %2$@";
/* String to inform a user that specific card brands are not accepted. E.g. American Express is not accepted */
"%1$@ is not accepted" = "%1$@ wordt niet geaccepteerd";
/* Order summary line item showing name and quantity, e.g. 'Shirt ×3'. */
"%1$@ ×%2$d" = "%1$@ ×%2$li";
/* Subtitle shown on a button allowing a user to select to pay with Afterpay. E.g. 4 interest-free payments of $24.99 */
"%1$d interest-free payments of %2$@" = "%1$li rentevrije betalingen van %2$@";
/* Disclaimer for when a promotion is available for setting up a bank account. e.g. '$5 back on […]' */
"%@ back on a qualifying purchase when you pay by bank. <terms>View terms</terms>" = "%@ terug bij een in aanmerking komende aankoop wanneer je via de bank betaalt. <terms>Voorwaarden bekijken</terms>";
/* Disclaimer for when a promotion is available for paying with a bank account. e.g. '$5 back when […]' */
"%@ back when you pay by bank. <terms>View terms</terms>" = "%@ terug wanneer je via de bank betaalt. <terms>Voorwaarden bekijken</terms>";
/* Message shown in a confirmation prompt when removing a saved payment method. */
"%@ will no longer be saved to your wallet." = "%@ wordt niet meer opgeslagen in je wallet.";
/* Subtitle shown on a button allowing a user to select to pay with Afterpay. E.g. 4 interest-free payments of $24.99 */
"%d interest-free payments of %@" = "%1$li rentevrije betalingen van %2$@";
/* Text for a button that, when tapped, displays another screen where the customer can add payment method details */
