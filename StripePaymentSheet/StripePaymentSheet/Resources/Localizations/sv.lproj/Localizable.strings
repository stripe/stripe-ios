"To scan your card, allow camera access in Settings." = "Tillåt kameraåtkomst i Inställningar för att skanna kortet.";
/* Error message shown when the user enters an incorrect verification code too many times. */
"Too many attempts. Please try again in a few minutes." = "För många försök. Försök igen om några minuter.";
/* Accessibility label for a button that turns off the flashlight while scanning a card. */
"Turn off flashlight" = "Stäng av ficklampan";
/* Accessibility label for a button that turns on the flashlight while scanning a card. */
"Turn on flashlight" = "Slå på ficklampan";
/* Label shown when a payment method cannot be used for the current transaction. */
"Unavailable for this purchase" = "Otillgängligt för detta köp";
/* Title for a button that when tapped, updates a card brand. */
"Update" = "Uppdatera";
/* Title for a button that when tapped, presents a screen for updating a card. Also the heading the screen itself. */
"Update card" = "Uppdatera kort";
/* Title for a screen for updating a card brand. */
"Update card brand" = "Uppdatera kortvarumärke";
/* Accessibility label for a button that leads to a screen for updating a payment method. */
"Update payment method" = "Uppdatera betalningsmetod";
/* Label for checkbox in address form allowing user to use billing address */
"Use billing address for shipping" = "Använd faktureringsadress för leverans";
/* Two factor authentication screen heading */
"Use your saved info to check out faster" = "Använd din sparade information för att betala snabbare";
/* Heading for the Link phone-match screen. */
"Verify your phone number" = "Verifiera ditt telefonnummer";
/* Link authentication in progress. */
"Verifying your account…" = "Verifierar ditt konto …";
/* Text shown on a button that when tapped opens a user's screen with their payment methods. */
"View more" = "Visa mer";
/* Link authentication cannot continue with the available verification methods. */
"We couldn't verify your account. Please close this window and try again." = "Vi kunde inte verifiera ditt konto. Stäng det här fönstret och försök igen.";
/* Text for a tappable link that will update the email field with a suggested email address. */
"Yes, update" = "Ja, uppdatera";
/* Title of a screen shown when none of the payment methods in the user's Link account can be used with this business. The placeholder is a Stripe brand name and should not be translated. */
"You can't pay with %@ here" = "Du kan inte betala med %@ här";
/* An error message displayed when the IBAN does not start with a two-letter country code. */
"Your IBAN should start with a two-letter country code." = "Ditt IBAN ska börja med en landskod (två bokstäver).";
/* Message of a confirmation alert warning the customer that closing the address form will discard their unsaved changes. */
"Your address changes won't be saved." = "Dina adressändringar kommer inte att sparas.";
/* Error message for card details form when expiration date has passed */
"Your card has expired." = "Ditt kort har upphört att gälla.";
/* iDEAL bank section title for iDEAL form entry. */
"iDEAL Bank" = "iDEAL Bank";