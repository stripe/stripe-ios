"%@ back when you pay by bank. <terms>View terms</terms>" = "%@ vračila, če plačate prek banke. <terms>Oglejte si pogoje</terms>";
/* Message shown in a confirmation prompt when removing a saved payment method. */
"%@ will no longer be saved to your wallet." = "%@ ne bo več shranjeno v vaši denarnici.";
/* Subtitle shown on a button allowing a user to select to pay with Afterpay. E.g. 4 interest-free payments of $24.99 */
"%d interest-free payments of %@" = "%1$li plačil brez obresti v znesku %2$@";
