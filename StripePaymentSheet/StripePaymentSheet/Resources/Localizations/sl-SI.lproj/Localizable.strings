"Show menu" = "Pokaži meni";
/* Title for a button that indicates a user can sign in or sign up. */
"Sign in or sign up" = "Vpišite se ali se prijavite";
/* Two factor authentication screen heading */
"Sign in to your Link account" = "Vpišite se v svoj račun za Link";
/* Title of the sign-out action. The placeholder is a Stripe brand name and should not be translated. */
"Sign out of %@" = "Odjavite se iz %@";
/* Title of the sign-out action. */
"Sign out of Link" = "Odjavite se iz Link";
/* Subtitle shown on a button allowing a user to select to pay with Link. */
"Simple, secure one-click payments" = "Enostavna in varna plačila z enim klikom";
/* Error message when an error case happens when linking your account */
"Something went wrong when linking your account.\nPlease try again later." = "Pri povezovanju vašega računa je prišlo do napake.\nPoskusite znova pozneje.";
/* Prompt for microdeposit verification before completing saving payment method with merchant. %@ will be replaced by merchant business name */
"Stripe will deposit $0.01 to your account in 1-2 business days. Then you'll get an email with instructions to finish saving your bank account with %@." = "Stripe bo v 1–2 delovnih dneh na vaš račun nakazal znesek v višini 0,01 USD. Nato boste prejeli e-poštno sporočilo z navodili za dokončanje shranjevanja bančnega računa pri podjetju %@.";
/* Prompt for microdeposit verification before completing purchase with merchant. %@ will be replaced by merchant business name */
"Stripe will deposit $0.01 to your account in 1-2 business days. Then you’ll get an email with instructions to complete payment to %@." = "Stripe bo v 1–2 delovnih dneh na vaš račun nakazal znesek v višini 0,01 USD. Nato boste prejeli e-poštno sporočilo z navodili za dokončanje plačila podjetju %@.";
/* Label for the subtotal row in an order summary, before tax/shipping/discounts. */
"Subtotal" = "Vmesni seštevek";
/* Accessibility label for the card brand icons displayed next to the card number field. %@ is a comma-separated list of card brand names (e.g. 'Visa, Mastercard, American Express, Discover') */
"Supported cards: %@" = "Podprte kartice: %@";
/* Accessibility hint to tell the user that they can tap to hide additional content. */
"Tap to close" = "Tapnite, da zaprete";
/* Accessibility hint to tell the user that they can tap to reveal additional content. */
"Tap to expand" = "Tapnite, da razširite";
/* Label for the tax row in an order summary. */
"Tax" = "Davek";
/* Title label for a screen showing terms and conditions */
"Terms and Conditions" = "Pogoji in določila";
/* Title label for a screen showing terms of service */
"Terms of Service" = "Pogoji storitve";
/* test */
"Test123" = "Test 123";
/* An error message displayed when the customer's IBAN is incomplete. */
"The IBAN you entered is incomplete." = "Vnesena koda IBAN ni popolna.";
/* An error message. */
"The IBAN you entered is invalid, \"%@\" is not a supported country code." = "Vnesena koda IBAN ni veljavna. »%@« ni podprta koda države.";
/* Error message shown when the user enters an expired verification code. */
"The provided verification code has expired." = "Navedena potrditvena koda je potekla.";
/* Error message shown when the user enters an incorrect verification code. */
"The provided verification code is incorrect." = "Navedena potrditvena koda ni pravilna.";
/* String to inform a user that specific card brands are not accepted. */
"The selected brand is not allowed" = "Izbrana blagovna znamka ni dovoljena";
/* Disclaimer for when a bank account is not eligible for a promotion. */
"This bank account is ineligible for promotions. <terms>View terms</terms>" = "Ta bančni račun ni upravičen do promocij. <terms>Oglejte si pogoje</terms>";
/* A text notice shown when the user selects an expired card. */
"This card has expired. Update your card info or choose a different payment method." = "Ta kartica je potekla. Posodobite podatke o kartici ali izberite drug način plačila.";
/* Disclosure for an international Pix payment. The terms tags enclose a link to Ebanx's terms. */
"This is an international purchase and excludes a 3.5% IOF fee. By proceeding, you acknowledge and accept <terms>Ebanx’s terms and conditions</terms>." = "To je mednarodni nakup in ne vključuje 3,5-% pristojbine IOF. Z nadaljevanjem potrjujete in sprejemate <terms>Pogoje in določila družbe Ebanx</terms>.";
/* Text of a label indicating that a payment method is the default. */
"This is your default" = "To je vaš privzeti način plačila";
/* Content for alert popup prompting if they want to remove a payment method when using payment_method_remove == .partial. %@ is replaced by the merchant name */
"This payment method will be removed but will remain available for %@ subscriptions." = "Ta način plačila bo odstranjen, vendar bo še naprej na voljo za naročnine %@.";
/* Error when the phone number entered before Link email verification does not match the account. */
"This phone number doesn't match your Link account. Please try again." = "Ta telefonska številka se ne ujema z vašim računom Link. Prosimo, poskusite znova.";
/* Error when the user hasn't allowed the current app to access the camera when scanning a payment card. 'Settings' is the localized name of the iOS Settings app. */
"To scan your card, allow camera access in Settings." = "Za optično branje kartice dovolite dostop do kamere v nastavitvah.";
/* Error message shown when the user enters an incorrect verification code too many times. */
"Too many attempts. Please try again in a few minutes." = "Preveč poskusov. Poskusite znova čez nekaj minut.";
/* Accessibility label for a button that turns off the flashlight while scanning a card. */
"Turn off flashlight" = "Izklopite svetilko";
/* Accessibility label for a button that turns on the flashlight while scanning a card. */
"Turn on flashlight" = "Vklopite svetilko";
/* Label shown when a payment method cannot be used for the current transaction. */
"Unavailable for this purchase" = "Ni na voljo za ta nakup";
/* Title for a button that when tapped, updates a card brand. */
"Update" = "Posodobi";
/* Title for a button that when tapped, presents a screen for updating a card. Also the heading the screen itself. */
"Update card" = "Posodobi kartico";
/* Title for a screen for updating a card brand. */
"Update card brand" = "Posodobite blagovno znamko kartico";
/* Accessibility label for a button that leads to a screen for updating a payment method. */
"Update payment method" = "Posodobite način plačila";
/* Label for checkbox in address form allowing user to use billing address */
"Use billing address for shipping" = "Naslov za račun uporabi kot naslov za pošiljanje";
/* Two factor authentication screen heading */
"Use your saved info to check out faster" = "Uporabite svoje shranjene podatke za hitrejšo izvedbo plačila";
/* Heading for the Link phone-match screen. */
"Verify your phone number" = "Preverjanje telefonske številke";
/* Link authentication in progress. */
"Verifying your account…" = "Preverjanje vašega računa …";
/* Text shown on a button that when tapped opens a user's screen with their payment methods. */
"View more" = "Prikaži več";
/* Link authentication cannot continue with the available verification methods. */
"We couldn't verify your account. Please close this window and try again." = "Nismo mogli preveriti vašega računa. Prosimo, zaprite to okno in poskusite znova.";
/* Text for a tappable link that will update the email field with a suggested email address. */
"Yes, update" = "Da, posodobi";
/* Title of a screen shown when none of the payment methods in the user's Link account can be used with this business. The placeholder is a Stripe brand name and should not be translated. */
"You can't pay with %@ here" = "Tukaj ne morete plačati z %@";
/* An error message displayed when the IBAN does not start with a two-letter country code. */
"Your IBAN should start with a two-letter country code." = "Vaša koda IBAN se mora začeti z dvomestno kodo države.";
/* Message of a confirmation alert warning the customer that closing the address form will discard their unsaved changes. */
"Your address changes won't be saved." = "Vaše spremembe naslova ne bodo shranjene.";
/* Error message for card details form when expiration date has passed */
"Your card has expired." = "Vaša kartica je potekla.";
/* iDEAL bank section title for iDEAL form entry. */
"iDEAL Bank" = "Banka iDEAL";