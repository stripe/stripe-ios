"Tap to close" = "Ketik untuk tutup";
/* Accessibility hint to tell the user that they can tap to reveal additional content. */
"Tap to expand" = "Ketik untuk kembangkan";
/* Label for the tax row in an order summary. */
"Tax" = "Cukai";
/* Title label for a screen showing terms and conditions */
"Terms and Conditions" = "Terma dan Syarat";
/* Title label for a screen showing terms of service */
"Terms of Service" = "Terma Perkhidmatan";
/* test */
"Test123" = "Ujian123";
/* An error message displayed when the customer's IBAN is incomplete. */
"The IBAN you entered is incomplete." = "IBAN yang anda masukkan tidak lengkap.";
/* An error message. */
"The IBAN you entered is invalid, \"%@\" is not a supported country code." = "IBAN yang anda masukkan tidak sah, “%@” bukan kod negara yang disokong.";
/* Error message shown when the user enters an expired verification code. */
"The provided verification code has expired." = "Kod penentusahan yang diberikan telah tamat tempoh.";
/* Error message shown when the user enters an incorrect verification code. */
"The provided verification code is incorrect." = "Kod penentusahan yang diberikan tidak betul.";
/* String to inform a user that specific card brands are not accepted. */
"The selected brand is not allowed" = "Jenama yang dipilih tidak dibenarkan";
/* Disclaimer for when a bank account is not eligible for a promotion. */
"This bank account is ineligible for promotions. <terms>View terms</terms>" = "Akaun bank ini tidak layak untuk promosi. <terms>Lihat terma</terms>";
/* A text notice shown when the user selects an expired card. */
"This card has expired. Update your card info or choose a different payment method." = "Kad ini telah tamat tempoh. Kemas kinikan maklumat kad anda atau pilih kaedah pembayaran yang lain.";
/* Disclosure for an international Pix payment. The terms tags enclose a link to Ebanx's terms. */
"This is an international purchase and excludes a 3.5% IOF fee. By proceeding, you acknowledge and accept <terms>Ebanx’s terms and conditions</terms>." = "Ini adalah pembelian antarabangsa dan tidak termasuk yuran IOF sebanyak 3.5%. Dengan meneruskan, anda mengakui dan menerima <terms>terma dan syarat Ebanx<terms>.";
/* Text of a label indicating that a payment method is the default. */
"This is your default" = "Ini tetapan asal anda";
/* Content for alert popup prompting if they want to remove a payment method when using payment_method_remove == .partial. %@ is replaced by the merchant name */
"This payment method will be removed but will remain available for %@ subscriptions." = "Kaedah pembayaran ini akan dialih keluar tetapi akan kekal tersedia untuk langganan %@.";
/* Error when the phone number entered before Link email verification does not match the account. */
"This phone number doesn't match your Link account. Please try again." = "Nombor telefon ini tidak sepadan dengan akaun Link anda. Sila cuba lagi.";
/* Error when the user hasn't allowed the current app to access the camera when scanning a payment card. 'Settings' is the localized name of the iOS Settings app. */
"To scan your card, allow camera access in Settings." = "Untuk mengimbas kad anda, benarkan akses kamera dalam Tetapan.";
/* Error message shown when the user enters an incorrect verification code too many times. */
"Too many attempts. Please try again in a few minutes." = "Terlalu banyak percubaan. Sila cuba lagi dalam beberapa minit.";
/* Accessibility label for a button that turns off the flashlight while scanning a card. */
"Turn off flashlight" = "Matikan lampu suluh";
/* Accessibility label for a button that turns on the flashlight while scanning a card. */
"Turn on flashlight" = "Hidupkan lampu suluh";
/* Label shown when a payment method cannot be used for the current transaction. */
"Unavailable for this purchase" = "Tidak tersedia untuk pembelian ini";
/* Title for a button that when tapped, updates a card brand. */
"Update" = "Kemas kinikan";
/* Title for a button that when tapped, presents a screen for updating a card. Also the heading the screen itself. */
"Update card" = "Kemas kinikan kad";
/* Title for a screen for updating a card brand. */
"Update card brand" = "Kemas kinikan jenama kad";
/* Accessibility label for a button that leads to a screen for updating a payment method. */
"Update payment method" = "Kemas kinikan kaedah pembayaran";
/* Label for checkbox in address form allowing user to use billing address */
"Use billing address for shipping" = "Gunakan alamat pengebilan untuk penghantaran";
/* Two factor authentication screen heading */
"Use your saved info to check out faster" = "Gunakan maklumat anda yang tersimpan untuk keluar dan bayar dengan lebih cepat";
/* Heading for the Link phone-match screen. */
"Verify your phone number" = "Sahkan nombor telefon anda";
/* Link authentication in progress. */
"Verifying your account…" = "Mensahihkan akaun anda…";
/* Text shown on a button that when tapped opens a user's screen with their payment methods. */
"View more" = "Lihat lebih banyak";
/* Link authentication cannot continue with the available verification methods. */
"We couldn't verify your account. Please close this window and try again." = "Kami tidak dapat mensahihkan akaun anda. Sila tutup tetingkap ini dan cuba lagi.";
/* Text for a tappable link that will update the email field with a suggested email address. */
"Yes, update" = "Ya, kemas kini";
/* Title of a screen shown when none of the payment methods in the user's Link account can be used with this business. The placeholder is a Stripe brand name and should not be translated. */
"You can't pay with %@ here" = "Anda tidak boleh membayar dengan %@ di sini";
/* An error message displayed when the IBAN does not start with a two-letter country code. */
"Your IBAN should start with a two-letter country code." = "IBAN anda harus bermula dengan kod negara dua huruf.";
/* Message of a confirmation alert warning the customer that closing the address form will discard their unsaved changes. */
"Your address changes won't be saved." = "Perubahan alamat anda tidak akan disimpan.";
/* Error message for card details form when expiration date has passed */
"Your card has expired." = "Kad anda telah tamat tempoh.";
/* iDEAL bank section title for iDEAL form entry. */
"iDEAL Bank" = "Bank iDEAL";