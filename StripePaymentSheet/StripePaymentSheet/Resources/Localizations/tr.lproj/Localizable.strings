"Shipping to %@ is not supported." = "Varış noktası %@ olan gönderimler desteklenmez.";
/* Button label to expand and show additional exchange rate details */
"Show details" = "Ayrıntıları göster";
/* Accessibility label for an action or a button that shows a menu. */
"Show menu" = "Menüyü göster";
/* Title for a button that indicates a user can sign in or sign up. */
"Sign in or sign up" = "Oturum açın veya kaydolun";
/* Two factor authentication screen heading */
"Sign in to your Link account" = "Link hesabınızda oturum açın";
/* Title of the sign-out action. The placeholder is a Stripe brand name and should not be translated. */
"Sign out of %@" = "%@ oturumunu kapatın";
/* Title of the sign-out action. */
"Sign out of Link" = "Link oturumunu kapatın";
/* Subtitle shown on a button allowing a user to select to pay with Link. */
"Simple, secure one-click payments" = "Tek tıkla basit ve güvenli ödemeler";
/* Error message when an error case happens when linking your account */
"Something went wrong when linking your account.\nPlease try again later." = "Hesabınızı bağlarken bir sorun oluştu.\nLütfen daha sonra tekrar deneyin.";
/* Prompt for microdeposit verification before completing saving payment method with merchant. %@ will be replaced by merchant business name */
"Stripe will deposit $0.01 to your account in 1-2 business days. Then you'll get an email with instructions to finish saving your bank account with %@." = "Stripe, 1-2 iş günü içerisinde hesabınıza 0,01 ABD doları yatıracaktır. Bunun ardından %@ işletmesinde banka hesabınızı kaydetme işlemini tamamlamak için yapmanız gerekenleri içeren bir e-posta alacaksınız.";
/* Prompt for microdeposit verification before completing purchase with merchant. %@ will be replaced by merchant business name */
"Stripe will deposit $0.01 to your account in 1-2 business days. Then you’ll get an email with instructions to complete payment to %@." = "Stripe, 1-2 iş günü içinde hesabınıza 0,01 ABD doları yatıracaktır. Ardından, %@ ödemesini tamamlama talimatlarını içeren bir e-posta alacaksınız.";
/* Label for the subtotal row in an order summary, before tax/shipping/discounts. */
"Subtotal" = "Ara toplam";
/* Accessibility label for the card brand icons displayed next to the card number field. %@ is a comma-separated list of card brand names (e.g. 'Visa, Mastercard, American Express, Discover') */
"Supported cards: %@" = "Desteklenen kartlar: %@";
/* Accessibility hint to tell the user that they can tap to hide additional content. */
"Tap to close" = "Kapatmak için dokunun";
/* Accessibility hint to tell the user that they can tap to reveal additional content. */
"Tap to expand" = "Genişletmek için dokunun";
/* Label for the tax row in an order summary. */
"Tax" = "Vergi";
/* Title label for a screen showing terms and conditions */
"Terms and Conditions" = "Şartlar ve Koşullar";
/* Title label for a screen showing terms of service */
"Terms of Service" = "Hizmet Koşulları";
/* test */
"Test123" = "Test123";
/* An error message displayed when the customer's IBAN is incomplete. */
"The IBAN you entered is incomplete." = "Girdiğiniz IBAN eksik.";
/* An error message. */
"The IBAN you entered is invalid, \"%@\" is not a supported country code." = "Girdiğiniz IBAN geçersiz, \"%@\" desteklenen bir ülke kodu değil.";
/* Error message shown when the user enters an expired verification code. */
"The provided verification code has expired." = "Sağlanan doğrulama kodunun süresi dolmuş.";
/* Error message shown when the user enters an incorrect verification code. */
"The provided verification code is incorrect." = "Sağlanan doğrulama kodu yanlış.";
/* String to inform a user that specific card brands are not accepted. */
"The selected brand is not allowed" = "Seçilen markaya izin verilmiyor";
/* Disclaimer for when a bank account is not eligible for a promotion. */
"This bank account is ineligible for promotions. <terms>View terms</terms>" = "Bu banka hesabı promosyonlar için uygun değil. <terms>Koşulları görüntüle</terms>";
/* A text notice shown when the user selects an expired card. */
"This card has expired. Update your card info or choose a different payment method." = "Bu kartın süresi dolmuş. Kart bilgileirnizi güncelleyin veya farklı bir ödeme yöntemi seçin.";
/* Disclosure for an international Pix payment. The terms tags enclose a link to Ebanx's terms. */
"This is an international purchase and excludes a 3.5% IOF fee. By proceeding, you acknowledge and accept <terms>Ebanx’s terms and conditions</terms>." = "Bu uluslararası bir satın alma işlemidir ve %3,5 IOF ücreti hariçtir. Devam ederek <terms>Ebanx'ın hüküm ve koşullarını</terms> onaylamış ve kabul etmiş olursunuz.";
/* Text of a label indicating that a payment method is the default. */
"This is your default" = "Bu varsayılan ödeme yönteminizdir";
/* Content for alert popup prompting if they want to remove a payment method when using payment_method_remove == .partial. %@ is replaced by the merchant name */
"This payment method will be removed but will remain available for %@ subscriptions." = "Bu ödeme yöntemi kaldırılacak ancak %@ abonelikleri için kullanılabilir kalacaktır.";
/* Error when the phone number entered before Link email verification does not match the account. */
"This phone number doesn't match your Link account. Please try again." = "Bu telefon numarası Link hesabınızla eşleşmiyor. Lütfen tekrar deneyin.";
/* Error when the user hasn't allowed the current app to access the camera when scanning a payment card. 'Settings' is the localized name of the iOS Settings app. */
"To scan your card, allow camera access in Settings." = "Kartınızı taramak için Ayarlar'dan kamera erişimine izin verin.";
/* Error message shown when the user enters an incorrect verification code too many times. */
"Too many attempts. Please try again in a few minutes." = "Çok fazla deneme yapıldı. Lütfen birkaç dakika içinde tekrar deneyin.";
/* Accessibility label for a button that turns off the flashlight while scanning a card. */
"Turn off flashlight" = "El fenerini kapatın";
/* Accessibility label for a button that turns on the flashlight while scanning a card. */
"Turn on flashlight" = "El fenerini açın";
/* Label shown when a payment method cannot be used for the current transaction. */
"Unavailable for this purchase" = "Bu satın alım için kullanılamaz";
/* Title for a button that when tapped, updates a card brand. */
"Update" = "Güncelle";
/* Title for a button that when tapped, presents a screen for updating a card. Also the heading the screen itself. */
"Update card" = "Kartı güncelle";
/* Title for a screen for updating a card brand. */
"Update card brand" = "Kart markasını güncelle";
/* Accessibility label for a button that leads to a screen for updating a payment method. */
"Update payment method" = "Ödeme yöntemini güncelleyin";
/* Label for checkbox in address form allowing user to use billing address */
"Use billing address for shipping" = "Gönderim için fatura adresini kullanın";
/* Two factor authentication screen heading */
"Use your saved info to check out faster" = "Kayıtlı bilgilerinizi kullanarak daha hızlı ödeme yapabilirsiniz";
/* Heading for the Link phone-match screen. */
"Verify your phone number" = "Telefon numaranızı doğrulayın";
/* Link authentication in progress. */
"Verifying your account…" = "Hesabınız doğrulanıyor…";
/* Text shown on a button that when tapped opens a user's screen with their payment methods. */
"View more" = "Daha fazla göster";
/* Link authentication cannot continue with the available verification methods. */
"We couldn't verify your account. Please close this window and try again." = "Hesabınızı doğrulayamadık. Lütfen bu pencereyi kapatın ve tekrar deneyin.";
/* Text for a tappable link that will update the email field with a suggested email address. */
"Yes, update" = "Evet, güncelle";
/* Title of a screen shown when none of the payment methods in the user's Link account can be used with this business. The placeholder is a Stripe brand name and should not be translated. */
"You can't pay with %@ here" = "Burada %@ ile ödeme yapamazsınız";
/* An error message displayed when the IBAN does not start with a two-letter country code. */
"Your IBAN should start with a two-letter country code." = "IBAN numaranız iki harfli bir ülke koduyla başlamalıdır.";
/* Message of a confirmation alert warning the customer that closing the address form will discard their unsaved changes. */
"Your address changes won't be saved." = "Adres değişiklikleriniz kaydedilmeyecek.";
/* Error message for card details form when expiration date has passed */
"Your card has expired." = "Kartınızın süresi doldu.";
/* iDEAL bank section title for iDEAL form entry. */
"iDEAL Bank" = "iDEAL Bank";