/* Label of a button displayed below a payment method form. Tapping the button sets the payment method up for future use */
"Set up" = "Iestatīt";
/* Label for the shipping cost row in an order summary. */
"Shipping" = "Piegāde";
/* Title for shipping address entry section */
"Shipping Address" = "Piegādes adrese";
/* Text for an error that is shown when a user selects a shipping address that
is not supported by the merchant. Example: Shipping to Canada is not supported. */
"Shipping to %@ is not supported." = "Piegāde uz %@ netiek atbalstīts.";
/* Button label to expand and show additional exchange rate details */
"Show details" = "Rādīt informāciju";
/* Accessibility label for an action or a button that shows a menu. */
"Show menu" = "Rādīt izvēlni";
/* Title for a button that indicates a user can sign in or sign up. */
"Sign in or sign up" = "Pierakstīties vai reģistrēties";
/* Two factor authentication screen heading */
"Sign in to your Link account" = "Pierakstīties Link kontā";
/* Title of the sign-out action. The placeholder is a Stripe brand name and should not be translated. */
"Sign out of %@" = "Izrakstīties no %@";
/* Title of the sign-out action. */
"Sign out of Link" = "Izrakstīties no Link";
/* Subtitle shown on a button allowing a user to select to pay with Link. */
"Simple, secure one-click payments" = "Vienkārši, droši 1 klikšķa maksājumi";
/* Error message when an error case happens when linking your account */
"Something went wrong when linking your account.\nPlease try again later." = "Saistot kontu, kaut kas notika greizi.\nMēģiniet vēlāk vēlreiz.";
/* Prompt for microdeposit verification before completing saving payment method with merchant. %@ will be replaced by merchant business name */
"Stripe will deposit $0.01 to your account in 1-2 business days. Then you'll get an email with instructions to finish saving your bank account with %@." = "Stripe uz jūsu kontu 1–2 darbadienu laikā nosūtīs 0,01 $. Pēc tam saņemsiet e-pastu ar norādījumiem, kā pabeigt bankas konta saglabāšanu ar %@.";
/* Prompt for microdeposit verification before completing purchase with merchant. %@ will be replaced by merchant business name */
"Stripe will deposit $0.01 to your account in 1-2 business days. Then you’ll get an email with instructions to complete payment to %@." = "Stripe uz jūsu kontu 1-2 darbadienu laikā nosūtīs 0,01 $. Pēc tam saņemsiet e-pastu ar norādījumiem, kā pabeigt maksājumu ar %@.";
/* Label for the subtotal row in an order summary, before tax/shipping/discounts. */
"Subtotal" = "Starpsumma";
/* Accessibility label for the card brand icons displayed next to the card number field. %@ is a comma-separated list of card brand names (e.g. 'Visa, Mastercard, American Express, Discover') */
"Supported cards: %@" = "Atbalstītās kartes: %@";
/* Accessibility hint to tell the user that they can tap to hide additional content. */
"Tap to close" = "Pieskarieties, lai aizvērtu";
/* Accessibility hint to tell the user that they can tap to reveal additional content. */
"Tap to expand" = "Pieskarieties, lai izvērstu";
/* Label for the tax row in an order summary. */
"Tax" = "Nodoklis";
/* Title label for a screen showing terms and conditions */
"Terms and Conditions" = "Noteikumi un nosacījumi";
/* Title label for a screen showing terms of service */
"Terms of Service" = "Pakalpojuma lietošanas noteikumi";
/* test */
"Test123" = "Test123";
/* An error message displayed when the customer's IBAN is incomplete. */
"The IBAN you entered is incomplete." = "Ievadītais IBAN nav pilnīgs.";
/* An error message. */
"The IBAN you entered is invalid, \"%@\" is not a supported country code." = "Ievadītais IBAN nav derīgs, “%@” nav atbalstīts valsts kods.";
/* Error message shown when the user enters an expired verification code. */
"The provided verification code has expired." = "Norādītajam verifikācijas kodam ir beidzies derīguma termiņš.";
/* Error message shown when the user enters an incorrect verification code. */
"The provided verification code is incorrect." = "Norādītais verifikācijas kods nav pareizs.";
/* String to inform a user that specific card brands are not accepted. */
"The selected brand is not allowed" = "Izvēlētais zīmols nav atļauts";
/* Disclaimer for when a bank account is not eligible for a promotion. */
"This bank account is ineligible for promotions. <terms>View terms</terms>" = "Šis bankas konts nav atbilstīgs akcijām. <terms>Skatīt noteikumus</terms>";
/* A text notice shown when the user selects an expired card. */
"This card has expired. Update your card info or choose a different payment method." = "Šai kartei ir beidzies derīguma termiņš. Atjauniniet savu kartes informāciju vai izmantojiet citu maksājuma veidu.";
/* Disclosure for an international Pix payment. The terms tags enclose a link to Ebanx's terms. */
"This is an international purchase and excludes a 3.5% IOF fee. By proceeding, you acknowledge and accept <terms>Ebanx’s terms and conditions</terms>." = "Šis ir starptautisks pirkums, un tajā nav iekļauta 3,5 % IOF maksa. Turpinot jūs apliecināt un piekrītat <terms>Ebanx noteikumi un nosacījumi<terms>.";
/* Text of a label indicating that a payment method is the default. */
"This is your default" = "Tas ir jūsu noklusējums";
/* Content for alert popup prompting if they want to remove a payment method when using payment_method_remove == .partial. %@ is replaced by the merchant name */
"This payment method will be removed but will remain available for %@ subscriptions." = "Šis maksājuma veids tiks noņemts, bet joprojām būs pieejams %@ abonementiem.";
/* Error when the phone number entered before Link email verification does not match the account. */
"This phone number doesn't match your Link account. Please try again." = "Šis tālruņa numurs neatbilst jūsu Link kontam. Lūdzu, mēģiniet vēlreiz.";
/* Error when the user hasn't allowed the current app to access the camera when scanning a payment card. 'Settings' is the localized name of the iOS Settings app. */
"To scan your card, allow camera access in Settings." = "Lai noskenētu karti, sadaļā Iestatījumi atļaujiet piekļuvi kamerai.";
/* Error message shown when the user enters an incorrect verification code too many times. */
"Too many attempts. Please try again in a few minutes." = "Pārāk daudz mēģinājumu. Mēģiniet vēlreiz pēc dažām minūtēm.";
/* Accessibility label for a button that turns off the flashlight while scanning a card. */
"Turn off flashlight" = "Izslēdziet lukturīti";
/* Accessibility label for a button that turns on the flashlight while scanning a card. */
"Turn on flashlight" = "Ieslēdziet lukturīti";
/* Label shown when a payment method cannot be used for the current transaction. */
"Unavailable for this purchase" = "Nav pieejams šim pirkumam";
/* Title for a button that when tapped, updates a card brand. */
"Update" = "Atjaunināt";
/* Title for a button that when tapped, presents a screen for updating a card. Also the heading the screen itself. */
"Update card" = "Atjaunināt karti";
/* Title for a screen for updating a card brand. */
"Update card brand" = "Atjaunināt kartes zīmolu";
/* Accessibility label for a button that leads to a screen for updating a payment method. */
"Update payment method" = "Atjaunināt maksājuma veidu";
/* Label for checkbox in address form allowing user to use billing address */
"Use billing address for shipping" = "Piegādei izmantot norēķinu adresi";
/* Two factor authentication screen heading */
"Use your saved info to check out faster" = "Izmantojiet saglabāto informāciju, lai norēķinātos ātrāk";
/* Heading for the Link phone-match screen. */
"Verify your phone number" = "Verificējiet tālruņa numuru";
/* Link authentication in progress. */
"Verifying your account…" = "Verificē jūsu kontu…";
/* Text shown on a button that when tapped opens a user's screen with their payment methods. */
"View more" = "Skatīt vairāk";
/* Link authentication cannot continue with the available verification methods. */
"We couldn't verify your account. Please close this window and try again." = "Mums neizdevās verificēt jūsu kontu. Lūdzu, aizveriet šo logu un mēģiniet vēlreiz.";
/* Text for a tappable link that will update the email field with a suggested email address. */
"Yes, update" = "Jā, atjaunināt";
/* Title of a screen shown when none of the payment methods in the user's Link account can be used with this business. The placeholder is a Stripe brand name and should not be translated. */
"You can't pay with %@ here" = "Jūs šeit nevarat norēķināties ar %@";
/* An error message displayed when the IBAN does not start with a two-letter country code. */
"Your IBAN should start with a two-letter country code." = "IBAN sākumā jābūt divu burtu valsts kodam.";
/* Message of a confirmation alert warning the customer that closing the address form will discard their unsaved changes. */
"Your address changes won't be saved." = "Jūsu adreses izmaiņas netiks saglabātas.";
/* Error message for card details form when expiration date has passed */
"Your card has expired." = "Jūsu kartes derīguma termiņš ir beidzies.";
/* iDEAL bank section title for iDEAL form entry. */
"iDEAL Bank" = "iDEAL banka";