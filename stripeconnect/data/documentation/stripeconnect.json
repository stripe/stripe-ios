{"abstract":[{"type":"text","text":"Use Connect embedded components to add connected account dashboard functionality to your app. The Stripe Connect iOS SDK and supporting API allow you to grant your users access to Stripe products directly in your dashboard."}],"primaryContentSections":[{"content":[{"anchor":"Table-of-contents","type":"heading","text":"Table of contents","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"#Supported-components","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"#Requirements"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"#Getting-started","isActive":true,"type":"reference"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"#Integration","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"#Example"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"#Manual-linking","isActive":true,"type":"reference"}]}]}]},{"anchor":"Supported-components","type":"heading","text":"Supported components","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following Connect embedded component is supported in the iOS SDK:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"https:\/\/docs.stripe.com\/connect\/supported-embedded-components\/account-onboarding?platform=ios","isActive":true},{"type":"text","text":": Show a localized onboarding form that validates data."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/docs.stripe.com\/connect\/supported-embedded-components\/payments?platform=ios"},{"text":": Shows payments and allows users to view payment details and manage disputes.","type":"text"}],"typ