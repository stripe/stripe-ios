/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Akun Link sudah terdaftar dengan email ini. Masuk sebagai gantinya.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Tambahkan %ld dokumen";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Tambahkan 1 dokumen";
/* Action to add documents for another source of funds */
"Add documents" = "Tambahkan dokumen";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Izinkan akses kamera di Pengaturan untuk mengambil foto.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Terjadi kesalahan saat masuk otomatis ke akun Link Anda. Silakan masuk secara manual.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Jawab";
/* Action to open the system document picker to select a file */
"Choose File…" = "Pilih file…";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Pilih Foto…";
/* Button asking the owner to open its support destination */
"Contact support" = "Hubungi dukungan";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Kartu debit kemungkinan besar akan diterima.";
/* Label and picker title for a document's category */
"Document type" = "Tipe dokumen";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokumen berhasil diunggah";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Selesaikan verifikasi akun Link Anda sebelum melanjutkan.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Sumber dana";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Bagaimana Anda mendanai transaksi Anda? Harap cantumkan semua sumber Anda. Misalnya, gaji, tabungan, penghasilan investasi, dll.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Format nomor telepon tidak valid. Harap gunakan format E.164 (misal: +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Pastikan dokumen Anda memenuhi persyaratan berikut.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Belum ada metode pembayaran yang siap digunakan. Silakan menambahkan metode pembayaran dan coba lagi.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Harap pilih kembali metode pembayaran Apple Pay Anda untuk melanjutkan.";
/* Instruction after an unavailable operation */
"Please try again later." = "Coba lagi nanti.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Informasi yang diperlukan tidak lengkap. Silakan coba lagi nanti.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Dikirim untuk ditinjau";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Ambil Foto…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Beri tahu kami tentang sumber dana Anda";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Ada masalah dengan dokumen Anda sebelumnya. Harap unggah dokumen baru.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Aplikasi ini tidak dapat diverifikasi karena kesalahan atestasi. Silakan coba lagi nanti atau hubungi pengembang jika masalah terus berlanjut.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Aplikasi ini tidak dapat diverifikasi. Hubungi pengembang aplikasi untuk mendapatkan bantuan.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "File ini lebih besar dari %1$@. Pilih file yang berukuran %2$@ atau lebih kecil.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Jenis file ini tidak didukung.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Jenis file ini tidak didukung. Unggah file %@.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Dompet digital ini tidak dapat ditemukan. Pilih atau tambahkan dompet digital dan coba lagi.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Jaringan dompet digital ini tidak didukung. Pilih jaringan yang berbeda.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Permintaan verifikasi dompet digital ini telah kedaluwarsa. Coba lagi.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Permintaan verifikasi dompet digital ini tidak valid. Silakan coba lagi.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Permintaan verifikasi dompet digital ini tidak lagi valid. Coba lagi.";
/* Action to select an existing document for upload */
"Upload document" = "Unggah dokumen";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Unggah bukti alamat Anda";
/* Status after a document has uploaded successfully */
"Uploaded" = "Diunggah";
/* Status while a document is uploading */
"Uploading…" = "Mengunggah…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Verifikasi akun Link Anda sebelum melanjutkan.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Kami tidak dapat memverifikasi kepemilikan dompet digital ini. Coba lagi.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Kami tidak dapat membuka dokumen ini. Harap pilih lagi.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Kami tidak dapat mengunggah file ini. Harap coba lagi.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Kami mungkin meminta bukti alamat untuk transaksi yang lebih besar.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Kami mungkin meminta sumber dana untuk transaksi yang lebih besar.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Kami diwajibkan untuk mengonfirmasi alamat Anda untuk mengaktifkan pengeluaran di atas %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Kami diwajibkan untuk memahami asal dana Anda untuk mengaktifkan pengeluaran di atas %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Kami diwajibkan untuk mengonfirmasi alamat Anda untuk mengaktifkan pengeluaran di atas %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Kami diwajibkan untuk memahami asal dana Anda untuk mengaktifkan pengeluaran di atas %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Kami sedang meninjau dokumen Anda. Kami akan memberi tahu Anda setelah verifikasi selesai.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Anda dapat melanjutkan sementara kami memverifikasi dokumen Anda di latar belakang.";