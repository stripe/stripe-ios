/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Υπάρχει ήδη λογαριασμός στο Link για αυτό το email. Αντί για αυτό, συνδεθείτε.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Προσθήκη %ld εγγράφων";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Προσθήκη 1 εγγράφου";
/* Action to add documents for another source of funds */
"Add documents" = "Προσθήκη εγγράφων";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Επιτρέψτε την πρόσβαση στην κάμερα στις Ρυθμίσεις για να τραβήξετε μια φωτογραφία.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Προέκυψε σφάλμα κατά την αυτόματη σύνδεση στον λογαριασμό σας στο Link. Συνδεθείτε χειροκίνητα.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Απάντηση";
/* Action to open the system document picker to select a file */
"Choose File…" = "Επιλογή αρχείου...";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Επιλέξτε φωτογραφία…";
/* Button asking the owner to open its support destination */
"Contact support" = "Επικοινωνήσετε με την υποστήριξη";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Οι χρεωστικές κάρτες είναι πιο πιθανό να γίνουν αποδεκτές.";
/* Label and picker title for a document's category */
"Document type" = "Τύπος εγγράφου";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Το έγγραφο μεταφορτώθηκε με επιτυχία";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Ολοκληρώστε την επαλήθευση του λογαριασμού σας στο Link προτού συνεχίσετε.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Πηγή χρημάτων";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Πώς χρηματοδοτείτε τις συναλλαγές σας; Αναφέρετε όλες τις πηγές σας. Για παράδειγμα, μισθός, αποταμιεύσεις, έσοδα από επενδύσεις κ.λπ.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Μη έγκυρη μορφή τηλεφώνου. Χρησιμοποιήστε τη μορφή E.164 (π.χ. +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Βεβαιωθείτε ότι το έγγραφό σας πληροί τις παρακάτω απαιτήσεις.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Καμία μέθοδος πληρωμής δεν είναι έτοιμη προς χρήση. Συλλέξτε μια μέθοδο πληρωμής και δοκιμάστε ξανά.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Παρακαλούμε επιλέξτε ξανά τη μέθοδο πληρωμής Apple Pay για να συνεχίσετε.";
/* Instruction after an unavailable operation */
"Please try again later." = "Δοκιμάστε ξανά αργότερα.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Λείπουν απαιτούμενες πληροφορίες. Δοκιμάστε ξανά αργότερα.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Υποβλήθηκε για έλεγχο";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Λήψη φωτογραφίας…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Πείτε μας για την πηγή των χρημάτων σας";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Παρουσιάστηκε πρόβλημα με το προηγούμενο έγγραφό σας. Ανεβάστε ένα νέο.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Δεν ήταν δυνατή η επαλήθευση αυτής της εφαρμογής λόγω σφάλματος βεβαίωσης. Δοκιμάστε ξανά αργότερα ή επικοινωνήστε με τον προγραμματιστή αν το πρόβλημα παραμένει.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Δεν ήταν δυνατή η επαλήθευση αυτής της εφαρμογής. Επικοινωνήστε με τον προγραμματιστή της εφαρμογής για βοήθεια.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Αυτό το αρχείο είναι μεγαλύτερο από %1$@. Επιλέξτε ένα αρχείο που είναι %2$@ ή μικρότερο.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Αυτός ο τύπος αρχείου δεν υποστηρίζεται.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Αυτός ο τύπος αρχείου δεν υποστηρίζεται. Ανεβάστε ένα αρχείο %@.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Αυτό το πορτοφόλι δεν βρέθηκε. Επιλέξτε ή προσθέστε ένα πορτοφόλι και δοκιμάστε ξανά.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Αυτό το δίκτυο πορτοφολιού δεν υποστηρίζεται. Επιλέξτε διαφορετικό δίκτυο.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Αυτό το αίτημα επαλήθευσης πορτοφολιού έληξε. Δοκιμάστε ξανά.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Αυτό το αίτημα επαλήθευσης πορτοφολιού δεν είναι έγκυρο. Δοκιμάστε ξανά.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Αυτό το αίτημα επαλήθευσης πορτοφολιού δεν είναι πλέον έγκυρο. Δοκιμάστε ξανά.";
/* Action to select an existing document for upload */
"Upload document" = "Μεταφόρτωση εγγράφου";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Μεταφορτώστε το αποδεικτικό διεύθυνσής σας";
/* Status after a document has uploaded successfully */
"Uploaded" = "Μεταφορτώθηκε";
/* Status while a document is uploading */
"Uploading…" = "Μεταφόρτωση…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Επαληθεύστε τον λογαριασμό σας στο Link προτού συνεχίσετε.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Δεν μπορέσαμε να επαληθεύσουμε την ιδιοκτησία αυτού του πορτοφολιού. Δοκιμάστε ξανά.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Δεν μπορέσαμε να ανοίξουμε αυτό το έγγραφο. Επιλέξτε το ξανά.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Δεν μπορέσαμε να ανεβάσουμε αυτό το αρχείο. Δοκιμάστε ξανά.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Ενδέχεται να ζητήσουμε αποδεικτικό διεύθυνσης για μεγαλύτερες συναλλαγές.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Ενδέχεται να ζητήσουμε την προέλευση των χρημάτων για μεγαλύτερες συναλλαγές.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Απαιτείται να επιβεβαιώσουμε τη διεύθυνσή σας για να ενεργοποιήσουμε δαπάνες άνω των %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Απαιτείται να κατανοήσουμε από πού προέρχονται τα χρήματά σας για να ενεργοποιήσουμε δαπάνες άνω των %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Απαιτείται να επιβεβαιώσουμε τη διεύθυνσή σας για να ενεργοποιήσουμε δαπάνες άνω των %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Απαιτείται να κατανοήσουμε από πού προέρχονται τα χρήματά σας για να ενεργοποιήσουμε δαπάνες άνω των %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Εξετάζουμε τα έγγραφά σας. Θα σας ενημερώσουμε όταν ολοκληρωθεί η επαλήθευση.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Μπορείτε να συνεχίσετε όσο επαληθεύουμε το έγγραφό σας στο παρασκήνιο.";