/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Šai e-pasta adresei jau ir izveidots Link konts. Tā vietā piesakieties.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Pievienojiet %ld dokumentus";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Pievienojiet 1 dokumentu";
/* Action to add documents for another source of funds */
"Add documents" = "Pievienot dokumentus";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Iestatījumos atļaujiet piekļuvi kamerai, lai uzņemtu fotoattēlu.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Automātiski pierakstoties jūsu Link kontā, radās kļūda. Lūdzu, pierakstieties manuāli.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Atbilde";
/* Action to open the system document picker to select a file */
"Choose File…" = "Izvēlēties failu...";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Izvēlēties fotoattēlu…";
/* Button asking the owner to open its support destination */
"Contact support" = "Sazināties ar atbalsta dienestu";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Visticamāk, tiks pieņemtas debetkartes.";
/* Label and picker title for a document's category */
"Document type" = "Dokumenta veids";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokuments veiksmīgi augšupielādēts";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Pirms turpināt pabeidziet sava Link konta verificēšanu.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Finansējuma avots";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Kā jūs finansējat savus darījumus? Lūdzu, norādiet visus savus avotus. Piemēram, alga, ietaupījumi, ieguldījumu peļņa utt.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Nederīgs tālruņa formāts. Lūdzu, izmantojiet E.164 formātu (piemēram, +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Pārliecinieties, ka jūsu dokuments atbilst tālāk norādītajām prasībām.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Neviens maksājuma veids nav gatavs lietošanai. Lūdzu, apkopojiet maksājuma veidu un mēģiniet vēlreiz.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Lūdzu, vēlreiz atlasiet Apple Pay maksājuma veidu, lai turpinātu.";
/* Instruction after an unavailable operation */
"Please try again later." = "Mēģiniet vēlāk vēlreiz.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Trūka nepieciešamās informācijas. Lūdzu, mēģiniet vēlreiz vēlāk.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Iesniegts pārskatīšanai";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Uzņemt fotoattēlu…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Pastāstiet mums par jūsu finanšu līdzekļu avotu";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Radās problēma ar jūsu iepriekšējo dokumentu. Lūdzu, augšupielādējiet jaunu.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Šo lietotni nevarēja verificēt atestācijas kļūdas dēļ. Lūdzu, mēģiniet vēlreiz vēlāk vai sazinieties ar izstrādātāju, ja problēma joprojām pastāv.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Šo lietotni nevarēja verificēt. Lai saņemtu palīdzību, sazinieties ar lietotnes izstrādātāju.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Šis fails ir lielāks par %1$@. Izvēlieties failu, kas ir %2$@ vai mazāks.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Šis faila tips netiek atbalstīts.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Šis faila tips netiek atbalstīts. Augšupielādējiet %@ failu.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Šis maks netika atrasts. Lūdzu, izvēlieties vai pievienojiet maku un mēģiniet vēlreiz.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Šis maka tīkls netiek atbalstīts. Lūdzu, izvēlieties citu tīklu.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Šī maka verifikācijas pieprasījuma derīguma termiņš ir beidzies. Lūdzu, mēģiniet vēlreiz.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Šis maka verifikācijas pieprasījums ir nederīgs. Lūdzu, mēģiniet vēlreiz.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Šis maka verifikācijas pieprasījums vairs nav derīgs. Lūdzu, mēģiniet vēlreiz.";
/* Action to select an existing document for upload */
"Upload document" = "Augšupielādēt dokumentu";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Augšupielādējiet jūsu adresi apliecinošu dokumentu";
/* Status after a document has uploaded successfully */
"Uploaded" = "Augšupielādēts";
/* Status while a document is uploading */
"Uploading…" = "Notiek augšupielāde…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Pirms turpināt verificējiet savu Link kontu.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Mums neizdevās pārbaudīt šī maka īpašumtiesības. Lūdzu, mēģiniet vēlreiz.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Neizdevās atvērt šo dokumentu. Lūdzu, izvēlieties to vēlreiz.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Neizdevās augšupielādēt šo failu. Lūdzu, mēģiniet vēlreiz.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Mēs varam pieprasīt adresi apliecinošu dokumentu lielākiem darījumiem.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Mēs varam pieprasīt finanšu līdzekļu avotu lielākiem darījumiem.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Mums ir jāapstiprina jūsu adrese, lai iespējotu tēriņus virs %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Mums ir jāsaprot, no kurienes tiek saņemts jūsu finansējums, lai iespējotu tēriņus virs %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Mums ir jāapstiprina jūsu adrese, lai iespējotu tēriņus virs %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Mums ir jāsaprot, no kurienes tiek saņemts jūsu finansējums, lai iespējotu tēriņus virs %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Mēs izskatām jūsu dokumentus. Mēs jums paziņosim, kad pārbaude būs pabeigta.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Jūs varat turpināt, kamēr mēs fonā pārbaudām jūsu dokumentu.";