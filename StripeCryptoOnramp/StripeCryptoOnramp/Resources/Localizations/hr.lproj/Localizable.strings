/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Račun Link već postoji za ovu adresu e-pošte. Umjesto toga, prijavite se.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Dodajte %ld dokumenata";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Dodajte jedan dokument";
/* Action to add documents for another source of funds */
"Add documents" = "Dodaj dokumente";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Dopustite pristup kameri u postavkama kako biste snimili fotografiju.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Došlo je do pogreške pri automatskom prijavljivanju u račun Link. Prijavite se ručno.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Odgovor";
/* Action to open the system document picker to select a file */
"Choose File…" = "Odaberite datoteku…";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Odaberite fotografiju…";
/* Button asking the owner to open its support destination */
"Contact support" = "Obratite se podršci";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Debitne će kartice najvjerojatnije biti prihvaćene.";
/* Label and picker title for a document's category */
"Document type" = "Vrsta dokumenta";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokument je uspješno učitan";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Dovršite provjeravanje svog računa Link prije nego što nastavite.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Izvor sredstava";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Kako financirate svoje transakcije? Navedite sve svoje izvore. Na primjer, plaća, ušteđevina, zarada od ulaganja itd.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Nevaljan format telefonskog broja. Upotrijebite format E.164 (npr. +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Provjerite ispunjava li vaš dokument sljedeće zahtjeve.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Nijedan način plaćanja nije spreman za upotrebu. Prikupite način plaćanja i pokušajte ponovno.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Ponovno odaberite svoj način plaćanja Apple Pay kako biste nastavili.";
/* Instruction after an unavailable operation */
"Please try again later." = "Pokušajte ponovno poslije.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Nije bilo potrebnih informacija. Pokušajte ponovno poslije.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Predano na pregled";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Snimite fotografiju…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Recite nam o svojem izvoru sredstava";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Došlo je do problema s vašim prethodnim dokumentom. Učitajte novi.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Ova se aplikacija nije mogla potvrditi zbog pogreške u potvrdi. Pokušajte ponovno poslije ili se obratite razvijatelju ako problem i dalje traje.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Ova aplikacija nije se mogla potvrditi. Obratite se razvijatelju aplikacije za pomoć.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Ova je datoteka veća od %1$@. Odaberite datoteku veličine %2$@ ili manju.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Ova vrsta datoteke nije podržana.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Ova vrsta datoteke nije podržana. Učitajte datoteku %@.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Ovaj novčanik nije bilo moguće pronaći. Odaberite ili dodajte novčanik i pokušajte ponovno.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Ova mreža za novčanik nije podržana. Odaberite drugu mrežu.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Ovaj je zahtjev za provjeru novčanika istekao. Pokušajte ponovno.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Ovaj zahtjev za provjeru novčanika nije valjan. Pokušajte ponovno.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Ovaj zahtjev za provjeru novčanika više nije valjan. Pokušajte ponovno.";
/* Action to select an existing document for upload */
"Upload document" = "Učitajte dokument";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Učitajte svoj dokaz o adresi";
/* Status after a document has uploaded successfully */
"Uploaded" = "Učitano";
/* Status while a document is uploading */
"Uploading…" = "Učitavanje…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Provjerite svoj račun Link prije nego nastavite dalje.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Nismo mogli potvrditi vlasništvo nad ovim novčanikom. Pokušajte ponovno.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Nismo mogli otvoriti ovaj dokument. Ponovno ga odaberite.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Nismo mogli učitati ovu datoteku. Pokušajte ponovno.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Možemo zatražiti dokaz o adresi za veće transakcije.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Možemo zatražiti izvor sredstava za veće transakcije.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Obvezni smo potvrditi vašu adresu kako bismo omogućili potrošnju veću od %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Obvezni smo razumjeti odakle dolaze vaša sredstva kako bismo omogućili potrošnju veću od %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Obvezni smo potvrditi vašu adresu kako bismo omogućili potrošnju veću od %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Obvezni smo razumjeti odakle dolaze vaša sredstva kako bismo omogućili potrošnju veću od %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Pregledavamo vaše dokumente. Obavijestit ćemo vas kada provjera bude dovršena.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Možete nastaviti dok u pozadini provjeravamo vaš dokument.";