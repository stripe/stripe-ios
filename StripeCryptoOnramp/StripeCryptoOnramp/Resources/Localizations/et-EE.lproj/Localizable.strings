/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Selle e-kirja jaoks on juba olemas Linki konto. Logige selle asemel sisse.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Lisa %ld dokumenti";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Lisa 1 dokument";
/* Action to add documents for another source of funds */
"Add documents" = "Lisa dokumendid";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Foto tegemiseks lubage Seadetes juurdepääs kaamerale.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Linki kontole automaatselt sisse logides tekkis viga. Palun logige sisse käsitsi.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Vastus";
/* Action to open the system document picker to select a file */
"Choose File…" = "Vali fail...";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Vali foto…";
/* Button asking the owner to open its support destination */
"Contact support" = "Võta ühendust klienditoega";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Kõige tõenäolisemalt aktsepteeritakse deebetkaarte.";
/* Label and picker title for a document's category */
"Document type" = "Dokumendi tüüp";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokument on edukalt üles laaditud";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Lõpeta oma Linki konto kinnitamine enne jätkamist.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Rahaliste vahendite allikas";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Kuidas te oma tehinguid rahastate? Palun loetlege kõik oma allikad. Näiteks palk, säästud, investeerimistulu jne.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Kehtetu telefoni formaat. Palun kasutage E.164 formaati (nt +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Veenduge, et teie dokument vastab järgmistele nõuetele.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Ükski makseviis pole kasutamiseks valmis. Palun koguge makseviis ja proovige uuesti.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Palun valige jätkamiseks uuesti oma Apple Pay makseviis.";
/* Instruction after an unavailable operation */
"Please try again later." = "Proovige hiljem uuesti.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Vajalik info puudus. Palun proovige hiljem uuesti.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Esitatud ülevaatamiseks";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Tee pilt…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Rääkige meile oma rahaliste vahendite allikast";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Teie eelmise dokumendiga oli probleem. Palun laadige üles uus.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Seda rakendust ei saanud kinnitada atesteerimisvea tõttu. Palun proovige hiljem uuesti või võtke ühendust arendajaga, kui probleem püsib.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Seda rakendust ei saanud kontrollida. Abi saamiseks võtke ühendust rakenduse arendajaga.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "See fail on suurem kui %1$@. Valige fail, mis on %2$@ või väiksem.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Seda failitüüpi ei toetata.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Seda failitüüpi ei toetata. Laadige üles %@ fail.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Seda rahakotti ei leitud. Palun valige või lisage rahakott ja proovige uuesti.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Seda rahakoti võrku ei toetata. Palun valige teine võrk.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "See rahakoti kinnitamise taotlus aegus. Palun proovige uuesti.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "See rahakoti kinnitamise taotlus on kehtetu. Palun proovige uuesti.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "See rahakoti kinnitamise taotlus ei ole enam kehtiv. Palun proovige uuesti.";
/* Action to select an existing document for upload */
"Upload document" = "Laadi dokument üles";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Laadige üles oma aadressitõend";
/* Status after a document has uploaded successfully */
"Uploaded" = "Üles laaditud";
/* Status while a document is uploading */
"Uploading…" = "Üleslaadimine…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Enne jätkamist kinnitage oma Linki konto.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Me ei suutnud selle rahakoti omandiõigust kinnitada. Palun proovige uuesti.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Me ei saanud seda dokumenti avada. Palun valige see uuesti.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Me ei saanud seda faili üles laadida. Palun proovige uuesti.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Suuremate tehingute puhul võime küsida aadressitõendit.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Suuremate tehingute puhul võime küsida rahaliste vahendite päritolu.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Peame kinnitama teie aadressi, et võimaldada kulutusi üle %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Peame mõistma, kust teie rahalised vahendid pärinevad, et võimaldada kulutusi üle %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Peame kinnitama teie aadressi, et võimaldada kulutusi üle %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Peame mõistma, kust teie rahalised vahendid pärinevad, et võimaldada kulutusi üle %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Vaatame teie dokumente üle. Anname teile teada, kui kinnitamine on lõpule viidud.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Saate jätkata, samal ajal kui me teie dokumenti taustal kontrollime.";