/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Akaun Pautan sudah wujud untuk e-mel ini. Log masuk sebaliknya.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Tambah %ld dokumen";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Tambah 1 dokumen";
/* Action to add documents for another source of funds */
"Add documents" = "Tambah dokumen";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Benarkan akses kamera dalam Tetapan untuk mengambil foto.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Ralat berlaku semasa log masuk secara automatik ke akaun Pautan anda. Sila log masuk secara manual.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Jawapan";
/* Action to open the system document picker to select a file */
"Choose File…" = "Pilih fail";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Pilih Foto…";
/* Button asking the owner to open its support destination */
"Contact support" = "Hubungi sokongan";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Kad debit paling berkemungkinan akan diterima.";
/* Label and picker title for a document's category */
"Document type" = "Jenis dokumen";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokumen berjaya dimuat naik";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Selesaikan pengesahan akaun Pautan anda sebelum meneruskan.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Sumber dana";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Bagaimanakah anda membiayai transaksi anda? Sila senaraikan semua sumber anda. Contohnya, gaji, simpanan, perolehan pelaburan, dsb.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Format telefon tidak sah. Sila gunakan format E.164 (cth, +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Pastikan dokumen anda memenuhi keperluan berikut.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Tiada kaedah pembayaran sedia untuk digunakan. Sila kumpulkan kaedah pembayaran dan cuba lagi.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Sila pilih semula kaedah pembayaran Apple Pay anda untuk meneruskan.";
/* Instruction after an unavailable operation */
"Please try again later." = "Sila cuba lagi kemudian.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Maklumat yang diperlukan hilang. Sila cuba lagi kemudian.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Diserahkan untuk semakan";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Ambil Foto…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Beritahu kami tentang sumber dana anda";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Terdapat masalah dengan dokumen anda yang sebelumnya. Sila muat naik dokumen baharu.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Apl ini tidak dapat disahkan kerana ralat pengesahan. Sila cuba lagi kemudian atau hubungi pembangun jika isu berterusan.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Aplikasi ini tidak dapat disahkan. Hubungi pembangun aplikasi untuk mendapatkan bantuan.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Fail ini lebih besar daripada %1$@. Pilih fail bersaiz %2$@ atau lebih kecil.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Jenis fail ini tidak disokong.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Jenis fail ini tidak disokong. Muat naik fail %@.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Dompet ini tidak dapat ditemukan. Sila pilih atau tambahkan dompet dan cuba lagi.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Rangkaian dompet ini tidak disokong. Sila pilih rangkaian yang berbeza.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Permintaan pengesahan dompet ini telah tamat tempoh. Sila cuba lagi.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Permintaan pengesahan dompet ini tidak sah. Sila cuba lagi.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Permintaan pengesahan dompet ini tidak lagi sah. Sila cuba lagi.";
/* Action to select an existing document for upload */
"Upload document" = "Muat naik dokumen";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Muat naik bukti alamat anda";
/* Status after a document has uploaded successfully */
"Uploaded" = "Dimuat naik";
/* Status while a document is uploading */
"Uploading…" = "Memuat naik…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Sahkan akaun Pautan anda sebelum meneruskan.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Kami tidak dapat mengesahkan pemilikan dompet ini. Sila cuba lagi.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Kami tidak dapat membuka dokumen ini. Sila pilih sekali lagi.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Kami tidak dapat memuat naik fail ini. Sila cuba lagi.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Kami mungkin meminta bukti alamat untuk transaksi yang lebih besar.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Kami mungkin meminta sumber dana untuk transaksi yang lebih besar.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Kami dikehendaki mengesahkan alamat anda untuk membolehkan perbelanjaan melebihi %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Kami dikehendaki memahami dari mana datangnya dana anda untuk membolehkan perbelanjaan melebihi %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Kami dikehendaki mengesahkan alamat anda untuk membolehkan perbelanjaan melebihi %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Kami dikehendaki memahami dari mana datangnya dana anda untuk membolehkan perbelanjaan melebihi %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Kami sedang menyemak dokumen anda. Kami akan memaklumkan anda apabila pengesahan selesai.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Anda boleh teruskan sementara kami mengesahkan dokumen anda di latar belakang.";