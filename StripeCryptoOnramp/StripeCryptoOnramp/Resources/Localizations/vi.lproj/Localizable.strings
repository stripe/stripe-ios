"Choose Photo…" = "Chọn Ảnh…";
/* Button asking the owner to open its support destination */
"Contact support" = "Liên hệ với bộ phận hỗ trợ";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Thẻ ghi nợ có khả năng cao được chấp nhận.";
/* Label and picker title for a document's category */
"Document type" = "Loại tài liệu";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Tải tài liệu lên thành công";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Hoàn tất việc xác minh tài khoản Link của bạn trước khi tiếp tục.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Nguồn vốn";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Bạn đang cấp vốn cho các giao dịch của mình như thế nào? Vui lòng liệt kê tất cả các nguồn của bạn. Ví dụ: tiền lương, tiền tiết kiệm, lợi nhuận đầu tư, v.v.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Định dạng điện thoại không hợp lệ. Vui lòng sử dụng định dạng E.164 (ví dụ: +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Đảm bảo tài liệu của bạn đáp ứng các yêu cầu dưới đây.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Không có phương thức thanh toán nào sẵn sàng để sử dụng. Vui lòng thu thập một phương thức thanh toán và thử lại.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Vui lòng chọn lại phương thức thanh toán Apple Pay của bạn để tiếp tục.";
/* Instruction after an unavailable operation */
"Please try again later." = "Vui lòng thử lại sau.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Thông tin bắt buộc bị thiếu. Vui lòng thử lại sau.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Đã gửi để đánh giá";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Chụp ảnh…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Hãy cho chúng tôi biết về nguồn vốn của bạn";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Đã xảy ra sự cố với tài liệu trước đó của bạn. Vui lòng tải lên tài liệu mới.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Ứng dụng này không thể được xác minh do lỗi chứng thực. Vui lòng thử lại sau hoặc liên hệ với nhà phát triển nếu sự cố vẫn tiếp diễn.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Ứng dụng này không thể được xác minh. Hãy liên hệ với nhà phát triển ứng dụng để được trợ giúp.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Tệp này lớn hơn %1$@. Chọn tệp có kích thước %2$@ hoặc nhỏ hơn.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Loại tệp này không được hỗ trợ.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Loại tệp này không được hỗ trợ. Vui lòng tải lên tệp %@.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Không thể tìm thấy ví này. Vui lòng chọn hoặc thêm ví và thử lại.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Mạng ví này không được hỗ trợ. Vui lòng chọn một mạng khác.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Yêu cầu xác minh ví này đã hết hạn. Vui lòng thử lại.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Yêu cầu xác minh ví này không hợp lệ. Vui lòng thử lại.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Yêu cầu xác minh ví này không còn hợp lệ. Vui lòng thử lại.";
/* Action to select an existing document for upload */
"Upload document" = "Tải tài liệu lên";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Tải lên bằng chứng địa chỉ của bạn";
/* Status after a document has uploaded successfully */
"Uploaded" = "Đã tải lên";
/* Status while a document is uploading */
"Uploading…" = "Đang tải lên…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Xác minh tài khoản Link của bạn trước khi tiếp tục.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Chúng tôi không thể xác minh quyền sở hữu ví này. Vui lòng thử lại.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Chúng tôi không thể mở tài liệu này. Vui lòng chọn lại.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Chúng tôi không thể tải lên tệp này. Vui lòng thử lại.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Chúng tôi có thể yêu cầu bằng chứng địa chỉ cho các giao dịch lớn hơn.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Chúng tôi có thể yêu cầu nguồn vốn cho các giao dịch lớn hơn.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Chúng tôi bắt buộc phải xác nhận địa chỉ của bạn để cho phép chi tiêu trên %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Chúng tôi bắt buộc phải biết vốn của bạn đến từ đâu để cho phép chi tiêu trên %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Chúng tôi bắt buộc phải xác nhận địa chỉ của bạn để cho phép chi tiêu trên %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Chúng tôi bắt buộc phải biết vốn của bạn đến từ đâu để cho phép chi tiêu trên %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Chúng tôi đang xem xét các tài liệu của bạn. Chúng tôi sẽ thông báo cho bạn khi quá trình xác minh hoàn tất.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Bạn có thể tiếp tục trong khi chúng tôi xác minh tài liệu của bạn trong nền.";