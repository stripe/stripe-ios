/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Dla tego adresu e-mail już istnieje konto Link. Zamiast tego zaloguj się.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Dodaj dokumenty (%ld)";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Dodaj 1 dokument";
/* Action to add documents for another source of funds */
"Add documents" = "Dodaj dokumenty";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Zezwól na dostęp do aparatu w Ustawieniach, aby zrobić zdjęcie.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Podczas automatycznego logowania do konta Link wystąpił błąd. Zaloguj się ręcznie.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Odpowiedz";
/* Action to open the system document picker to select a file */
"Choose File…" = "Wybierz plik";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Wybierz zdjęcie…";
/* Button asking the owner to open its support destination */
"Contact support" = "Skontaktuj się z pomocą techniczną";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Karty debetowe są najczęściej akceptowane.";
/* Label and picker title for a document's category */
"Document type" = "Typ dokumentu";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokument przesłano pomyślnie";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Przed kontynuowaniem zakończ weryfikację konta Link.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Źródło środków";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "W jaki sposób finansujesz transakcje? Wymień wszystkie źródła. Na przykład wynagrodzenie, oszczędności, zysk z inwestycji itp.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Nieprawidłowy format telefonu. Użyj formatu E.164 (np. +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Upewnij się, że Twój dokument spełnia następujące wymagania.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Żadna z metod płatności nie jest gotowa do użycia. Uzyskaj metodę płatności i spróbuj ponownie.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Wybierz ponownie swoją metodę płatności Apple Pay, aby kontynuować.";
/* Instruction after an unavailable operation */
"Please try again later." = "Spróbuj później.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Brakujące wymagane dane. Spróbuj ponownie później.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Przesłano do sprawdzenia";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Zrób zdjęcie…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Podaj źródło pochodzenia środków";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Wystąpił problem z Twoim poprzednim dokumentem. Prześlij nowy.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Ta aplikacja nie mogła zostać zweryfikowana ze względu na błąd potwierdzenia. Spróbuj ponownie później lub skontaktuj się z deweloperem, jeśli problem będzie się powtarzał.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Nie można było zweryfikować tej aplikacji. Skontaktuj się z deweloperem aplikacji w celu uzyskania pomocy.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Ten plik jest większy niż %1$@. Wybierz plik o rozmiarze %2$@ lub mniejszy.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Ten typ pliku nie jest obsługiwany.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Ten typ pliku nie jest obsługiwany. Prześlij plik w formacie %@.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Nie udało się znaleźć tego portfela. Wybierz lub dodaj portfel i spróbuj ponownie.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Ta sieć portfela nie jest obsługiwana. Wybierz inną sieć.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "To żądanie weryfikacji portfela wygasło. Spróbuj ponownie.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "To żądanie weryfikacji portfela jest nieprawidłowe. Spróbuj ponownie.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "To żądanie weryfikacji portfela nie jest już ważne. Spróbuj ponownie.";
/* Action to select an existing document for upload */
"Upload document" = "Prześlij dokument";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Prześlij potwierdzenie adresu";
/* Status after a document has uploaded successfully */
"Uploaded" = "Przesłano";
/* Status while a document is uploading */
"Uploading…" = "Przesyłanie…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Przed kontynuowaniem zweryfikuj konto Link.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Nie udało nam się zweryfikować własności tego portfela. Spróbuj ponownie.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Nie udało nam się otworzyć tego dokumentu. Wybierz go ponownie.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Nie udało nam się przesłać tego pliku. Spróbuj ponownie.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Możemy poprosić o dowód adresu w przypadku większych transakcji.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Możemy poprosić o wskazanie źródła środków w przypadku większych transakcji.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Musimy potwierdzić Twój adres, aby umożliwić wydatki powyżej %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Musimy zrozumieć, skąd pochodzą Twoje środki, aby umożliwić wydatki powyżej %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Musimy potwierdzić Twój adres, aby umożliwić wydatki powyżej %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Musimy zrozumieć, skąd pochodzą Twoje środki, aby umożliwić wydatki powyżej %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Sprawdzamy Twoje dokumenty. Poinformujemy cię, gdy weryfikacja zostanie zakończona.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Możesz kontynuować podczas weryfikowania Twojego dokumentu w tle.";