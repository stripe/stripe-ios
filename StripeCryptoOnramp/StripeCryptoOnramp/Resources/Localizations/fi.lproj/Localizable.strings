/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Tälle sähköpostiosoitteelle on jo olemassa Link-tili. Kirjaudu sisään.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Lisää %ld asiakirjaa";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Lisää yksi asiakirja";
/* Action to add documents for another source of funds */
"Add documents" = "Lisää asiakirjoja";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Salli kameran käyttö Asetuksissa, jotta voit ottaa kuvan.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Link-tilisi automaattisen kirjautumisen aikana tapahtui virhe. Kirjaudu sisään manuaalisesti.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Vastaus";
/* Action to open the system document picker to select a file */
"Choose File…" = "Valitse tiedosto";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Valitse valokuva…";
/* Button asking the owner to open its support destination */
"Contact support" = "Ota yhteyttä tukeen";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Pankkikortit hyväksytään todennäköisesti.";
/* Label and picker title for a document's category */
"Document type" = "Asiakirjan tyyppi";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Asiakirjan lataus onnistui";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Viimeistele Link-tilisi vahvistus ennen kuin jatkat.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Varojen lähde";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Miten rahoitat tapahtumasi? Luettele kaikki lähteesi. Esimerkiksi palkka, säästöt, sijoitustuotot jne.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Virheellinen puhelinnumero. Käytä E.164-muotoa (esim. +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Varmista, että asiakirjasi täyttää seuraavat vaatimukset.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Mikään maksutapa ei ole valmis käyttöön. Hanki maksutapa ja yritä uudelleen.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Valitse Apple Pay -maksutapasi uudelleen jatkaaksesi.";
/* Instruction after an unavailable operation */
"Please try again later." = "Yritä myöhemmin uudelleen.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Pakollisia tietoja puuttui. Yritä myöhemmin uudelleen.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Lähetetty tarkasteltavaksi";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Ota kuva…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Kerro meille varojesi lähteestä";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Edellisessä asiakirjassasi oli ongelma. Lataa uusi.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Tätä sovellusta ei voitu vahvistaa todistusvirheen vuoksi. Yritä myöhemmin uudelleen tai ota yhteys ohjelmoijaan, jos ongelma jatkuu.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Tätä sovellusta ei voitu todentaa. Saat apua ottamalla yhteyttä sovelluksen kehittäjään.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Tämä tiedosto on suurempi kuin %1$@. Valitse tiedosto, joka on %2$@ tai pienempi.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Tätä tiedostotyyppiä ei tueta.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Tätä tiedostotyyppiä ei tueta. Lataa %@-tiedosto.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Tätä lompakkoa ei löytynyt. Valitse tai lisää lompakko ja yritä uudelleen.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Tätä lompakon verkkoa ei tueta. Valitse toinen verkko.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Tämä lompakon vahvistuspyyntö vanhentui. Yritä uudelleen.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Tämä lompakon vahvistuspyyntö on virheellinen. Yritä uudelleen.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Tämä lompakon vahvistuspyyntö ei ole enää voimassa. Yritä uudelleen.";
/* Action to select an existing document for upload */
"Upload document" = "Lataa asiakirja";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Lataa osoitetodistuksesi";
/* Status after a document has uploaded successfully */
"Uploaded" = "Ladattu";
/* Status while a document is uploading */
"Uploading…" = "Ladataan…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Vahvista Link-tilisi ennen kuin jatkat.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Emme voineet vahvistaa tämän lompakon omistajuutta. Yritä uudelleen.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Tätä asiakirjaa ei voitu avata. Valitse se uudelleen.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Tätä tiedostoa ei voitu ladata. Yritä uudelleen.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Saatamme pyytää osoitetodistuksen suuremmissa tapahtumissa.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Saatamme pyytää selvityksen varojen alkuperästä suuremmissa tapahtumissa.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Meidän on vahvistettava osoitteesi, jotta voit käyttää yli %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Meidän on ymmärrettävä, mistä varasi ovat peräisin, jotta voit käyttää yli %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Meidän on vahvistettava osoitteesi, jotta voit käyttää yli %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Meidän on ymmärrettävä, mistä varasi ovat peräisin, jotta voit käyttää yli %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Tarkistamme asiakirjojasi. Ilmoitamme, kun vahvistus on valmis.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Voit jatkaa sillä aikaa, kun vahvistamme asiakirjasi taustalla.";