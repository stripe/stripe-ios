/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Pro tento e-mail již existuje účet Link. Místo toho se přihlaste.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Přidat %ld dokument/y/ů";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Přidat 1 dokument";
/* Action to add documents for another source of funds */
"Add documents" = "Přidat dokumenty";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Povolte v Nastavení přístup k fotoaparátu, abyste mohli pořídit fotografii.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Při automatickém přihlašování k účtu Link došlo k chybě. Přihlaste se prosím manuálně.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Odpověď";
/* Action to open the system document picker to select a file */
"Choose File…" = "Vybrat soubor…";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Vybrat fotografii…";
/* Button asking the owner to open its support destination */
"Contact support" = "Kontaktovat podporu";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Debetní karty budou s největší pravděpodobností akceptovány.";
/* Label and picker title for a document's category */
"Document type" = "Typ dokumentu";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokument byl úspěšně nahrán";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Před pokračováním dokončete ověření účtu Link.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Zdroj financí";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Jak financujete své transakce? Uveďte prosím všechny své zdroje. Například plat, úspory, výdělky z investic atd.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Neplatný formát telefonu. Použijte prosím formát E.164 (např. +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Ujistěte se, že váš dokument splňuje následující požadavky.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Žádný způsob platby není připraven k použití. Zvolte způsob platby a zkuste to znovu.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Chcete-li pokračovat, vyberte prosím znovu způsob platby Apple Pay.";
/* Instruction after an unavailable operation */
"Please try again later." = "Zkuste to prosím znovu později.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Chyběly požadované informace. Zkuste to prosím později.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Odesláno ke kontrole";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Pořídit fotografii…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Sdělte nám informace o svém zdroji financí";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Vyskytl se problém s vaším předchozím dokumentem. Nahrajte prosím nový.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Tuto aplikaci nebylo možné ověřit z důvodu chyby atestace. Pokud problém potrvá, zkuste to prosím později nebo kontaktujte vývojáře.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Tuto aplikaci nebylo možné ověřit. Požádejte o pomoc vývojáře aplikace.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Tento soubor je větší než %1$@. Vyberte soubor o velikosti %2$@ nebo menší.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Tento typ souboru není podporován.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Tento typ souboru není podporován. Nahrajte soubor typu %@.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Tuto peněženku s Bitcoiny se nepodařilo najít. Vyberte nebo přidejte peněženku s Bitcoiny a zkuste to znovu.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Tato síť peněženky s Bitcoiny není podporována. Vyberte jinou síť.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Tato žádost o ověření peněženky s Bitcoiny vypršela. Zkuste to znovu.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Tato žádost o ověření peněženky s Bitcoiny je neplatná. Zkuste to prosím znovu.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Tato žádost o ověření peněženky s Bitcoiny již není platná. Zkuste to znovu.";
/* Action to select an existing document for upload */
"Upload document" = "Nahrát dokument";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Nahrajte svůj doklad o adrese";
/* Status after a document has uploaded successfully */
"Uploaded" = "Nahráno";
/* Status while a document is uploading */
"Uploading…" = "Nahrávání…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Před pokračováním ověřte svůj účet Link.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Nepodařilo se nám ověřit vlastnictví této peněženky s Bitcoiny. Zkuste to znovu.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Tento dokument se nepodařilo otevřít. Vyberte jej prosím znovu.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Tento soubor se nepodařilo nahrát. Zkuste to prosím znovu.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "U větších transakcí si můžeme vyžádat doklad o adrese.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "U větších transakcí si můžeme vyžádat zdroj financí.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Jsme povinni potvrdit vaši adresu, abychom umožnili výdaj překračující %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Jsme povinni porozumět tomu, odkud pocházejí vaše finance, abychom umožnili výdaj překračující %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Jsme povinni potvrdit vaši adresu, abychom umožnili výdaj překračující %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Jsme povinni porozumět tomu, odkud pocházejí vaše finance, abychom umožnili výdaj překračující %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Kontrolujeme vaše dokumenty. Jakmile bude ověření dokončeno, dáme vám vědět.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Můžete pokračovat, zatímco na pozadí ověřujeme váš dokument.";