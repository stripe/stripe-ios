/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Für diese E-Mail-Adresse existiert bereits ein Link-Konto. Melden Sie sich stattdessen an.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "%ld Dokumente hinzufügen";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "1 Dokument hinzufügen";
/* Action to add documents for another source of funds */
"Add documents" = "Dokumente hinzufügen";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Um ein Foto aufzunehmen, müssen Sie den Kamerazugriff in den Einstellungen erlauben.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Bei der automatischen Anmeldung in Ihrem Link-Konto ist ein Fehler aufgetreten. Bitte melden Sie sich manuell an.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Antwort";
/* Action to open the system document picker to select a file */
"Choose File…" = "Datei wählen ...";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Foto auswählen ...";
/* Button asking the owner to open its support destination */
"Contact support" = "Support kontaktieren";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Debitkarten werden am ehesten akzeptiert.";
/* Label and picker title for a document's category */
"Document type" = "Dokumenttyp";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokument erfolgreich hochgeladen";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Schließen Sie die Verifizierung Ihres Link-Kontos ab, bevor Sie fortfahren.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Finanzierungsquellen";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Wie finanzieren Sie Ihre Transaktionen? Bitte führen Sie alle Ihre Finanzierungsquellen auf. Zum Beispiel Gehalt, Ersparnisse, Erträge aus Kapitalanlagen usw.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Ungültiges Telefonformat. Bitte verwenden Sie das Format E.164 (z. B. +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Achten Sie darauf, dass Ihr Dokument die folgenden Anforderungen erfüllt.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Es ist keine Zahlungsmethode einsatzbereit. Bitte erfassen Sie eine Zahlungsmethode und versuchen Sie es erneut.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Bitte wählen Sie Ihre Apple Pay-Zahlungsmethode erneut aus, um fortzufahren.";
/* Instruction after an unavailable operation */
"Please try again later." = "Versuchen Sie es später noch einmal.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Leider haben erforderliche Informationen gefehlt. Bitte versuchen Sie es später noch einmal.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Zur Überprüfung eingereicht";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Aufnahme machen ...";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Erzählen Sie uns von der Herkunft Ihrer Geldmittel";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Bei Ihrem vorherigen Dokument ist ein Problem aufgetreten. Bitte laden Sie ein neues Dokument hoch.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Diese App konnte aufgrund eines Bestätigungsfehlers nicht verifiziert werden. Bitte versuchen Sie es später noch einmal oder kontaktieren Sie den/die Entwickler/in, wenn das Problem weiterhin besteht.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Diese App konnte nicht verifiziert werden. Wenden Sie sich bitte an die App-Entwickler/innen, um Hilfe zu erhalten.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Diese Datei ist größer als %1$@. Wählen Sie eine Datei aus, die höchstens %2$@ groß ist.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Dieser Dateityp wird nicht unterstützt.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Dieser Dateityp wird nicht unterstützt. Laden Sie eine %@-Datei hoch.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Dieses Wallet konnte nicht gefunden werden. Bitte wählen Sie ein Wallet aus oder fügen Sie eines hinzu und versuchen Sie es erneut.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Dieses Wallet-Netzwerk wird nicht unterstützt. Bitte wählen Sie ein anderes Netzwerk aus.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Die Anfrage zur Verifizierung dieses Wallets ist abgelaufen. Bitte versuchen Sie es erneut.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Diese Anfrage zur Wallet-Verifizierung ist ungültig. Bitte versuchen Sie es erneut.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Die Anfrage zur Verifizierung dieses Wallets ist nicht mehr gültig. Bitte versuchen Sie es erneut.";
/* Action to select an existing document for upload */
"Upload document" = "Dokument hochladen";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Laden Sie Ihren Adressnachweis hoch";
/* Status after a document has uploaded successfully */
"Uploaded" = "Hochgeladen";
/* Status while a document is uploading */
"Uploading…" = "Wird hochgeladen …";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Verifizieren Sie Ihr Link-Konto, bevor Sie fortfahren.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Wir konnten die Inhaberschaft dieses Wallets nicht verifizieren. Bitte versuchen Sie es erneut.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Wir konnten dieses Dokument nicht öffnen. Bitte wählen Sie das Dokument erneut aus.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Wir konnten diese Datei nicht hochladen. Bitte versuchen Sie es erneut.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Für größere Transaktionen fordern wir möglicherweise einen Adressnachweis an.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Für größere Transaktionen fordern wir möglicherweise einen Nachweis über die Herkunft der Mittel an.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Wir müssen Ihre Adresse prüfen, um Ausgaben über %@ zu ermöglichen.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Wir müssen nachvollziehen, woher Ihre Gelder stammen, um Ausgaben über %@ zu ermöglichen.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Wir müssen Ihre Adresse prüfen, um Ausgaben über %@ zu ermöglichen.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Wir müssen nachvollziehen, woher Ihre Gelder stammen, um Ausgaben über %@ zu ermöglichen.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Wir prüfen Ihre Dokumente. Wir geben Ihnen Bescheid, sobald die Verifizierung abgeschlossen ist.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Sie können fortfahren, während wir Ihr Dokument im Hintergrund überprüfen.";