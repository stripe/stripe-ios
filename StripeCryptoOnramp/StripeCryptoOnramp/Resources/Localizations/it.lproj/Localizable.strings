/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Esiste già un account Link per questa email. Accedi.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Aggiungi %ld documenti";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Aggiungi 1 documento";
/* Action to add documents for another source of funds */
"Add documents" = "Aggiungi documenti";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Per scattare una foto, consenti l'accesso alla fotocamera nelle Impostazioni.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Si è verificato un errore durante l'accesso automatico al tuo account Link. Accedi manualmente.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Rispondi";
/* Action to open the system document picker to select a file */
"Choose File…" = "Scegli file";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Scegli foto";
/* Button asking the owner to open its support destination */
"Contact support" = "Contatta l'assistenza";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "È molto probabile che vengano accettate le carte di debito.";
/* Label and picker title for a document's category */
"Document type" = "Tipo di documento";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Documento caricato correttamente";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Completa la verifica del tuo account Link prima di continuare.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Origine dei fondi";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Come finanzi le tue transazioni? Elenca tutte le tue fonti. Ad esempio, stipendio, risparmi, utili sugli investimenti, ecc.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Formato del telefono non valido. Utilizza il formato E.164 (ad esempio, +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Assicurati che il tuo documento soddisfi i seguenti requisiti.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Non è stato selezionato alcun metodo di pagamento. Seleziona un metodo di pagamento e riprova.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Seleziona di nuovo il tuo metodo di pagamento Apple Pay per continuare.";
/* Instruction after an unavailable operation */
"Please try again later." = "Riprova più tardi.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Informazioni richieste mancanti. Riprova più tardi.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Inviata per la revisione";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Scatta foto...";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Parlaci dell'origine dei tuoi fondi";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Si è verificato un problema con il tuo documento precedente. Caricane uno nuovo.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Non è stato possibile verificare questa app a causa di un errore di attestazione. Riprova più tardi oppure contatta lo sviluppatore se il problema persiste.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Non è stato possibile verificare questa app. Contatta lo sviluppatore dell'app per ricevere assistenza.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Questo file è più grande di %1$@. Scegli un file di dimensioni pari o inferiori a %2$@.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Questo tipo di file non è supportato.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Questo tipo di file non è supportato. Carica un file %@.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Impossibile trovare questo wallet. Scegli o aggiungi un wallet e riprova.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Questa rete di wallet non è supportata. Scegli una rete diversa.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Questa richiesta di verifica del wallet è scaduta. Riprova.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Questa richiesta di verifica del wallet non è valida. Riprova.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Questa richiesta di verifica del wallet non è più valida. Riprova.";
/* Action to select an existing document for upload */
"Upload document" = "Carica documento";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Carica la tua prova di indirizzo";
/* Status after a document has uploaded successfully */
"Uploaded" = "Caricati";
/* Status while a document is uploading */
"Uploading…" = "Caricamento in corso...";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Verifica il tuo account Link prima di continuare.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Impossibile verificare la titolarità di questo wallet. Riprova.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Non siamo riusciti ad aprire questo documento. Selezionalo di nuovo.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Non siamo riusciti a caricare questo file. Riprova.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Potremmo richiedere una prova dell'indirizzo per le transazioni di importo più elevato.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Potremmo richiedere la provenienza dei fondi per le transazioni di importo più elevato.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Siamo tenuti a confermare il tuo indirizzo per consentire spese superiori a %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Siamo tenuti a comprendere la provenienza dei tuoi fondi per consentire spese superiori a %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Siamo tenuti a confermare il tuo indirizzo per consentire spese superiori a %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Siamo tenuti a comprendere la provenienza dei tuoi fondi per consentire spese superiori a %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Stiamo esaminando i tuoi documenti. Ti informeremo quando la verifica sarà completata.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Puoi continuare mentre verifichiamo il tuo documento in background.";