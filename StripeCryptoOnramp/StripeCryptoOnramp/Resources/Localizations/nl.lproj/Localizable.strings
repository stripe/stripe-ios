/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Er bestaat al een Link-account voor dit e-mailadres. Meld je aan.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Voeg %ld documenten toe";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Voeg 1 document toe";
/* Action to add documents for another source of funds */
"Add documents" = "Voeg documenten toe";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Sta cameratoegang toe in Instellingen om een foto te maken.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Er is iets misgegaan bij het automatisch aanmelden bij je Link-account. Meld je handmatig aan.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Antwoord";
/* Action to open the system document picker to select a file */
"Choose File…" = "Bestand kiezen...";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Foto selecteren";
/* Button asking the owner to open its support destination */
"Contact support" = "Neem contact op met support";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Debitcards worden meestal geaccepteerd.";
/* Label and picker title for a document's category */
"Document type" = "Documenttype";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Document succesvol geüpload";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Voltooi de verificatie van je Link-account voordat je doorgaat.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Geldbron";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Hoe financier je je transacties? Vermeld al je bronnen, bijvoorbeeld salaris, spaargeld en beleggingsresultaten.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Ongeldige telefoonindeling. Gebruik de E.164-indeling (bijvoorbeeld +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Zorg dat je document aan de volgende vereisten voldoet.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Er is geen betaling klaar voor gebruik. Verzamel een betaalmethode en probeer het opnieuw.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Selecteer je Apple Pay-betaalmethode opnieuw om door te gaan.";
/* Instruction after an unavailable operation */
"Please try again later." = "Probeer het later nog eens.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Vereiste informatie ontbreekt. Probeer het later opnieuw.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Ingediend ter controle";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Maak foto...";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Vertel ons over de herkomst van je geld";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Er is een probleem opgetreden met je vorige document. Upload een nieuw document.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Deze app kan niet worden geverifieerd vanwege een attestatiefout. Probeer het later opnieuw of neem contact op met de developer als het probleem zich blijft voordoen.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Deze app kan niet worden geverifieerd. Neem voor hulp contact op met de developer.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Dit bestand is groter dan %1$@. Kies een bestand dat %2$@ of kleiner is.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Dit bestandstype wordt niet ondersteund.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Dit bestandstype wordt niet ondersteund. Upload een %@-bestand.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Deze wallet kon niet worden gevonden. Kies of voeg een wallet toe en probeer het nog eens.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Dit wallet-netwerk wordt niet ondersteund. Kies een ander netwerk.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Deze aanvraag voor wallet-verificatie is verlopen. Probeer het nog eens.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Deze aanvraag voor walletverificatie is ongeldig. Probeer het opnieuw.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Deze aanvraag voor wallet-verificatie is niet meer geldig. Probeer het nog eens.";
/* Action to select an existing document for upload */
"Upload document" = "Document uploaden";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Upload je bewijs van adres";
/* Status after a document has uploaded successfully */
"Uploaded" = "Geüpload";
/* Status while a document is uploading */
"Uploading…" = "Uploaden…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Verifieer je Link-account voordat je doorgaat.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "We konden het eigendom van deze wallet niet verifiëren. Probeer het nog eens.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "We hebben dit document niet kunnen openen. Kies het opnieuw.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "We hebben dit bestand niet kunnen uploaden. Probeer het opnieuw.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "We kunnen voor grotere transacties om een adresbewijs vragen.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "We kunnen voor grotere transacties om de herkomst van het geld vragen.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "We zijn verplicht om je adres te bevestigen om uitgaven van meer dan %@ mogelijk te maken.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "We zijn verplicht om te begrijpen waar je geld vandaan komt om uitgaven van meer dan %@ mogelijk te maken.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "We zijn verplicht om je adres te bevestigen om uitgaven van meer dan %@ mogelijk te maken.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "We zijn verplicht om te begrijpen waar je geld vandaan komt om uitgaven van meer dan %@ mogelijk te maken.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "We beoordelen je documenten. We laten het je weten wanneer de verificatie is voltooid.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Je kunt doorgaan terwijl we je document op de achtergrond verifiëren.";