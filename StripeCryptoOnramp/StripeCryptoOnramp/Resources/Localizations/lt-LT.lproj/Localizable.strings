/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Šiam el. pašto adresui jau yra sukurta „Link“ paskyra. Prisijunkite.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Pridėti %ld dokumentų";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Pridėti 1 dokumentą";
/* Action to add documents for another source of funds */
"Add documents" = "Pridėti dokumentus";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Nuostatuose suteikite prieigą prie kameros, kad užfiksuotumėte nuotrauką.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Bandant automatiškai prisijungti prie jūsų „Link“ paskyros, įvyko klaida. Prisijunkite rankiniu būdu.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Atsakymas";
/* Action to open the system document picker to select a file */
"Choose File…" = "Pasirinkite failą";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Pasirinkite nuotrauką…";
/* Button asking the owner to open its support destination */
"Contact support" = "Susisiekite su palaikymo tarnyba";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Dažniausiai priimamos debeto kortelės.";
/* Label and picker title for a document's category */
"Document type" = "Dokumento tipas";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokumentas sėkmingai įkeltas";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Prieš tęsdami užbaikite „Link“ paskyros patvirtinimą.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Lėšų šaltinis";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Iš kokių lėšų finansuojate savo operacijas? Nurodykite visus savo šaltinius. Pavyzdžiui, atlyginimas, santaupos, investicijų pelnas ir t. t.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Neleistinas telefono formatas. Naudokite E.164 formatą (pvz., +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Įsitikinkite, kad jūsų dokumentas atitinka šiuos reikalavimus.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Nėra pasirinkto mokėjimo būdo. Pasirinkite mokėjimo būdą ir pabandykite dar kartą.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Norėdami tęsti, dar kartą pasirinkite savo „Apple Pay” mokėjimo būdą.";
/* Instruction after an unavailable operation */
"Please try again later." = "Bandykite dar kartą vėliau.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Trūksta reikiamos informacijos. Bandykite dar kartą vėliau.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Pateikta peržiūrai";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Fotografuoti…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Papasakokite apie savo lėšų šaltinį";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Kilo su jūsų ankstesniu dokumentu susijusi klaida. Įkelkite naują.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Šios programėlės nebuvo galima patvirtinti dėl patvirtinimo klaidos. Prašome pabandyti vėliau arba susisiekti su kūrėju, jei problema neišsprendžiama.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Šios programos patvirtinti nepavyko. Kreipkitės pagalbos į programos kūrėją.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Šis failas didesnis nei %1$@. Pasirinkite failą, kuris yra %2$@ ar mažesnis.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Šis failo tipas nepalaikomas.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Šis failo tipas nepalaikomas. Įkelkite %@ failą.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Piniginės rasti nepavyko. Pasirinkite arba pridėkite piniginę ir bandykite dar kartą.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Piniginės tinklas nepalaikomas. Pasirinkite kitą tinklą.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Piniginės patvirtinimo užklausos galiojimas baigėsi. Bandykite dar kartą.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Piniginės patvirtinimo užklausa netinkama. Bandykite dar kartą.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Piniginės patvirtinimo užklausa nebegalioja. Bandykite dar kartą.";
/* Action to select an existing document for upload */
"Upload document" = "Įkelti dokumentą";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Įkelkite adresą patvirtinančius dokumentus";
/* Status after a document has uploaded successfully */
"Uploaded" = "Įkelta";
/* Status while a document is uploading */
"Uploading…" = "Įkeliama…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Prieš tęsdami, patvirtinkite savo „Link“ paskyrą.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Piniginės nuosavybės patvirtinti nepavyko. Bandykite dar kartą.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Nepavyko atidaryti šio dokumento. Pasirinkite jį dar kartą.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Nepavyko įkelti šio failo. Bandykite dar kartą.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Atliekant didesnės vertės operacijas, galime paprašyti pateikti adreso įrodymą.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Atliekant didesnės vertės operacijas, galime paprašyti pateikti lėšų kilmę patvirtinantį dokumentą.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Privalome patvirtinti jūsų adresą, kad galėtumėte išleisti daugiau nei %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Privalome suprasti, iš kur gaunamos jūsų lėšos, kad galėtumėte išleisti daugiau nei %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Privalome patvirtinti jūsų adresą, kad galėtumėte išleisti daugiau nei %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Privalome suprasti, iš kur gaunamos jūsų lėšos, kad galėtumėte išleisti daugiau nei %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Peržiūrime jūsų dokumentus. Pranešime jums, kai patikrinimas bus baigtas.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Galite tęsti, kol mes fone tikriname jūsų dokumentą.";