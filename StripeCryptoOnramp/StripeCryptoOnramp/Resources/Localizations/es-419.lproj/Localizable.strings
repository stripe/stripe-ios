/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Ya existe una cuenta de Link asociada a este correo electrónico. Inicia sesión en su lugar.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Agregar %ld documentos";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Agregar 1 documento";
/* Action to add documents for another source of funds */
"Add documents" = "Agregar documentos";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Habilita el acceso a la cámara en Configuración para tomar una foto.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Se produjo un error al iniciar sesión automáticamente en tu cuenta de Link. Inicia sesión manualmente.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Respuesta";
/* Action to open the system document picker to select a file */
"Choose File…" = "Elegir archivo...";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Elegir foto...";
/* Button asking the owner to open its support destination */
"Contact support" = "Comunícate con el equipo de soporte";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Lo más probable es que se acepten tarjetas de débito.";
/* Label and picker title for a document's category */
"Document type" = "Tipo de documento";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "El documento se cargó correctamente";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Termina de verificar tu cuenta de Link antes de continuar.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Origen de los fondos";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "¿Cómo financias tus transacciones? Enumera todas tus fuentes. Por ejemplo, salario, ahorros, ganancias de inversiones, etc.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Formato de teléfono no válido. Usa el formato E.164 (p. ej., +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Asegúrate de que tu documento cumpla los siguientes requisitos.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "No hay ningún método de pago listo para usar. Recopila un método de pago e inténtalo de nuevo.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Vuelve a seleccionar tu método de pago de Apple Pay para continuar.";
/* Instruction after an unavailable operation */
"Please try again later." = "Vuelve a intentarlo más tarde.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Faltaba información requerida. Inténtalo nuevamente más tarde.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Enviado para revisión";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Tomar una foto…";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Cuéntanos sobre el origen de tus fondos";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Hubo un problema con tu documento anterior. Carga uno nuevo.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "No se pudo verificar esta aplicación debido a un error de certificación. Inténtalo nuevamente más tarde o comunícate con el desarrollador si el problema persiste.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "No se pudo verificar esta aplicación. Ponte en contacto con el desarrollador para obtener ayuda.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Este archivo supera los %1$@. Elige un archivo de %2$@ o más pequeño.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Este tipo de archivo no es compatible.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Este tipo de archivo no es compatible. Carga un archivo %@.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "No se pudo encontrar esta cartera. Elige o agrega una cartera y vuelve a intentarlo.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "La red de esta cartera no es compatible. Elige una red diferente.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Esta solicitud de verificación de cartera caducó. Vuelve a intentarlo.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Esta solicitud de verificación de cartera no es válida. Vuelve a intentarlo.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Esta solicitud de verificación de cartera ya no es válida. Vuelve a intentarlo.";
/* Action to select an existing document for upload */
"Upload document" = "Cargar documento";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Carga tu comprobante de domicilio";
/* Status after a document has uploaded successfully */
"Uploaded" = "Cargada";
/* Status while a document is uploading */
"Uploading…" = "Cargando…";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Verifica tu cuenta de Link antes de continuar.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "No pudimos verificar la propiedad de esta cartera. Vuelve a intentarlo.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "No pudimos abrir este documento. Vuelve a elegirlo.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "No pudimos cargar este archivo. Vuelve a intentarlo.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Es posible que solicitemos una constancia de domicilio para transacciones más grandes.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Es posible que solicitemos el origen de los fondos para transacciones más grandes.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Debemos confirmar tu dirección para habilitar gastos superiores a %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Debemos entender de dónde provienen tus fondos para habilitar gastos superiores a %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Debemos confirmar tu dirección para habilitar gastos superiores a %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Debemos entender de dónde provienen tus fondos para habilitar gastos superiores a %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Estamos revisando tus documentos. Te avisaremos cuando se complete la verificación.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Puedes continuar mientras verificamos tu documento en segundo plano.";