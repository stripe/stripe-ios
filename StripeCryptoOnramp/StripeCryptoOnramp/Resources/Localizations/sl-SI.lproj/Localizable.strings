/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Račun Link za ta e-poštni naslov že obstaja. Namesto tega se prijavite.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Dodajte %ld dokumentov";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Dodajte 1 dokument";
/* Action to add documents for another source of funds */
"Add documents" = "Dodajte dokumente";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "V nastavitvah dovolite dostop do kamere, da lahko posnamete fotografijo.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Med samodejnim prijavljanjem v vaš Link račun je prišlo do napake. Prosimo, da se prijavite ročno.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Odgovor";
/* Action to open the system document picker to select a file */
"Choose File…" = "Izberite datoteko ...";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Izberite fotografijo ...";
/* Button asking the owner to open its support destination */
"Contact support" = "Obrnite se na podporo";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Najverjetneje bodo sprejete debetne kartice.";
/* Label and picker title for a document's category */
"Document type" = "Vrsta dokumenta";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokument je uspešno naložen";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Preden nadaljujete, dokončajte preverjanje svojega računa Link.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Vir sredstev";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Kako financirate svoje transakcije? Prosimo, navedite vse svoje vire. Na primer, plača, prihranki, zaslužki od naložb itd.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Neveljaven format telefonske številke. Prosimo, uporabite format E.164 (npr. +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Prepričajte se, da vaš dokument izpolnjuje naslednje zahteve.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Noben od načinov plačila ni pripravljen za uporabo. Prosimo, zagotovite način plačila in poskusite znova.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Prosimo, znova izberite svoj način plačila Apple Pay, da nadaljujete.";
/* Instruction after an unavailable operation */
"Please try again later." = "Poskusite znova pozneje.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Zahtevane informacije so manjkale. Prosimo, poskusite kasneje znova.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Oddano v pregled";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Posnemi fotografijo …";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Povejte nam o svojem viru sredstev";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Prišlo je do težave z vašim prejšnjim dokumentom. Prosimo, naložite novega.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Te aplikacije zaradi napake pri potrditvi ni bilo mogoče preveriti. Poskusite znova kasneje ali kontaktirajte razvijalca, če se težava pojavlja še naprej.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Te aplikacije ni bilo mogoče preveriti. Za pomoč se obrnite na razvijalca aplikacije.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Ta datoteka je večja od %1$@. Izberite datoteko velikosti %2$@ ali manjšo.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Ta vrsta datoteke ni podprta.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Ta vrsta datoteke ni podprta. Naložite datoteko %@.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Te denarnice ni mogoče najti. Izberite ali dodajte denarnico in poskusite znova.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "To omrežje denarnice ni podprto. Izberite drugo omrežje.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Ta zahteva za preverjanje denarnice je potekla. Poskusite znova.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Ta zahteva za preverjanje denarnice je neveljavna. Poskusite znova.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Ta zahteva za preverjanje denarnice ni več veljavna. Poskusite znova.";
/* Action to select an existing document for upload */
"Upload document" = "Naložite dokument";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Naložite svoje dokazilo o naslovu";
/* Status after a document has uploaded successfully */
"Uploaded" = "Naloženo";
/* Status while a document is uploading */
"Uploading…" = "Nalaganje …";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Preden nadaljujete, potrdite svoj Link račun.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Lastništva te denarnice ni bilo mogoče preveriti. Poskusite znova.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Tega dokumenta nismo mogli odpreti. Prosimo, izberite ga znova.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Te datoteke nismo mogli naložiti. Prosimo, poskusite znova.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Za večje transakcije lahko zahtevamo dokazilo o naslovu.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Za večje transakcije lahko zahtevamo izvor sredstev.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Potrditi moramo vaš naslov, da omogočimo porabo nad %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Razumeti moramo, od kod izvirajo vaša sredstva, da omogočimo porabo nad %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Potrditi moramo vaš naslov, da omogočimo porabo nad %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Razumeti moramo, od kod izvirajo vaša sredstva, da omogočimo porabo nad %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Pregledujemo vaše dokumente. Ko bo preverjanje končano, vas bomo obvestili.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Lahko nadaljujete, medtem ko v ozadju preverjamo vaš dokument.";