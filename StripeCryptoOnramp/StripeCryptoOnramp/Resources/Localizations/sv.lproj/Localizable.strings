/* Error message shown when the user tries to create a Link account for an email that already has one */
"A Link account already exists for this email. Log in instead." = "Det finns redan ett Link-konto för den här e-postadressen. Logga in istället.";
/* Action to add multiple uploaded documents to a source of funds. The placeholder is the document count. */
"Add %ld documents" = "Lägg till %ld dokument";
/* Action to add exactly one uploaded document to a source of funds */
"Add 1 document" = "Lägg till 1 dokument";
/* Action to add documents for another source of funds */
"Add documents" = "Lägg till dokument";
/* Error when camera access is denied or restricted during document collection */
"Allow camera access in Settings to take a photo." = "Tillåt kameraåtkomst i inställningarna för att ta en bild.";
/* Error message shown when automatic Link sign-in fails and the user needs to sign in manually */
"An error occurred while automatically signing in to your Link account. Please sign in manually." = "Ett fel uppstod när du automatiskt loggade in på ditt Link-konto. Logga in manuellt.";
/* Label and placeholder for a questionnaire answer field */
"Answer" = "Svar";
/* Action to open the system document picker to select a file */
"Choose File…" = "Välj fil ...";
/* Action to open the system photo picker to select a photo */
"Choose Photo…" = "Välj foto ...";
/* Button asking the owner to open its support destination */
"Contact support" = "Kontakta supporten";
/* Label shown in the Link UI indicating that debit cards are more likely to be accepted */
"Debit cards are most likely to be accepted." = "Bankkort accepteras oftast.";
/* Label and picker title for a document's category */
"Document type" = "Dokumenttyp";
/* Heading confirming a document was uploaded successfully */
"Document uploaded successfully" = "Dokumentet har laddats upp";
/* Error message shown when the SDK needs a crypto customer ID before continuing */
"Finish verifying your Link account before continuing." = "Slutför verifieringen av ditt Link-konto innan du fortsätter.";
/* Label for the selected source of funds in the document editor */
"Funds source" = "Källa för medel";
/* Explanation above the summary of source-of-funds documents. */
"How are you funding your transactions? Please list all of your sources. For example, salary, savings, investment earnings, etc." = "Hur finansierar du dina transaktioner? Lista alla dina källor. Till exempel lön, besparingar, investeringsintäkter osv.";
/* Error message shown when the provided phone number is not in the expected format */
"Invalid phone format. Please use E.164 format (e.g., +12125551234)." = "Ogiltigt telefonformat. Använd E.164-format (t.ex. +12125551234).";
/* Explanation above the document upload control */
"Make sure your document meets following requirements." = "Se till att ditt dokument uppfyller följande krav.";
/* Error message shown when there is no usable payment method selected */
"No payment method is ready to use. Please collect a payment method and try again." = "Ingen betalningsmetod är redo att användas. Registrera en betalningsmetod och försök igen.";
/* Error message shown when an Apple Pay payment method must be collected again because the platform key changed */
"Please select your Apple Pay payment method again to continue." = "Välj din Apple Pay-betalningsmetod igen för att fortsätta.";
/* Instruction after an unavailable operation */
"Please try again later." = "Försök igen senare.";
/* Error message shown when the SDK is missing required information from the server */
"Required information was missing. Please try again later." = "Obligatorisk information saknades. Försök igen senare.";
/* Heading confirming documents were submitted for review */
"Submitted for review" = "Inskickat för granskning";
/* Action to open the system camera to take a photo of a document */
"Take Photo…" = "Ta bild...";
/* Heading introducing source of funds collection */
"Tell us about your source of funds" = "Berätta för oss om din pengakälla";
/* Message shown when a previous document has a requirement error */
"There was a problem with your previous document. Please upload a new one." = "Det uppstod ett problem med ditt tidigare dokument. Ladda upp ett nytt.";
/* Error message shown when app attestation fails */
"This app couldn't be verified due to an attestation error. Please try again later or contact the developer if the issue persists." = "Den här appen kunde inte verifieras på grund av ett intygsfel. Försök igen senare eller kontakta utvecklaren om problemet kvarstår.";
/* Error message shown when app attestation is not configured for crypto onramp */
"This app couldn't be verified. Contact the app developer for help." = "Den här appen kunde inte verifieras. Kontakta appens utvecklare för att få hjälp.";
/* Validation error for a document exceeding the size limit */
"This file is larger than %@. Choose a file that is %@ or smaller." = "Den här filen är större än %1$@. Välj en fil som är %2$@ eller mindre.";
/* Validation error when no document formats are available */
"This file type isn’t supported." = "Den här filtypen stöds inte.";
/* Validation error for an unsupported document format. The placeholder is a locale-aware formatted list of one or more accepted document formats. */
"This file type isn’t supported. Upload a %@ file." = "Den här filtypen stöds inte. Ladda upp en %@-fil.";
/* Error message shown when the wallet is not registered for crypto onramp */
"This wallet couldn't be found. Please choose or add a wallet and try again." = "Den här plånboken kunde inte hittas. Välj eller lägg till en plånbok och försök igen.";
/* Error message shown when the wallet network is not supported for crypto onramp */
"This wallet network isn't supported. Please choose a different network." = "Detta plånboksnätverk stöds inte. Välj ett annat nätverk.";
/* Error message shown when the wallet ownership challenge has expired */
"This wallet verification request expired. Please try again." = "Den här begäran om plånboksverifiering har löpt ut. Försök igen.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is invalid. Please try again." = "Den här begäran om plånboksverifiering är ogiltig. Försök igen.";
/* Error message shown when the wallet ownership challenge is invalid */
"This wallet verification request is no longer valid. Please try again." = "Den här begäran om plånboksverifiering är inte längre giltig. Försök igen.";
/* Action to select an existing document for upload */
"Upload document" = "Ladda upp dokument";
/* Heading introducing proof of address collection */
"Upload your proof of address" = "Ladda upp ditt adressbevis";
/* Status after a document has uploaded successfully */
"Uploaded" = "Uppladdad";
/* Status while a document is uploading */
"Uploading…" = "Laddar upp ...";
/* Error message shown when the user's Link account is not verified */
"Verify your Link account before continuing." = "Verifiera ditt Link-konto innan du fortsätter.";
/* Error message shown when the submitted wallet ownership signature is invalid */
"We couldn't verify ownership of this wallet. Please try again." = "Vi kunde inte verifiera vem som äger den här plånboken. Försök igen.";
/* Error when a file provider cannot supply a document */
"We couldn’t open this document. Please choose it again." = "Vi kunde inte öppna det här dokumentet. Välj det igen.";
/* Error after a document upload fails */
"We couldn’t upload this file. Please try again." = "Vi kunde inte ladda upp den här filen. Försök igen.";
/* Explanation introducing proof of address collection. */
"We may request proof of address for larger transactions." = "Vi kan begära adressbevis för större transaktioner.";
/* Explanation introducing source of funds collection. */
"We may request source of funds for larger transactions." = "Vi kan begära information om källan till medlen för större transaktioner.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to confirm your address to enable spending over %@." = "Vi måste bekräfta din adress för att tillåta utgifter över %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We're required to understand where your funds come from to enable spending over %@." = "Vi måste förstå var dina medel kommer ifrån för att tillåta utgifter över %@.";
/* Explanation introducing proof of address collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to confirm your address to enable spending over %@." = "Vi måste bekräfta din adress för att tillåta utgifter över %@.";
/* Explanation introducing source of funds collection. %@ is a formatted monetary threshold, such as €1,000. */
"We’re required to understand where your funds come from to enable spending over %@." = "Vi måste förstå var dina medel kommer ifrån för att tillåta utgifter över %@.";
/* Message confirming documents are being reviewed and the user will be notified when verification is complete. */
"We’re reviewing your documents. We’ll let you know when verification is complete." = "Vi granskar dina dokument. Vi meddelar dig när verifieringen är klar.";
/* Message confirming the document was uploaded and the user can continue while verification happens in the background. */
"You can continue while we verify your document in the background." = "Du kan fortsätta medan vi verifierar ditt dokument i bakgrunden.";