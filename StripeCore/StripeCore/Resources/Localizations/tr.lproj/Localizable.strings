/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Uygulamaya bir hata ayıklayıcı bağlandı.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Uygulamayı çalıştırmak için bir emülatör kullanılıyor.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Bir hata oluştu. Lütfen tekrar deneyin.";
/* Button title to cancel action in an alert */
"Cancel" = "İptal et";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Kart markası güncellenmedi. Lütfen tekrar deneyin.";
/* Text for close button */
"Close" = "Kapat";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Daraltılmış";
/* Two factor authentication screen heading */
"Confirm it's you" = "Siz olduğunuzu teyit edin";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Varsayılan ödeme yöntemi değiştirilmedi. Lütfen tekrar deneyin.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Varsayılan ödeme yöntemi güncellenmedi. Lütfen tekrar deneyin.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Kart bilgilerini manuel olarak girin";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "%@’a gönderilen kodu girin.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Genişletilmiş";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Bağlantı başarısız oldu";
/* Status while screen is loading */
"Loading" = "Yükleniyor";
/* The no answer to a yes or no question. */
"No" = "Hayır";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Kodu tekrar gönder";
/* Text for button to scan a credit card */
"Scan Card" = "Kartı Tara";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Kartı tara";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Güvenli ödeme";
/* Indicates that a button is selected. */
"Selected" = "Seçili";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Girdiğiniz IBAN geçersiz.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "İS veya İS Sürümü desteklenmiyor.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Cihaza jailbreak yapılmış.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "SDK'nın bütünlüğüne müdahale edilmiş.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Kartınızla işlem yapılırken bir hata oluştu -- birazdan tekrar deneyin";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Beklenmedik bir hata oluştu -- birazdan tekrar deneyin";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Zaman aşımı";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Tekrar dene";
/* Indicates that a button is not selected. */
"Unselected" = "Seçili değil";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Kart bilgilerinizi doğrulamak için Stripe kullanıyoruz. Stripe verilerinizi gizlilik politikasına uygun şekilde kullanabilir ve saklayabilir.<a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Daha fazlasını öğrenin</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Evet";
/* Error when the card has already expired */
"Your card has expired" = "Kartınızın kullanım süresi dolmuş";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Kartınız reddedildi";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Kartınızın son kullanma ayı geçersiz";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Kartınızın son kullanma yılı geçersiz";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Kart numaranız geçersiz";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Kartınızın güvenlik kodu geçersiz";
/* Error when customer's name is invalid */
"Your name is invalid." = "Adınız geçersiz.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Ödeme yönteminiz reddedildi.";