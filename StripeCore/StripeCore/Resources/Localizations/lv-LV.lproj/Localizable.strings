/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Atkļūdotājs ir pievienots Lietotnei.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Emulators tiek izmantots, lai darbinātu Lietotni.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Radās kļūda. Lūdzu, mēģiniet vēlreiz.";
/* Button title to cancel action in an alert */
"Cancel" = "Atcelt";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Kartes zīmols netika atjaunināts. Lūdzu, mēģiniet vēlreiz.";
/* Text for close button */
"Close" = "Aizvērt";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Sakļauts";
/* Two factor authentication screen heading */
"Confirm it's you" = "Apstipriniet, ka tas esat jūs";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Noklusējuma maksājumu veids netika mainīts. Mēģiniet vēlreiz.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Noklusējuma maksājumu veids netika atjaunināts. Mēģiniet vēlreiz.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Ievadiet kartes informāciju manuāli";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Ievadiet kodu, kas tika nosūtīts uz %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Izvērsts";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Neizdevās izveidot savienojumu";
/* Status while screen is loading */
"Loading" = "Ielādē";
/* The no answer to a yes or no question. */
"No" = "Nē";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Sūtīt kodu vēlreiz";
/* Text for button to scan a credit card */
"Scan Card" = "Skenēt karti";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Skenēt karti";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Droša norēķināšanās";
/* Indicates that a button is selected. */
"Selected" = "Atlasīts";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Ievadītais IBAN nav derīgs.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "OS vai OS versija netiek atbalstīta.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Ierīce ir uzlauzta.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "SDK integritāte ir kompromitēta.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Radās kļūda, apstrādājot jūsu karti — mēģiniet vēlreiz pēc dažām sekundēm";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Radusies negaidīta kļūda — mēģiniet vēlreiz pēc dažām sekundēm";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Noildze";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Mēģināt vēlreiz";
/* Indicates that a button is not selected. */
"Unselected" = "Neatlasīts";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Mēs izmantojam Stripe, lai verificētu jūsu kartes informāciju. Stripe var izmantot un uzglabāt jūsu datus saskaņā ar konfidencialitātes politiku. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Uzzināt vairāk</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Jā";
/* Error when the card has already expired */
"Your card has expired" = "Kartes derīguma termiņš ir beidzies";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Karte tika noraidīta";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Kartes derīguma termiņa mēnesis nav derīgs";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Kartes derīguma termiņa gads nav derīgs";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Kartes numurs nav derīgs";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Kartes drošības kods nav derīgs";
/* Error when customer's name is invalid */
"Your name is invalid." = "Jūsu vārds nav derīgs.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Maksājuma veids tika noraidīts.";