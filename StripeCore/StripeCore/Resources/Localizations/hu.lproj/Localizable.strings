/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Egy hibakereső csatlakozik az alkalmazáshoz.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Az alkalmazás futtatásához emulátort használnak.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Hiba történt, próbálja újra.";
/* Button title to cancel action in an alert */
"Cancel" = "Mégse";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "A kártyatípus frissítése nem sikerült, próbálja újra.";
/* Text for close button */
"Close" = "Bezárás";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Összecsukva";
/* Two factor authentication screen heading */
"Confirm it's you" = "Igazolja személyazonosságát";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Az alapértelmezett fizetési mód nem változott, próbálja újra.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Az alapértelmezett fizetési mód nem frissült, próbálja újra.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Kártyaadatok manuális megadása";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Írja be a(z) %@ címre küldött kódot.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Kibontva";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Nem sikerült csatlakozni";
/* Status while screen is loading */
"Loading" = "Betöltés";
/* The no answer to a yes or no question. */
"No" = "Nem";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Kód újraküldése";
/* Text for button to scan a credit card */
"Scan Card" = "Kártya beolvasása";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Kártya beolvasása";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Biztonságos fizetés";
/* Indicates that a button is selected. */
"Selected" = "Kiválasztva";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "A beírt IBAN-szám érvénytelen.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "Az operációs rendszer vagy annak verziója nem támogatott.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Az eszköz fel van törve.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "Az SDK integritása sérült.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Hiba történt kártyája feldolgozása során, próbálja újra néhány másodperc múlva";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Váratlan hiba lépett fel, próbálja újra néhány másodperc múlva";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Időtúllépés";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Próbálja újra";
/* Indicates that a button is not selected. */
"Unselected" = "Nincs kiválasztva";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "A Stripe-ot használjuk a kártyájának az ellenőrzésére. A Stripe az adatvédelmi szabályzatának megfelelően használhatja és tárolhatja az Ön adatait. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>További tudnivalók</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Igen";
/* Error when the card has already expired */
"Your card has expired" = "A kártyája lejárt";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "A kártyáját elutasítottuk";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Kártyájának lejárati hónapja érvénytelen";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "A kártyája lejárati éve érvénytelen";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Kártyaszáma érvénytelen";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Kártyájának biztonsági kódja érvénytelen";
/* Error when customer's name is invalid */
"Your name is invalid." = "Érvénytelen név.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Fizetési módja elutasításra került.";