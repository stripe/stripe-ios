/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "K aplikaci je připojen ladicí program.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Ke spuštění aplikace se používá emulátor.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Došlo k chybě. Zkuste to prosím znovu.";
/* Button title to cancel action in an alert */
"Cancel" = "Zrušit";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Značka karty nebyla aktualizována. Zkuste to prosím znovu.";
/* Text for close button */
"Close" = "Zavřít";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Sbaleno";
/* Two factor authentication screen heading */
"Confirm it's you" = "Potvrďte, že jste to vy";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Výchozí způsob platby nebyl změněn. Zkuste to prosím znovu.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Výchozí způsob platby nebyl aktualizován. Zkuste to prosím znovu.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Zadejte podrobnosti o kartě ručně";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Zadejte kód zaslaný na %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Rozbaleno";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Propojení se nezdařilo";
/* Status while screen is loading */
"Loading" = "Načítání";
/* The no answer to a yes or no question. */
"No" = "Ne";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Znovu odeslat kód";
/* Text for button to scan a credit card */
"Scan Card" = "Naskenovat kartu";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Naskenovat kartu";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Bezpečná pokladna";
/* Indicates that a button is selected. */
"Selected" = "Vybráno";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Číslo IBAN, které jste zadali, je neplatné.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "Nepodporovaný operační systém nebo nepodporovaná verze operačního systému.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Na zařízení byl proveden jailbreak.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "Integrita SDK byla narušena.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Při zpracování Vaší karty došlo k chybě -- zkuste to za několik sekund znovu";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Došlo k neočekávané chybě -- zkuste to znovu za několik sekund";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Vypršení časového limitu";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Zkusit znovu";
/* Indicates that a button is not selected. */
"Unselected" = "Nevybráno";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "K ověření údajů o vaší kartě používáme službu Stripe. Společnost Stripe může vaše údaje používat a ukládat v souladu se svými zásadami ochrany osobních údajů. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Více informací</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Ano";
/* Error when the card has already expired */
"Your card has expired" = "Platnost Vaší karty uplynula";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Vaše karta byla odmítnuta";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Měsíc konce platnosti Vaší karty je neplatný";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Rok konce platnosti Vaší karty je neplatný";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Číslo Vaší karty je neplatné";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Bezpečnostní kód Vaší karty je neplatný";
/* Error when customer's name is invalid */
"Your name is invalid." = "Vaše jméno je neplatné.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Vaše platební metoda byla zamítnuta.";