/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Penyahpepijat dilampirkan pada Apl.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Emulator sedang digunakan untuk menjalankan Apl.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Ada ralat berlaku. Sila cuba lagi.";
/* Button title to cancel action in an alert */
"Cancel" = "Batal";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Jenama kad tidak dikemaskinikan. Sila cuba lagi.";
/* Text for close button */
"Close" = "Tutup";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Diriutkan";
/* Two factor authentication screen heading */
"Confirm it's you" = "Sahkan andalah orangnya";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Kaedah pembayaran tetapan asal tidak diubah. Sila cuba lagi.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Kaedah pembayaran tetapan asal tidak dikemaskinikan. Sila cuba lagi.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Masukkan butiran kad secara manual";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Masukkan kod yang dihantar kepada %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Dikembangkan";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Gagal menyambung";
/* Status while screen is loading */
"Loading" = "Memuatkan";
/* The no answer to a yes or no question. */
"No" = "Tidak";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Hantar semula kod";
/* Text for button to scan a credit card */
"Scan Card" = "Imbas Kad";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Imbas kad";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Proses bayar dan keluar selamat";
/* Indicates that a button is selected. */
"Selected" = "Dipilih";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "IBAN yang anda masukkan tidak sah.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "OS atau Versi OS tidak disokong.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Peranti telah di-jailbreak.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "Integriti SDK telah diubah suai.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Ada ralat ketika memproses kad anda -- cuba lagi dalam masa beberapa saat";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Ada ralat yang tidak dijangka -- cuba lagi dalam masa beberapa saat";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Masa tamat";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Cuba lagi";
/* Indicates that a button is not selected. */
"Unselected" = "Tidak dipilih";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Kami menggunakan Stripe untuk mengesahkan butiran kad anda. Stripe mungkin menggunakan dan menyimpan data anda menurut dasar privasi Stripe. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Ketahui selanjutnya</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Ya";
/* Error when the card has already expired */
"Your card has expired" = "Kad anda telah tamat tempoh";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Kad anda telah ditolak";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Bulan tamat tempoh kad anda tidak sah";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Tahun tamat tempoh kad anda tidak sah";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Nombor kad anda tidak sah";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Kod keselamatan kad anda tidak sah";
/* Error when customer's name is invalid */
"Your name is invalid." = "Nama anda tidak sah.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Kaedah pembayaran anda ditolak.";