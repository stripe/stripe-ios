/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Mae nodwedd difa chwilod wedi’i chysylltu â’r Ap.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Mae efelychydd yn cael ei ddefnyddio i redeg yr Ap.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Aeth rhywbeth o'i le. Rhowch gynnig arall arni.";
/* Button title to cancel action in an alert */
"Cancel" = "Canslo";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Heb ddiweddaru brand y cerdyn. Rhowch gynnig arall arni.";
/* Text for close button */
"Close" = "Cau";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Wedi crebachu";
/* Two factor authentication screen heading */
"Confirm it's you" = "Cadarnhau mai chi sydd yno";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Heb newid y dull talu diofyn. Rhowch gynnig arall arni.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Heb ddiweddaru'r dull talu diofyn. Rhowch gynnig arall arni.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Rhoi manylion y cerdyn â llaw";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Rhowch y cod a anfonwyd i %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Wedi ehangu";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Wedi methu cysylltu";
/* Status while screen is loading */
"Loading" = "Wrthi’n llwytho";
/* The no answer to a yes or no question. */
"No" = "Na";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Ailanfon y cod";
/* Text for button to scan a credit card */
"Scan Card" = "Sganio Cerdyn";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Sganio cerdyn";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Talu’n ddiogel";
/* Indicates that a button is selected. */
"Selected" = "Wedi’i ddewis";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Mae'r IBAN a roddwyd yn annilys.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "Does dim modd delio â’r OS na’r Fersiwn OS.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Mae’r ddyfais wedi’i dad-gyfyngu.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "Mae rhywbeth wedi ymyrryd ag uniondeb yr SDK.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Aeth rhywbeth o'i le wrth brosesu eich cerdyn – rhowch gynnig arall arni mewn ychydig eiliadau";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Cafwyd gwall annisgwyl – rhowch gynnig arall arni mewn ychydig eiliadau";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Terfyn amser";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Rhoi cynnig arall arni";
/* Indicates that a button is not selected. */
"Unselected" = "Heb ddewis";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Rydyn ni'n defnyddio Stripe i ddilysu'ch manylion cerdyn. Gall Stripe ddefnyddio a storio'ch data yn unol â'i bolisi preifatrwydd. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Dysgu mwy</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Ie";
/* Error when the card has already expired */
"Your card has expired" = "Mae eich cerdyn wedi dod i ben";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Gwrthodwyd eich cerdyn";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Mae mis dod i ben eich cerdyn yn annilys";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Mae blwyddyn dod i ben eich cerdyn yn annilys";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Mae rhif eich cerdyn yn annilys";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Mae cod diogelwch eich cerdyn yn annilys";
/* Error when customer's name is invalid */
"Your name is invalid." = "Mae eich enw'n annilys.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Gwrthodwyd eich dull talu.";