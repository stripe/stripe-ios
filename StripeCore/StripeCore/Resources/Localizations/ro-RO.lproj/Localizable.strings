/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Un depanator este atașat la Aplicație.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Se folosește un emulator pentru a rula Aplicația.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "A apărut o eroare. Încercați din nou.";
/* Button title to cancel action in an alert */
"Cancel" = "Anulare";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Marca de card nu a fost actualizată. Încercați din nou.";
/* Text for close button */
"Close" = "Închidere";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Restrâns";
/* Two factor authentication screen heading */
"Confirm it's you" = "Confirmați că sunteți dvs.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Metoda de plată implicită nu a fost modificată. Vă rugăm să încercați din nou.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Metoda de plată implicită nu a fost actualizată. Încercați din nou.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Introduceți manual informațiile privind cardul";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Introduceți codul trimis la %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Extins";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Nu s-a reușit conectarea";
/* Status while screen is loading */
"Loading" = "Se încarcă";
/* The no answer to a yes or no question. */
"No" = "Nu";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Retrimitere cod";
/* Text for button to scan a credit card */
"Scan Card" = "Scanare card";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Scanare card";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Finalizare comandă securizată";
/* Indicates that a button is selected. */
"Selected" = "Selectat";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Codul IBAN pe care l-ați introdus nu este valid.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "Sistemul de operare sau versiunea sistemului de operare nu este acceptată.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Dispozitivul este deblocat (prin jailbreak).";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "Integritatea SDK-ului a fost alterată.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "A apărut o eroare la procesarea cardului dvs. -- încercați din nou în câteva secunde";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "A apărut o eroare neașteptată -- încercați din nou în câteva secunde";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Timp expirat";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Încercați din nou";
/* Indicates that a button is not selected. */
"Unselected" = "Neselectat";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Folosim Stripe pentru a verifica detaliile cardului dvs. Stripe poate utiliza și stoca datele dvs. în conformitate cu politica sa de confidențialitate. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Aflați mai multe</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Da";
/* Error when the card has already expired */
"Your card has expired" = "Cardul dvs. a expirat";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Cardul dvs. a fost respins";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Luna de expirare a cardului nu este validă";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Anul de expirare al cardului dvs. nu este valid";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Numărul cardului dvs. nu este valid";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Codul de securitate al cardului dvs. nu este valid";
/* Error when customer's name is invalid */
"Your name is invalid." = "Numele dvs. nu este valid.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Metoda dvs. de plată a fost respinsă.";