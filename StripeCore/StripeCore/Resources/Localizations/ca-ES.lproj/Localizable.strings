/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "S'ha connectat un depurador a l'App.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "S'està utilitzant un emulador per executar l'App.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "S'ha produït un error. Torneu-ho a provar.";
/* Button title to cancel action in an alert */
"Cancel" = "Cancel·la";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "La marca de la targeta no s'ha actualitzat. Torneu-ho a provar.";
/* Text for close button */
"Close" = "Tanca";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Ocult";
/* Two factor authentication screen heading */
"Confirm it's you" = "Confirmeu la vostra identitat";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "El mètode de pagament per defecte no s'ha canviat. Torneu-ho a provar.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "El mètode de pagament per defecte no s'ha pogut actualitzar. Torneu-ho a provar.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Introduïu les dades de la targeta manualment";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Introdueix el codi enviat a %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Desplegat";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "No s'ha pogut connectar";
/* Status while screen is loading */
"Loading" = "Carregant";
/* The no answer to a yes or no question. */
"No" = "No";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Tornar a enviar el codi";
/* Text for button to scan a credit card */
"Scan Card" = "Escanejar targeta";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Escanejar targeta";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Finalització de la compra segura";
/* Indicates that a button is selected. */
"Selected" = "Seleccionat";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "L'IBAN és incorrecte.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "El sistema operatiu o la versió del sistema operatiu no és compatible.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "El dispositiu està desbloquejat.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "La integritat de l'SDK ha estat manipulada.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Hi ha hagut un error processant la teva targeta - torna-ho a intentar en uns segons";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Hi ha hagut un error inesperat - torna-ho a intentar en uns segons";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Temps d'espera esgotat";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Intenta-ho un altre cop";
/* Indicates that a button is not selected. */
"Unselected" = "No seleccionat";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Emprem Stripe per verificar els detalls de la vostra targeta. És possible que Stripe faci ús i emmagatzemi les dades d'acord amb la política de privadesa. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Més informació</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Sí";
/* Error when the card has already expired */
"Your card has expired" = "La teva targeta ha caducat";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "S'ha rebutjat la teva targeta";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "El mes de caducitat de la teva targeta no és vàlid";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "L'any de caducitat de la teva targeta no és vàlid";
/* Error when the card number is not valid */
"Your card's number is invalid" = "El número de la teva targeta no és vàlid";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "El codi de seguretat de la teva targeta no és vàlid";
/* Error when customer's name is invalid */
"Your name is invalid." = "El nom no és vàlid.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "S'ha rebutjat el mètode de pagament.";