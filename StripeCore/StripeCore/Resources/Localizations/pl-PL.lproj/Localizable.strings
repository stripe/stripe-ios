/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Do aplikacji podłączono debugger.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Do uruchomienia aplikacji użyto emulatora.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Wystąpił błąd. Spróbuj ponownie.";
/* Button title to cancel action in an alert */
"Cancel" = "Anuluj";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Marka karty nie została zaktualizowana. Spróbuj ponownie.";
/* Text for close button */
"Close" = "Zamknij";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Zwinięte";
/* Two factor authentication screen heading */
"Confirm it's you" = "Potwierdź, że to Ty";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Domyślna metoda płatności nie została zmieniona. Spróbuj ponownie.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Domyślna metoda płatności nie została zaktualizowana. Spróbuj ponownie.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Wprowadź dane karty ręcznie";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Wprowadź kod wysłany na: %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Rozwinięte";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Nie udało się połączyć";
/* Status while screen is loading */
"Loading" = "Ładowanie";
/* The no answer to a yes or no question. */
"No" = "Nie";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Wyślij kod ponownie";
/* Text for button to scan a credit card */
"Scan Card" = "Skanuj kartę";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Skanuj kartę";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Bezpieczna finalizacja";
/* Indicates that a button is selected. */
"Selected" = "Wybrane";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Podany IBAN jest nieprawidłowy.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "System operacyjny lub jego wersja nie są obsługiwane.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Na urządzeniu wykonano jailbreak.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "Integralność zestawu SDK została naruszona.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Podczas przetwarzania Twojej karty wystąpił błąd – spróbuj ponownie za kilka sekund";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Wystąpił nieoczekiwany błąd – spróbuj ponownie za kilka sekund";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Przekroczenie limitu czasu";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Spróbuj ponownie";
/* Indicates that a button is not selected. */
"Unselected" = "Niewybrane";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Korzystamy ze Stripe, aby weryfikować szczegóły Twojej karty. Stripe może używać Twoich danych i przechowywać je zgodnie ze swoją polityką prywatności. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Dowiedz się więcej</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Tak";
/* Error when the card has already expired */
"Your card has expired" = "Ważność Twojej karty wygasła";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Karta została odrzucona";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Miesiąc daty ważności karty jest nieprawidłowy.";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Rok daty ważności karty jest nieprawidłowy";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Numer Twojej karty jest nieprawidłowy";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Kod bezpieczeństwa karty jest nieprawidłowy";
/* Error when customer's name is invalid */
"Your name is invalid." = "Twoje imię i nazwisko jest nieprawidłowe.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Twoja metoda płatności została odrzucona.";