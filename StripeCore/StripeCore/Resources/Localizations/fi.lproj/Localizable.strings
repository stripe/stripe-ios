/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Virheenkorjain on liitetty Sovellukseen.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Emulaattoria käytetään Sovelluksen suorittamiseen.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Tapahtui virhe. Yritä uudelleen.";
/* Button title to cancel action in an alert */
"Cancel" = "Peruuta";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Korttimerkkiä ei päivitetty. Yritä uudelleen.";
/* Text for close button */
"Close" = "Sulje";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Tiivistetty";
/* Two factor authentication screen heading */
"Confirm it's you" = "Vahvista, että se olet sinä";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Oletusmaksutapaa ei muutettu. Yritä uudelleen.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Oletusmaksutapaa ei päivitetty. Yritä uudelleen.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Syötä kortin tiedot manuaalisesti";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Syötä kohteeseen %@ lähetetty koodi.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Laajennettu";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Yhteyden muodostaminen epäonnistui";
/* Status while screen is loading */
"Loading" = "Ladataan";
/* The no answer to a yes or no question. */
"No" = "Ei";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Lähetä koodi uudelleen";
/* Text for button to scan a credit card */
"Scan Card" = "Skannaa kortti";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Skannaa kortti";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Turvallinen maksaminen";
/* Indicates that a button is selected. */
"Selected" = "Valittu";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Antamasi IBAN on virheellinen.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "Käyttöjärjestelmää tai käyttöjärjestelmän versiota ei tueta.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Laite on murrettu.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "SDK:n eheyttä on peukaloitu.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Kortin käsittelyssä tapahtui virhe – kokeile uudelleen muutaman sekunnin kuluttua";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Odottamaton virhe – kokeile uudelleen muutaman sekunnin kuluttua";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Aikakatkaisu";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Yritä uudelleen";
/* Indicates that a button is not selected. */
"Unselected" = "Ei valittu";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Käytämme Stripeä korttitietojen vahvistamiseen. Stripe voi käyttää ja säilyttää tietojasi heidän tietosuojaselosteensa mukaisesti. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Lue lisää</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Kyllä";
/* Error when the card has already expired */
"Your card has expired" = "Korttisi on vanhentunut";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Korttiasi ei hyväksytty";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Kortin erääntymiskuukausi ei kelpaa";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Kortin erääntymisvuosi ei kelpaa";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Kortin numero ei kelpaa";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Kortin turvakoodi ei kelpaa";
/* Error when customer's name is invalid */
"Your name is invalid." = "Nimi on virheellinen.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Maksutapasi on hylätty.";