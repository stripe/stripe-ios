/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "K aplikácii je pripojený debugger.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Na spustenie aplikácie sa používa emulátor.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Vyskytla sa chyba. Skúste to znova.";
/* Button title to cancel action in an alert */
"Cancel" = "Zrušiť";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Značka karty nebola aktualizovaná. Skúste to znova.";
/* Text for close button */
"Close" = "Zatvoriť";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Zbalené";
/* Two factor authentication screen heading */
"Confirm it's you" = "Potvrdenie vašej totožnosti";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Predvolený spôsob platby nebol zmenený. Skúste to znova.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Predvolený spôsob platby nebol aktualizovaný. Skúste to znova.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Zadajte informácie o karte manuálne";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Zadajte kód odoslaný na telefónne číslo %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Rozbalené";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Nepodarilo sa pripojiť";
/* Status while screen is loading */
"Loading" = "Načítava sa";
/* The no answer to a yes or no question. */
"No" = "Nie";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Opätovne odoslať kód";
/* Text for button to scan a credit card */
"Scan Card" = "Naskenovať kartu";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Naskenovať kartu";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Bezpečná platba";
/* Indicates that a button is selected. */
"Selected" = "Vybraté";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Zadaný IBAN je neplatný.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "OS alebo verzia OS nie je podporovaná.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Zariadenie má odstránené systémové obmedzenia.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "Integrita SDK bola narušená.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Pri spracovaní vašej karty sa vyskytla chyba -- skúste znova o niekoľko sekúnd";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Vyskytla sa neočakávaná chyba -- skúste znova o niekoľko sekúnd";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Časový limit";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Skúsiť znova";
/* Indicates that a button is not selected. */
"Unselected" = "Nevybraté";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Na overenie údajov o vašej karte používame službu Stripe. Spoločnosť Stripe môže používať a uchovávať vaše údaje v súlade so zásadami ochrany osobných údajov. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Ďalšie informácie</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Áno";
/* Error when the card has already expired */
"Your card has expired" = "Platnosť vašej karty vypršala";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Vaša karta bola odmietnutá";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Mesiac ukončenia platnosti vašej karty je neplatný";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Rok ukončenia platnosti vašej karty je neplatný";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Číslo vašej karty je neplatné";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Bezpečnostný kód vašej karty je neplatný";
/* Error when customer's name is invalid */
"Your name is invalid." = "Vaše meno je neplatné.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Váš spôsob platby bol odmietnutý.";