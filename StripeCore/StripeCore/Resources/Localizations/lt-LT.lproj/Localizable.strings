/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Prie programėlės prijungta derinimo programa.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Programėlei paleisti naudojamas emuliatorius.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Įvyko klaida. Bandykite dar kartą.";
/* Button title to cancel action in an alert */
"Cancel" = "Atšaukti";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Kortelės prekės ženklas neatnaujintas. Bandykite dar kartą.";
/* Text for close button */
"Close" = "Užverti";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Sutraukta";
/* Two factor authentication screen heading */
"Confirm it's you" = "Patvirtinkite, kad tai jūs";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Numatytasis mokėjimo būdas nepakeistas. Bandykite dar kartą.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Numatytasis mokėjimo būdas neatnaujintas. Bandykite dar kartą.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Įveskite kortelės duomenis rankiniu būdu";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Įveskite į %@ išsiųstą kodą.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Išskleista";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Susieti nepavyko";
/* Status while screen is loading */
"Loading" = "Kraunama";
/* The no answer to a yes or no question. */
"No" = "Ne";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Siųsti kodą iš naujo";
/* Text for button to scan a credit card */
"Scan Card" = "Skenuoti kortelę";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Nuskaityti kortelę";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Saugus pirkimo užbaigimas";
/* Indicates that a button is selected. */
"Selected" = "Pasirinkta";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Įvedėte neteisingą IBAN.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "OS arba OS versija nepalaikoma.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Įrenginys yra nulaužtas.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "Pažeistas SDK vientisumas.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Įvyko kortelės apdorojimo klaida, po kelių sekundžių bandykite dar kartą";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Įvyko netikėta klaida, po kelių sekundžių bandykite dar kartą";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Laiko viršijimas";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Bandyti dar kartą";
/* Indicates that a button is not selected. */
"Unselected" = "Nepasirinkta";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Naudojame \"Stripe\", kad patikrintume jūsų kortelės duomenis. \"Stripe\" gali naudoti ir saugoti jūsų duomenis pagal savo privatumo politiką. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Sužinokite daugiau</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Taip";
/* Error when the card has already expired */
"Your card has expired" = "Kortelė baigė galioti";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Kortelė buvo atmesta";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Negaliojantis kortelės galiojimo pabaigos mėnuo";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Kortelės galiojimo pabaigos metai neteisingi";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Negaliojantis kortelės numeris";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Kortelės saugos kodas negalioja";
/* Error when customer's name is invalid */
"Your name is invalid." = "Jūsų vardas neteisingas.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Jūsų mokėjimo būdas buvo atmestas.";