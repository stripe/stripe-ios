/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Ένα πρόγραμμα εντοπισμού σφαλμάτων είναι συνδεδεμένο στην Εφαρμογή.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Ένας εξομοιωτής χρησιμοποιείται για την εκτέλεση της Εφαρμογής.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Προέκυψε σφάλμα. Δοκιμάστε ξανά.";
/* Button title to cancel action in an alert */
"Cancel" = "Ακύρωση";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Η επωνυμία κάρτας δεν ενημερώθηκε. Δοκιμάστε ξανά.";
/* Text for close button */
"Close" = "Κλείσιμο";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Συμπτυγμένο";
/* Two factor authentication screen heading */
"Confirm it's you" = "Επιβεβαιώστε ότι είστε εσείς";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Η προεπιλεγμένη μέθοδος πληρωμής δεν άλλαξε. Δοκιμάστε ξανά.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Η προεπιλεγμένη μέθοδος πληρωμής δεν ενημερώθηκε. Δοκιμάστε ξανά.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Εισαγάγετε τα στοιχεία κάρτας μη αυτόματα";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Εισαγάγετε τον κωδικό που εστάλη στο %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Αναπτυγμένο";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Αποτυχία σύνδεσης";
/* Status while screen is loading */
"Loading" = "Γίνεται φόρτωση";
/* The no answer to a yes or no question. */
"No" = "Όχι";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Επανάληψη αποστολής κωδικού";
/* Text for button to scan a credit card */
"Scan Card" = "Σάρωση κάρτας";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Σάρωση κάρτας";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Ασφαλές ταμείο";
/* Indicates that a button is selected. */
"Selected" = "Επιλεγμένο";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Ο κωδικός IBAN που εισαγάγατε δεν είναι έγκυρος.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "Το OS ή η Έκδοση του OS δεν υποστηρίζεται.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Η συσκευή δεν διαθέτει περιορισμούς ασφαλείας.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "Η ακεραιότητα του SDK έχει αλλοιωθεί.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Προέκυψε απροσδόκητο σφάλμα κατά την επεξεργασία της κάρτας σας -- δοκιμάστε ξανά σε μερικά δευτερόλεπτα";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Προέκυψε απροσδόκητο σφάλμα -- δοκιμάστε ξανά σε μερικά δευτερόλεπτα";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Λήξη χρονικού ορίου";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Δοκιμάστε ξανά";
/* Indicates that a button is not selected. */
"Unselected" = "Μη επιλεγμένο";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Χρησιμοποιούμε τη Stripe για να επαληθεύσουμε τα στοιχεία της κάρτας σας. Η Stripe μπορεί να χρησιμοποιεί και να αποθηκεύει τα δεδομένα σας σύμφωνα με την πολιτική απορρήτου της. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Μάθετε περισσότερα</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Ναι";
/* Error when the card has already expired */
"Your card has expired" = "Η κάρτα σας έχει λήξει";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Η κάρτα σας απορρίφθηκε";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Ο μήνας λήξης της κάρτας σας δεν είναι έγκυρος";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Το έτος λήξης της κάρτας σας δεν είναι έγκυρο";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Ο αριθμός της κάρτας σας δεν είναι έγκυρος";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Ο κωδικός ασφαλείας της κάρτας σας δεν είναι έγκυρος";
/* Error when customer's name is invalid */
"Your name is invalid." = "Το όνομά σας δεν είναι έγκυρο.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Η μέθοδος πληρωμής σας απορρίφθηκε.";