/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Một trình gỡ lỗi được gắn vào Ứng dụng.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Một trình giả lập đang được sử dụng để chạy Ứng dụng.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Đã xảy ra lỗi. Vui lòng thử lại.";
/* Button title to cancel action in an alert */
"Cancel" = "Hủy";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Thương hiệu thẻ chưa được cập nhật. Vui lòng thử lại.";
/* Text for close button */
"Close" = "Đóng";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Đã thu gọn";
/* Two factor authentication screen heading */
"Confirm it's you" = "Xác nhận đó là bạn";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "Phương thức thanh toán mặc định không thay đổi. Vui lòng thử lại.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "Phương thức thanh toán mặc định chưa cập nhật. Vui lòng thử lại.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Nhập thông tin thẻ theo cách thủ công";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Nhập mã đã được gửi tới %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Đã mở rộng";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Không thể kết nối";
/* Status while screen is loading */
"Loading" = "Đang tải";
/* The no answer to a yes or no question. */
"No" = "Không";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Gửi lại mã";
/* Text for button to scan a credit card */
"Scan Card" = "Quét thẻ";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Quét thẻ";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Thanh toán an toàn";
/* Indicates that a button is selected. */
"Selected" = "Đã chọn";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "IBAN quý vị đã nhập không hợp lệ.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "Hệ điều hành hoặc Phiên bản hệ điều hành không được hỗ trợ.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Thiết bị đã bị bẻ khóa.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "Tính toàn vẹn của SDK đã bị can thiệp.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Có lỗi bất ngờ khi xử lý thẻ -- hãy thử lại sau vài giây";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Có lỗi bất ngờ -- hãy thử lại sau vài giây";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Hết thời gian chờ";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Thử lại";
/* Indicates that a button is not selected. */
"Unselected" = "Chưa chọn";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "Chúng tôi sử dụng Stripe để xác minh chi tiết thẻ của bạn. Stripe có thể sử dụng và lưu trữ dữ liệu của bạn theo chính sách quyền riêng tư của họ. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Tìm hiểu thêm</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Có";
/* Error when the card has already expired */
"Your card has expired" = "Thẻ đã hết hạn";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Thẻ bị từ chối";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "Tháng hết hạn trên thẻ không hợp lệ";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Năm hết hạn trên thẻ không hợp lệ";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Số thẻ không đúng";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "Mã bảo mật của thẻ không đúng";
/* Error when customer's name is invalid */
"Your name is invalid." = "Tên của quý vị không hợp lệ.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Phương thức thanh toán của quý vị đã bị từ chối.";