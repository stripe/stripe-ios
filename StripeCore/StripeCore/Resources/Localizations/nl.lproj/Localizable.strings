/* The text for warning when a debugger is currently attached to the process. */
"A debugger is attached to the App." = "Er is een foutopsporingsprogramma gekoppeld aan de app.";
/* The text for warning when an emulator is being used to run the application. */
"An emulator is being used to run the App." = "Er wordt een emulator gebruikt om de app uit te voeren.";
/* An error message displayed when an error occurred. */
"An error occurred. Please try again." = "Er is iets misgegaan. Probeer het opnieuw.";
/* Button title to cancel action in an alert */
"Cancel" = "Annuleer";
/* An error message displayed when changing a card brand fails. */
"Card brand was not updated. Please try again." = "Het merk van de betaalkaart is niet bijgewerkt. Probeer het opnieuw.";
/* Text for close button */
"Close" = "Sluiten";
/* Accessibility label for expandable text control to indicate text is hidden. */
"Collapsed" = "Samengevouwen";
/* Two factor authentication screen heading */
"Confirm it's you" = "Bevestig dat jij het bent";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not changed. Please try again." = "De standaardbetaalmethode is niet gewijzigd. Probeer het opnieuw.";
/* An error message displayed when setting a default payment method fails. */
"Default payment method was not updated. Please try again." = "De standaardbetaalmethode is niet bijgewerkt. Probeer het opnieuw.";
/* Label for button to enter card details manually instead of scanning */
"Enter card details manually" = "Gegevens betaalkaart handmatig invoeren";
/* The subtitle/description of a screen where users are informed that they have received a One-Type-Password (OTP) to their phone. '%@' gets replaced by a redacted phone number. */
"Enter the code sent to %@." = "Voer de code in die is verstuurd naar %@.";
/* Accessibility label for expandable text control to indicate that the UI has been expanded and additional text is available. */
"Expanded" = "Uitgevouwen";
/* Label shown when a network-related error has occured. */
"Failed to connect" = "Kan geen verbinding maken";
/* Status while screen is loading */
"Loading" = "Aan het laden";
/* The no answer to a yes or no question. */
"No" = "Nee";
/* The title of a button that allows a user to request a one-time-password (OTP) again in case they did not receive it. */
"Resend code" = "Code opnieuw verzenden";
/* Text for button to scan a credit card */
"Scan Card" = "Kaart scannen";
/* Button title to open camera to scan credit/debit card */
"Scan card" = "Betaalkaart scannen";
/* The title for the challenge response step of an authenticated checkout. */
"Secure checkout" = "Beveiligd afrekenen";
/* Indicates that a button is selected. */
"Selected" = "Geselecteerd";
/* An error message displayed when the customer's iban is invalid. */
"The IBAN you entered is invalid." = "Het opgegeven IBAN-nummer is ongeldig.";
/* The text for warning when the SDK is running on an unsupported OS or OS version. */
"The OS or the OS Version is not supported." = "Het besturingssysteem of de versie wordt niet ondersteund.";
/* The text for warning when a device is jailbroken. */
"The device is jailbroken." = "Het apparaat is opengebroken via een jailbreak.";
/* The text for warning when the integrity of the SDK has been tampered with. */
"The integrity of the SDK has been tampered." = "De integriteit van de SDK is niet meer intact.";
/* Error when there is a problem processing the credit card */
"There was an error processing your card -- try again in a few seconds" = "Er is een fout met de verwerking van je kaart. Probeer het over enkele seconden opnieuw";
/* Unexpected error, such as a 500 from Stripe or a JSON parse error */
"There was an unexpected error -- try again in a few seconds" = "Er is een onverwachte fout opgetreden. Probeer het over enkele seconden opnieuw";
/* Error description for when a network request times out. English value is as required by UL certification. */
"Timeout" = "Time-out";
/* Button to reload web view if we were unable to connect. */
"Try again" = "Opnieuw proberen";
/* Indicates that a button is not selected. */
"Unselected" = "Niet geselecteerd";
/* Informational text informing the user that Stripe is used to process data and a link to Stripe's privacy policy */
"We use Stripe to verify your card details. Stripe may use and store your data according its privacy policy. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Learn more</u></a>" = "We gebruiken Stripe om je kaartgegevens te verifiëren. Stripe kan je gegevens gebruiken en bewaren volgens hun privacybeleid. <a href='https://support.stripe.com/questions/stripes-card-image-verification'><u>Meer informatie</u></a>";
/* The yes answer to a yes or no question. */
"Yes" = "Ja";
/* Error when the card has already expired */
"Your card has expired" = "Je kaart is vervallen";
/* Error when the card was declined by the credit card networks */
"Your card was declined" = "Je kaart is geweigerd";
/* Error when the card&apos;s expiration month is not valid */
"Your card's expiration month is invalid" = "De vervalmaand van je kaart is ongeldig";
/* Error when the card&apos;s expiration year is not valid */
"Your card's expiration year is invalid" = "Het vervaljaar van je kaart is ongeldig";
/* Error when the card number is not valid */
"Your card's number is invalid" = "Je kaartnummer is ongeldig";
/* Error when the card&apos;s CVC is not valid */
"Your card's security code is invalid" = "De beveiligingscode van je kaart is ongeldig";
/* Error when customer's name is invalid */
"Your name is invalid." = "Je naam is ongeldig.";
/* Error message when a payment method gets declined. */
"Your payment method was declined." = "Je betaalmethode is geweigerd.";