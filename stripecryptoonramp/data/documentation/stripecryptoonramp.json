{"abstract":[{"type":"text","text":"StripeCryptoOnramp helps you build a headless crypto onramp flow in your iOS app to allow your customers to securely purchase and exchange cryptocurrencies. It provides a coordinator that manages Link authentication, know your customer (KYC) and identity verification, payment method collection, and checkout handling while leaving your app in control of most of the surrounding UI and navigation."}],"kind":"symbol","hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","role":"collection","title":"StripeCryptoOnramp","symbolKind":"module","externalID":"StripeCryptoOnramp","modules":[{"name":"StripeCryptoOnramp"}]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"[!IMPORTANT]"},{"type":"text","text":" "},{"type":"text","text":"This SDK is currently in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"private preview"}]},{"type":"text","text":". Learn more and request access via the "},{"type":"reference","isActive":true,"identifier":"https:\/\/docs.stripe.com\/crypto\/onramp\/embedded-components"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","style":"note"},{"anchor":"Table-of-contents","text":"Table of contents","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"#Features"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"#Requirements","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"#Getting-started","isActive":true}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"#Integration"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"#Example","isActive":true}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"#Manual-linking"}]}]}]},{"level":2,"text":"Features","anchor":"Features","type":"heading"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Headless coordinator"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"CryptoOnrampCoordinator","type":"codeVoice"},{"text":" to orchestrate an onramp flow with minimal Stripe-provided UI","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Link authentication"}]},{"type":"text","text":":"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Check if an email has a Link account with "},{"code":"hasLinkAccount(with:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Register new users with "},{"type":"codeVoice","code":"registerLinkUser(email:fullName:phone:country:)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Authorize a Link auth intent with "},{"type":"codeVoice","code":"authorize(linkAuthIntentId:from:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Support seamless sign-in for returning users with ","type":"text"},{"code":"authenticateUserWithToken(_:)","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"KYC and identity verification"}]},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Present required partner terms of service with "},{"type":"codeVoice","code":"presentTermsOfServiceIfNeeded(from:)"},{"type":"text","text":" during onboarding after Link authentication"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Submit KYC information with ","type":"text"},{"code":"attachKYCInfo(info:)","type":"codeVoice"},{"text":" and confirm it with ","type":"text"},{"code":"verifyKYCInfo(updatedAddress:from:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Present identification document verification using ","type":"text"},{"code":"verifyIdentity(from:)","type":"codeVoice"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wallets and payment methods"}]},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Register and delete crypto wallets with ","type":"text"},{"type":"codeVoice","code":"registerWalletAddress(walletAddress:network:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"deleteWalletAddress(walletId:)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Collect payment methods via Link (card, bank account) or Apple Pay with "},{"type":"codeVoice","code":"collectPaymentMethod(type:from:)"},{"text":". To receive partial ","type":"text"},{"type":"codeVoice","code":"KycInfo"},{"type":"text","text":" from Apple Pay, configure the provided "},{"code":"PKPaymentRequest","type":"codeVoice"},{"type":"text","text":" to request Apple Pay billing "},{"code":".name","type":"codeVoice"},{"type":"text","text":" and\/or "},{"code":".postalAddress","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create crypto payment tokens with "},{"type":"codeVoice","code":"createCryptoPaymentToken()"}]}]}]},{"inlineContent":[{"type":"text","text":"If the customer’s KYC region (country of residence) changes after Apple Pay was collected before authentication, "},{"type":"codeVoice","code":"createCryptoPaymentToken()"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"PaymentMethodKYCRegionChangedError"},{"type":"text","text":" ("},{"type":"codeVoice","code":"payment_method_kyc_region_changed"},{"type":"text","text":"). The region used during collection may have come from "},{"type":"codeVoice","code":"countryHint"},{"type":"text","text":" or a default and differ from the customer’s authenticated KYC region. Collect Apple Pay again with "},{"type":"codeVoice","code":"collectPaymentMethod(type: .applePay(paymentRequest:), from:)"},{"type":"text","text":", then call "},{"type":"codeVoice","code":"createCryptoPaymentToken()"},{"type":"text","text":" only after collection succeeds. To avoid this, ensure "},{"type":"codeVoice","code":"countryHint"},{"type":"text","text":" matches the customer’s KYC region before collecting Apple Pay pre-authentication, or authenticate the customer first and then collect Apple Pay. Cancellation preserves the previous selection, which remains subject to validation; the SDK does not reopen Apple Pay automatically."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Checkout handling","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Present required partner terms and conditions with ","type":"text"},{"type":"codeVoice","code":"presentTermsAndConditionsIfNeeded(from:)"},{"type":"text","text":" before checkout"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Complete purchases for an onramp session with ","type":"text"},{"type":"codeVoice","code":"performCheckout(onrampSessionId:authenticationContext:onrampSessionClientSecretProvider:)"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Theming"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The minimal Stripe-provided UI supports light customization via ","type":"text"},{"code":"LinkAppearance","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Customize component colors, button properties, and light \/ dark interface styles","type":"text"}]}]}],"type":"unorderedList"},{"text":"Requirements","level":2,"anchor":"Requirements","type":"heading"},{"inlineContent":[{"type":"text","text":"The StripeCryptoOnramp iOS SDK is compatible with apps targeting iOS 15.0 or above."}],"type":"paragraph"},{"inlineContent":[{"text":"Simulator builds that include MediaPipe through StripeIdentity, including the prebuilt release frameworks and Swift Package Manager integrations with the ","type":"text"},{"code":"Identity","type":"codeVoice"},{"text":" trait enabled, require an arm64 destination on Apple silicon.","type":"text"}],"type":"paragraph"},{"text":"Getting started","level":2,"anchor":"Getting-started","type":"heading"},{"text":"Integration","level":3,"anchor":"Integration","type":"heading"},{"inlineContent":[{"type":"text","text":"Get started with Embedded components onramp "},{"overridingTitleInlineContent":[{"type":"text","text":"📚 iOS integration guide"}],"isActive":true,"type":"reference","overridingTitle":"📚 iOS integration guide","identifier":"https:\/\/docs.stripe.com\/crypto\/onramp\/embedded-components"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/stripe\/stripe-ios\/tree\/26.16.0\/StripeCryptoOnramp\/..\/Example\/CryptoOnramp%20Example"},{"type":"text","text":", or "},{"isActive":true,"type":"reference","identifier":"https:\/\/stripe.dev\/stripe-ios\/stripecryptoonramp\/documentation\/stripecryptoonramp"},{"text":" for fine-grained documentation of all the classes and methods in the SDK.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This SDK requires access to the device’s camera to capture identity documents. To enable your app to request camera permissions, set "},{"type":"codeVoice","code":"NSCameraUsageDescription"},{"type":"text","text":" in your app’s plist and provide a reason for accessing the camera (e.g. “This app uses the camera to take a picture of your identity documents”)."}]},{"anchor":"Example","type":"heading","text":"Example","level":3},{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"type":"text","text":"CryptoOnramp Example"}],"type":"reference","identifier":"https:\/\/github.com\/stripe\/stripe-ios\/tree\/26.16.0\/StripeCryptoOnramp\/..\/Example\/CryptoOnramp%20Example","overridingTitle":"CryptoOnramp Example","isActive":true},{"type":"text","text":" – This example demonstrates an end-to-end headless onramp flow (Link authentication, KYC and identity verification, wallet selection, payment method collection, and checkout) using a demo backend."}]},{"anchor":"Manual-linking","type":"heading","text":"Manual linking","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you link the StripeCryptoOnramp library manually, use a version from our "},{"type":"reference","identifier":"https:\/\/github.com\/stripe\/stripe-ios\/releases","isActive":true},{"type":"text","text":" page and make sure to embed "},{"type":"text","text":"all"},{"type":"text","text":" of the following frameworks:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Stripe.xcframework"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Stripe3DS2.xcframework","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"StripeApplePay.xcframework","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"StripeCameraCore.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StripeCore.xcframework"}]}]},{"content":[{"inlineContent":[{"code":"StripeCryptoOnramp.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"StripeFinancialConnections.xcframework","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"StripeIdentity.xcframework","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"StripeIssuing.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StripePayments.xcframework"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"StripePaymentSheet.xcframework","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"StripePaymentsUI.xcframework"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StripeUICore.xcframework"}]}]}]}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/stripecryptoonramp"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/stripecryptoonramp"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/com.stripe.stripe-crypto-onramp\/documentation\/StripeCryptoOnramp","interfaceLanguage":"swift"},"references":{"https://github.com/stripe/stripe-ios/releases":{"title":"releases","titleInlineContent":[{"text":"releases","type":"text"}],"url":"https:\/\/github.com\/stripe\/stripe-ios\/releases","type":"link","identifier":"https:\/\/github.com\/stripe\/stripe-ios\/releases"},"#Features":{"titleInlineContent":[{"type":"text","text":"Features"}],"url":"#Features","type":"link","title":"Features","identifier":"#Features"},"https://github.com/stripe/stripe-ios/tree/26.16.0/StripeCryptoOnramp/../Example/CryptoOnramp%20Example":{"type":"link","title":"example project","titleInlineContent":[{"type":"text","text":"example project"}],"url":"https:\/\/github.com\/stripe\/stripe-ios\/tree\/26.16.0\/StripeCryptoOnramp\/..\/Example\/CryptoOnramp%20Example","identifier":"https:\/\/github.com\/stripe\/stripe-ios\/tree\/26.16.0\/StripeCryptoOnramp\/..\/Example\/CryptoOnramp%20Example"},"#Example":{"title":"Ex