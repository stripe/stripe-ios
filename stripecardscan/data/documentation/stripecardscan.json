t":[{"inlineContent":[{"type":"text","text":"Set up camera permissions"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The SDK uses the camera, so you’ll need to add an description of camera usage to your Info.plist file:","type":"text"},{"text":" ","type":"text"},{"type":"image","identifier":"https:\/\/gblobscdn.gitbook.com\/assets\/-MAfqrnL3d-uke0sAFsI\/sync\/573e3f05043e4d903189b5fb107d4b3565bdb11b.png?alt=media"},{"type":"text","text":" "},{"identifier":"https:\/\/gblobscdn.gitbook.com\/assets\/-MAfqrnL3d-uke0sAFsI\/sync\/0d7119d3cbe2f519e5e5c04b56fe43539e4435e1.png?alt=media","type":"image"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternatively, you can add this permission directly to your Info.plist file:"}]}]}],"type":"unorderedList"},{"code":["<key>NSCameraUsageDescriptionkey>","<string>We need access to your camera to scan your cardstring>"],"syntax":null,"type":"codeListing"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"code":"CardScanSheet","type":"codeVoice"},{"text":" in your app where you want to invoke the scan flow","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Initialize ","type":"text"},{"type":"codeVoice","code":"CardScanSheet"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When it’s time to invoke the scan flow, display the sheet with "},{"type":"codeVoice","code":"CardScanSheet.present()"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the verification flow is finished, the sheet will be dismissed and the completion block will be called with a "},{"type":"reference","identifier":"https:\/\/stripe.dev\/stripe-ios\/","isActive":true}]}]}]}]}],"type":"orderedList"},{"type":"heading","level":3,"text":"Example Implementation","anchor":"Example-Implementation"},{"code":["","import UIKit","import StripeCardScan","