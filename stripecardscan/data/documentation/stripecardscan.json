, you can add this permission directly to your Info.plist file:","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["<key>NSCameraUsageDescriptionkey>","<string>We need access to your camera to scan your cardstring>"],"syntax":null}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"code":"CardScanSheet","type":"codeVoice"},{"type":"text","text":" in your app where you want to invoke the scan flow"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Initialize ","type":"text"},{"type":"codeVoice","code":"CardScanSheet"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When it’s time to invoke the scan flow, display the sheet with ","type":"text"},{"type":"codeVoice","code":"CardScanSheet.present()"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When the verification flow is finished, the sheet will be dismissed and the completion block will be called with a ","type":"text"},{"identifier":"https:\/\/stripe.dev\/stripe-ios\/","type":"reference","isActive":true}],"type":"paragraph"}]}]}]}]},{"level":3,"text":"Example Implementation","anchor":"Example-Implementation","type":"heading"},{"code":["","import UIKit","import StripeCardScan","","class ViewController: UIViewController {","","    @IBAction func cardScanSheetButtonPressed() {","        let cardScanSheet = CardScanSheet()","","        cardScanSheet.present(from: self) { [weak self] result in","            switch result {","                case .completed(let scannedCard):","                \/*","                 * The user scanned a card. The result of the scan are detailed ","                 * in the `scannedCard` field of the result.","                 *\/","                print(\"scan success\")","            case .canceled:","                \/*","                * The scan was canceled by the user.","                *\/","                print(\"scan canceled\")","            case .failed(let error):","   