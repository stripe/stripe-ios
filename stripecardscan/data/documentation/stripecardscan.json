:"StripeCardScan"},{"type":"text","text":" product to the target of your app."}]}]}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Integration","anchor":"Integration"},{"type":"heading","level":3,"text":"Credit Card OCR","anchor":"Credit-Card-OCR"},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"code":"CardScanSheet","type":"codeVoice"},{"text":" in your view controller where you want to invoke the credit card scanning flow.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Set up camera permissions"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK uses the camera, so you’ll need to add an description of camera usage to your Info.plist file:"},{"type":"text","text":" "},{"type":"image","identifier":"https:\/\/gblobscdn.gitbook.com\/assets\/-MAfqrnL3d-uke0sAFsI\/sync\/573e3f05043e4d903189b5fb107d4b3565bdb11b.png?alt=media"},{"type":"text","text":" "},{"type":"image","identifier":"https:\/\/gblobscdn.gitbook.com\/assets\/-MAfqrnL3d-uke0sAFsI\/sync\/0d7119d3cbe2f519e5e5c04b56fe43539e4435e1.png?alt=media"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Alternatively, you can add this permission directly to your Info.plist file:","type":"text"}]}]}]},{"code":["<key>NSCameraUsageDescriptionkey>","<string>We need access to your camera to scan your cardstring>"],"type":"codeListing","syntax":null}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"type":"codeVoice","code":"CardScanSheet"},{"text":" in your app where you want to invoke the scan flow","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Initialize ","type":"text"},{"type":"codeVoice","code":"CardScanSheet"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When it’s time to invoke the scan flow, display the sh