{"identifier":{"url":"doc:\/\/com.stripe.stripe-card-scan\/documentation\/StripeCardScan","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This library provides a user interface through which users can scan payment cards and extract information from them. It uses the Stripe Publishable Key to authenticate with Stripe services.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that this is a standalone SDK and, while compatible with, does not directly integrate with the ","type":"text"},{"identifier":"https:\/\/stripe.com\/docs\/api\/payment_intents","isActive":true,"type":"reference"},{"text":" API nor with ","type":"text"},{"identifier":"https:\/\/stripe.com\/docs\/api\/errors#errors-payment_intent-next_action","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This library can be used entirely outside of a Stripe integration and with other payment processing providers.","type":"text"}]},{"text":"Requirements","level":2,"type":"heading","anchor":"Requirements"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"iOS 15.0 or higher","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Xcode 15 or higher","type":"text"}]}]}]},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"identifier":"https:\/\/github.com\/stripe\/stripe-ios\/tree\/master\/Example\/CardImageVerification%20Example","isActive":true,"type":"reference"},{"text":" directory for an example application that you can try for yourself!","type":"text"}]},{"text":"Installation","level":2,"type":"heading","anchor":"Installation"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Cocoapod","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"code":"pod install StripeCardScan","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"SPM","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"In Xcode, select File > Add Packages… and enter https:\/\/github.com\/stripe\/stripe-ios-spm as the repository URL.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select the latest version number from our releases page.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"StripeCardScan","type":"codeVoice"},{"text":" product to the target of your app.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}]},{"text":"Integration","level":2,"type":"heading","anchor":"Integration"},{"text":"Credit Card OCR","level":3,"type":"heading","anchor":"Credit-Card-OCR"},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"code":"CardScanSheet","type":"codeVoice"},{"text":" in your view controller where you want to invoke the credit card scanning flow.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Set up camera permissions","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"The SDK uses the camera, so you’ll need to add an description of camera usage to your Info.plist file:","type":"text"},{"text":" ","type":"text"},{"type":"image","identifier":"https:\/\/gblobscdn.gitbook.com\/assets\/-MAfqrnL3d-uke0sAFsI\/sync\/573e3f05043e4d903189b5fb107d4b3565bdb11b.png?alt=media"},{"text":" ","type":"text"},{"type":"image","identifier":"https:\/\/gblobscdn.gitbook.com\/assets\/-MAfqrnL3d-uke0sAFsI\/sync\/0d7119d3cbe2f519e5e5c04b56fe43539e4435e1.png?alt=media"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Alternatively, you can add this permission directly to your Info.plist file:","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["<key>NSCameraUsageDescriptionkey>","<string>We need access to your camera to scan your cardstring>"],"type":"codeListing","syntax":null}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"code":"CardScanSheet","type":"codeVoice"},{"text":" in your app where you want to invoke the scan flow","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Initialize ","type":"text"},{"code":"CardScanSheet","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When it’s time to invoke the scan flow, display the sheet with ","type":"text"},{"code":"CardScanSheet.present()","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When the verification flow is finished, the sheet will be dismissed and the completion block will be called with a ","type":"text"},{"type":"reference","identifier":"https:\/\/stripe.dev\/stripe-ios\/","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"}]}]},{"text":"Example Implementation","level":3,"type":"heading","anchor":"Example-Implementation"},{"code":["","import UIKit","import StripeCardScan","","class ViewController: UIViewController {","","    @IBAction func cardScanSheetButtonPressed() {","        let cardScanSheet = CardScanSheet()","","        cardScanSheet.present(from: self) { [weak self] result in","            switch result {","                case .completed(let scannedCard):","                \/*","                 * The user scanned a card. The result of the scan are detailed ","                 * in the `scannedCard` field of the result.","                 *\/","                print(\"scan success\")","            case .canceled:","                \/*","                * The scan was canceled by the user.","                *\/","                print(\"scan canceled\")","            case .failed(let error):","                 \/*","                 * The scan failed. The display