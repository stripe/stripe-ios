{"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This library provides a user interface through which users can scan payment cards and extract information from them. It uses the Stripe Publishable Key to authenticate with Stripe services.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that this is a standalone SDK and, while compatible with, does not directly integrate with the "},{"isActive":true,"type":"reference","identifier":"https:\/\/stripe.com\/docs\/api\/payment_intents"},{"type":"text","text":" API nor with "},{"isActive":true,"type":"reference","identifier":"https:\/\/stripe.com\/docs\/api\/errors#errors-payment_intent-next_action"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This library can be used entirely outside of a Stripe integration and with other payment processing providers."}]},{"type":"heading","level":2,"anchor":"Requirements","text":"Requirements"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS 15.0 or higher"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Xcode 15 or higher"}]}]}]},{"type":"heading","level":2,"anchor":"Example","text":"Example"},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/stripe\/stripe-ios\/tree\/master\/Example\/CardImageVerification%20Example","type":"reference"},{"text":" directory for an example application that you can try for yourself!","type":"text"}]},{"type":"heading","level":2,"anchor":"Installation","text":"Installation"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Cocoapod"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code