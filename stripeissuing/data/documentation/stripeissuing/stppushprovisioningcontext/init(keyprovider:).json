{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.stripe.stripe-issuing-push-provision\/documentation\/StripeIssuing\/STPPushProvisioningContext\/init(keyProvider:)"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/stripeissuing\/stppushprovisioningcontext\/init(keyprovider:)"]}],"hierarchy":{"paths":[["doc:\/\/com.stripe.stripe-issuing-push-provision\/documentation\/StripeIssuing","doc:\/\/com.stripe.stripe-issuing-push-provision\/documentation\/StripeIssuing\/STPPushProvisioningContext"]]},"sections":[],"metadata":{"role":"symbol","externalID":"c:@M@StripeIssuing@objc(cs)STPPushProvisioningContext(im)initWithKeyProvider:","title":"init(keyProvider:)","roleHeading":"Initializer","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"keyProvider","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@M@StripeIssuing@objc(pl)STPIssuingCardEphemeralKeyProvider","text":"STPIssuingCardEphemeralKeyProvider","kind":"typeIdentifier"},{"text":")","kind":"text"}],"symbolKind":"init","modules":[{"name":"StripeIssuing"}]},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"keyProvider","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.stripe.stripe-issuing-push-provision\/documentation\/StripeIssuing\/STPIssuingCardEphemeralKeyProvider","preciseIdentifier":"c:@M@StripeIssuing@objc(pl)STPIssuingCardEphemeralKeyProvider","text":"STPIssuingCardEphemeralKeyProvider","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"]}],"kind":"declarations"}],"abstract":[{"text":"In order to retreive the encrypted payload that PKAddPaymentPassViewController expects, the Stripe SDK must talk to the Stripe API. As this requires privileged access, you must write a “key provider” that generates an Ephemeral Key on your backend and provides it to the SDK when requested. For more information, see https:\/\/stripe.com\/docs\/mobile\/ios\/basic#ephemeral-key","type":"text"}],"references":{"doc://com.stripe.stripe-issuing-push-provision/documentation/StripeIssuing/STPPushProvisioningContext":{"url":"\/documentation\/stripeissuing\/stppushprovisioningcontext","navigatorTitle":[{"kind":"identifier","text":"STPPushProvisioningContext"}],"identifier":"doc:\/\/com.stripe.stripe-issuing-push-provision\/documentation\/StripeIssuing\/STPPushProvisioningContext","title":"STPPushProvisioningContext","abstract":[{"type":"text","text":"This class makes it easier to implement “Push Provisioning”, the process by which an end-user can add a card to their Apple Pay wallet without having to type their number. This process is mediated by an Apple class called "},{"type":"codeVoice","code":"PKAddPaymentPassViewController"},{"type":"text","text":"; this class will help you implement that class’ delegate methods. Note that this flow requires a special entitlement from Apple; for more information please see https:\/\/stripe.com\/docs\/issuing\/cards\/digital-wallets ."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"STPPushProvisioningContext"}],"type":"topic","kind":"symbol"},"doc://com.stripe.stripe-issuing-push-provision/documentation/StripeIssuing/STPPushProvisioningContext/init(keyProvider:)":{"url":"\/documentation\/stripeissuing\/stppushprovisioningcontext\/init(keyprovider:)","title":"init(keyProvider:)","identifier":"doc:\/\/com.stripe.stripe-issuing-push-provision\/documentation\/StripeIssuing\/STPPushProvisioningContext\/init(keyProvider:)","abstract":[{"type":"text","text":"In order to retreive the encrypted payload that PKAddPaymentPassViewController expects, the Stripe SDK must talk to the Stripe API. As this requires privileged access, you must write a “key provider” that generates an Ephemeral Key on your backend and provides it to the SDK when requested. For more information, see https:\/\/stripe.com\/docs\/mobile\/ios\/basic#ephemeral-key"}],"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"keyProvider","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"STPIssuingCardEphemeralKeyProvider","kind":"typeIdentifier","preciseIdentifier":"c:@M@StripeIssuing@objc(pl)STPIssuingCardEphemeralKeyProvider"},{"kind":"text","text":")"}],"type":"topic","kind":"symbol"},"doc://com.stripe.stripe-issuing-push-provision/documentation/StripeIssuing/STPIssuingCardEphemeralKeyProvider":{"title":"STPIssuingCardEphemeralKeyProvider","role":"symbol","abstract":[{"text":"You should make your application’s API client conform to this interface.","type":"text"},{"type":"text","text":" "},{"text":"It provides a way for Stripe utility classes to request a new ephemeral key from","type":"text"},{"type":"text","text":" "},{"text":"your backend, which it will use to retrieve and update Stripe API objects.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/com.stripe.stripe-issuing-push-provision\/documentation\/StripeIssuing\/STPIssuingCardEphemeralKeyProvider","navigatorTitle":[{"text":"STPIssuingCardEphemeralKeyProvider","kind":"identifier"}],"type":"topic","url":"\/documentation\/stripeissuing\/stpissuingcardephemeralkeyprovider","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"STPIssuingCardEphemeralKeyProvider","kind":"identifier"}]},"doc://com.stripe.stripe-issuing-push-provision/documentation/StripeIssuing":{"title":"StripeIssuing","role":"collection","abstract":[{"type":"text","text":"Placeholder"}],"kind":"symbol","identifier":"doc:\/\/com.stripe.stripe-issuing-push-provision\/documentation\/StripeIssuing","url":"\/documentation\/stripeissuing","type":"topic"}}}