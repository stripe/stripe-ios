{"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Want to chat live with Stripe engineers? Join us on our "},{"type":"reference","identifier":"https:\/\/stripe.com\/go\/developer-chat","isActive":true},{"text":".","type":"text"}]}],"style":"note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Stripe iOS SDK makes it quick and easy to build an excellent payment experience in your iOS app. We provide powerful and customizable UI screens and elements that can be used out-of-the-box to collect your users’ payment details. We also expose the low-level APIs that power those UIs so that you can build fully custom experiences."}]},{"inlineContent":[{"text":"Get started with our ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/stripe.com\/docs\/payments\/accept-a-payment?platform=ios"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"#Examples"},{"type":"text","text":", or "},{"type":"reference","isActive":true,"identifier":"https:\/\/stripe.dev\/stripe-ios\/docs\/index.html"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Updating to a newer version of the SDK? See our ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/stripe\/stripe-ios\/blob\/master\/MIGRATING.md"},{"text":" and ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/stripe\/stripe-ios\/blob\/master\/CHANGELOG.md","isActive":true},{"text":".","type":"text"}]}]},{"inlineContent":[{"type":"text","text":"Table of contents"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"refe